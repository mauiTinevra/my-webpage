---
// Small hand-drawn icons, as code: ink strokes with a little wobble, round ends, one weight.
// They take the current text color, so they work on paper, on color and on ink.
export type DoodleName = 'cactus' | 'browser' | 'sparkle' | 'heart' | 'envelope' | 'arrow' | 'sun' | 'footprints';
interface Props {
  name: DoodleName;
  size?: string;
  class?: string;
  label?: string;
}
const { name, size = '1.5em', class: className, label } = Astro.props;

// Every path is drawn by hand on a 48 x 48 grid, slightly off-true on purpose.
const paths: Record<DoodleName, string[]> = {
  cactus: [
    'M21.5 42.5c-.4-8.6.3-19.7.1-27.4-.1-3.6 1.6-6.2 3.4-6.1 1.9.1 3.2 2.6 3.1 6.3-.2 8.4-.6 18.7.2 27.3',
    'M21.6 27.3c-3.9.4-6.6-.9-7.3-3.8-.5-2.3-.2-5.4.2-7.6',
    'M14.5 15.9c-.2-1.6.9-2.7 2-2.6 1.3.1 1.8 1.4 1.6 2.9-.3 2.2-.5 4.4.1 6.2.4 1.1 1.8 1.7 3.4 1.4',
    'M28.3 23.1c3.3.2 5.9-.6 6.6-3.5.5-2.1.3-4.6 0-6.4',
    'M34.9 13.2c.1-1.4-.8-2.4-1.9-2.3-1.2.1-1.6 1.3-1.5 2.6.2 1.8.3 3.6-.2 5.1-.4 1-1.6 1.6-3.1 1.5',
    'M12.2 42.7c7.8-.5 15.9-.6 23.9.1',
    'M24.6 15.4l.1 1.3M24.9 22l-.1 1.2M24.7 29.3l.1 1.2M24.8 35.6v1.1',
  ],
  browser: [
    'M7.2 11.8c11.3-.6 22.6-.5 33.8.2.6 8.4.4 16.7-.3 25-11.1.8-22.3.7-33.4-.1-.7-8.4-.7-16.8-.1-25.1z',
    'M7.4 18.4c11.1-.3 22.2-.2 33.4.2',
    'M11.3 15.1h.4M14.7 15h.4M18.1 15.1h.4',
    'M12.6 24.6c4.4-.2 8.8-.2 13.2.1M12.8 29.4c6.2-.2 12.4-.1 18.6.2',
  ],
  sparkle: [
    'M24.2 6.8c.6 7.6 3.4 13.4 10.9 16.6-7.4 3.3-10.3 9-11.1 17.6-.8-8.6-3.7-14.4-11.1-17.6 7.6-3.1 10.6-8.9 11.3-16.6z',
    'M37.6 7.9c.2 2.4 1.1 4.1 3.4 5.2-2.3 1.1-3.2 2.8-3.4 5.4-.3-2.6-1.2-4.3-3.4-5.4 2.3-1 3.2-2.8 3.4-5.2z',
  ],
  heart: [
    'M24.3 39.6C15.4 33.5 7.9 26.9 8.3 18.4c.3-5.4 4.4-8.9 9-8.5 3.3.3 5.6 2.4 7 5.4 1.5-3.1 3.9-5.3 7.4-5.4 4.6-.2 8.4 3.6 8.2 8.9-.4 8.4-7.9 14.6-15.6 20.8z',
  ],
  envelope: [
    'M6.9 13.1c11.5-.5 22.9-.4 34.4.2.5 7.4.4 14.8-.2 22.2-11.4.6-22.8.5-34.1-.1-.6-7.4-.6-14.9-.1-22.3z',
    'M7.4 13.8c5.4 4.9 11.1 9.2 16.9 12.8 5.6-3.6 11.3-8 16.6-12.7',
  ],
  arrow: [
    'M7.6 24.6c10.4-.6 20.9-.5 31.3.1',
    'M29.2 15.1c3.4 3.1 6.7 6.1 9.9 9.5-3.3 3.1-6.6 6.2-9.7 9.6',
  ],
  sun: [
    'M24.1 15.3c4.9-.2 8.8 3.8 8.7 8.8-.1 4.9-4 8.6-8.8 8.6-4.9 0-8.8-3.9-8.7-8.8.1-4.8 4-8.5 8.8-8.6z',
    'M24 5.7l.2 4.4M24.2 38.2l-.1 4.3M5.6 24.3l4.4-.1M38.1 24l4.4.1M10.9 11l3.1 3.2M34.1 34.2l3 3M10.8 37.2l3.2-3M34.2 14l3.1-3',
  ],
  footprints: [
    'M15.3 40.1c-2.8-.2-4.2-2.6-3.9-6.3.3-3.5 2-6.6 4.7-6.4 2.6.2 3.5 3.2 3.2 6.6-.3 3.8-1.6 6.3-4 6.1z',
    'M31.9 25.6c-2.7-.1-4.2-2.6-4-6.3.2-3.6 1.9-6.7 4.6-6.5 2.6.2 3.6 3.2 3.3 6.7-.3 3.8-1.6 6.3-3.9 6.1z',
  ],
};
---

<svg
  class:list={['doodle', className]}
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {paths[name].map((d) => <path d={d} />)}
</svg>

<style>
  .doodle { display: inline-block; flex: none; vertical-align: -0.25em; overflow: visible; }
</style>
