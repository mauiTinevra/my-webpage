---
// Page two: one picture that takes the whole page, and it is alive. It is painted twice: a
// wide picture for desktops, and a tall one for phones, where the mesa becomes a butte.
// Both are alive at once and the screen's shape decides which is shown.
// The sky follows the real
// time of day in Scottsdale, Arizona, and the figure on the mesa works through the Ashtanga
// primary series, rests in Savasana, then the second series, and starts again.
import Nube from './Nube.astro';
import { poses, draw } from '../lib/yogi';

const ink = '#121a3a';

// Stars scattered with a fixed seed, so the sky is the same on every visit.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const scatter = (count: number, x0: number, x1: number, y0: number, y1: number) =>
  Array.from({ length: count }, () => ({
    x: Math.round(x0 + rand() * (x1 - x0)),
    y: Math.round(y0 + rand() * (y1 - y0)),
    r: +(0.8 + rand() * 1.8).toFixed(1),
    gold: rand() > 0.8,
    twinkle: rand() > 0.72,
    delay: +(rand() * 4).toFixed(1),
  }));
const stars = scatter(150, -240, 1840, -150, 430);
const tallStars = scatter(140, 0, 900, 0, 960);

const saguaro = (x: number, y: number, s: number) =>
  `M${x - 9 * s} ${y} V${y - 150 * s} a${9 * s} ${9 * s} 0 0 1 ${18 * s} 0 V${y} Z ` +
  `M${x - 9 * s} ${y - 70 * s} h${-22 * s} a${8 * s} ${8 * s} 0 0 1 ${-8 * s} ${-8 * s} v${-34 * s} a${7 * s} ${7 * s} 0 0 1 ${14 * s} 0 v${28 * s} h${16 * s} Z ` +
  `M${x + 9 * s} ${y - 96 * s} h${24 * s} a${8 * s} ${8 * s} 0 0 0 ${8 * s} ${-8 * s} v${-40 * s} a${7 * s} ${7 * s} 0 0 0 ${-14 * s} 0 v${34 * s} h${-18 * s} Z`;
---

<section class="next-page" id="next-page" aria-labelledby="piece-title">
  <svg class="piece piece-wide" viewBox="-240 -150 2080 1170" preserveAspectRatio="xMidYMid slice" role="img" data-sun="120 1360 620 520 130 55" data-moon="1050 750 620 600" aria-label="A desert under the sky as it is right now in Scottsdale, Arizona. On top of a mesa a small figure practises Ashtanga yoga on a pink mat, under a huge white cloud with eyes. Saguaros stand in the foreground.">
    <defs>
      <linearGradient id="dusk-wide" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="900">
        <stop data-stop="0" offset="0" stop-color="#1b1147" />
        <stop data-stop="1" offset="0.42" stop-color="#5a2484" />
        <stop data-stop="2" offset="0.68" stop-color="#f0508f" />
        <stop data-stop="3" offset="0.78" stop-color="#ffb37a" />
      </linearGradient>
    </defs>
    <rect x="-300" y="-200" width="2200" height="1300" fill="url(#dusk-wide)" />

    <g class="depth" style="--d:4">
      <g data-part="stars">
        {
          stars.map((s) => (
            <circle class={s.twinkle ? 'star twinkle' : 'star'} cx={s.x} cy={s.y} r={s.r} fill={s.gold ? '#f2cb3a' : '#fbf4e4'} style={s.twinkle ? `animation-delay:${s.delay}s` : undefined} />
          ))
        }
      </g>
    </g>

    <g class="depth" style="--d:8">
      <circle data-part="sun" cx="1150" cy="505" r="130" fill="#ff9a4a" />
      <path data-part="moon" d="M0 -46 A46 46 0 1 0 0 46 A64 64 0 0 1 0 -46 Z" fill="#fbf4e4" visibility="hidden" />
      <g data-part="band-a" fill="#f6b7cf">
        <rect x="90" y="330" width="430" height="30" rx="15" />
        <rect x="200" y="368" width="250" height="22" rx="11" />
        <rect x="1280" y="330" width="330" height="28" rx="14" />
      </g>
      <g data-part="band-b" fill="#f0508f">
        <rect x="980" y="430" width="380" height="26" rx="13" />
        <rect x="1060" y="468" width="220" height="20" rx="10" />
        <rect x="-200" y="486" width="460" height="24" rx="12" />
        <rect x="1560" y="250" width="260" height="22" rx="11" />
      </g>
    </g>

    <g class="depth" style="--d:14">
      <path data-part="far" d="M-300 640 V540 H120 L150 500 H330 L360 560 H520 L560 470 H700 L730 560 H980 L1010 520 H1180 L1210 580 H1420 L1450 510 H1900 V640 Z" fill="#7b2d8e" />
    </g>

    <g class="depth" style="--d:22">
      <Nube variant={0} attrs={{ x: 470, y: 50, width: 600, height: 386 }} />
      <Nube variant={2} fill="#f6b7cf" attrs={{ x: 1250, y: 130, width: 210, height: 135 }} />
    </g>

    <g class="depth" style="--d:30">
      <path data-part="mid" d="M-300 720 V610 H200 L240 560 H420 L450 640 H590 L640 600 H960 L1000 660 H1150 L1190 590 H1330 L1360 650 H1900 V720 Z" fill="#1f3fcf" stroke={ink} stroke-width="6" stroke-linejoin="round" />
      <!-- The figure on a pink mat on the mesa. The script below keeps it moving. -->
      <g transform="translate(800 598)">
        <rect x="-152" y="-9" width="304" height="10" rx="2" fill="#f0508f" stroke={ink} stroke-width="5" />
        <g data-part="yogi" transform="translate(0 -9) scale(-1.7 1.7)" set:html={draw(poses.samasthiti)} />
      </g>
    </g>

    <g class="depth" style="--d:44" stroke={ink} stroke-width="6" stroke-linejoin="round">
      <path d={saguaro(250, 730, 1.15)} fill="#2f8f4e" />
      <path d={saguaro(1420, 760, 1.45)} fill="#2f8f4e" />
      <path d={saguaro(1130, 716, 0.7)} fill="#2f8f4e" />
      <path d={saguaro(-130, 736, 0.95)} fill="#2f8f4e" />
      <path d={saguaro(1730, 768, 0.85)} fill="#2f8f4e" />
      <path data-part="near" d="M-300 1100 V720 H260 L300 690 H520 L560 740 H1040 L1090 700 H1300 L1340 750 H1900 V1100 Z" fill={ink} />
    </g>
  </svg>

  <svg class="piece piece-tall" viewBox="0 0 900 1600" preserveAspectRatio="xMidYMid slice" data-sun="100 700 1040 830 95 35" data-moon="700 120 1000 860" role="img" aria-label="A desert under the sky as it is right now in Scottsdale, Arizona. On top of a tall butte a figure practises Ashtanga yoga on a pink mat, under a huge white cloud with eyes. Saguaros stand in the foreground.">
    <defs>
      <linearGradient id="dusk-tall" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1160">
        <stop data-stop="0" offset="0" stop-color="#1b1147" />
        <stop data-stop="1" offset="0.45" stop-color="#5a2484" />
        <stop data-stop="2" offset="0.74" stop-color="#f0508f" />
        <stop data-stop="3" offset="0.86" stop-color="#ffb37a" />
      </linearGradient>
    </defs>
    <rect x="-400" y="-400" width="1700" height="2400" fill="url(#dusk-tall)" />

    <g class="depth" style="--d:4">
      <g data-part="stars">
        {
          tallStars.map((s) => (
            <circle class={s.twinkle ? 'star twinkle' : 'star'} cx={s.x} cy={s.y} r={s.r} fill={s.gold ? '#f2cb3a' : '#fbf4e4'} style={s.twinkle ? `animation-delay:${s.delay}s` : undefined} />
          ))
        }
      </g>
    </g>

    <g class="depth" style="--d:8">
      <circle data-part="sun" cx="450" cy="900" r="95" fill="#ff9a4a" />
      <path data-part="moon" d="M0 -40 A40 40 0 1 0 0 40 A56 56 0 0 1 0 -40 Z" fill="#fbf4e4" visibility="hidden" />
      <g data-part="band-a" fill="#f6b7cf">
        <rect x="40" y="610" width="320" height="26" rx="13" />
        <rect x="110" y="646" width="180" height="20" rx="10" />
        <rect x="560" y="720" width="380" height="24" rx="12" />
      </g>
      <g data-part="band-b" fill="#f0508f">
        <rect x="540" y="820" width="300" height="22" rx="11" />
        <rect x="600" y="854" width="170" height="18" rx="9" />
        <rect x="-40" y="900" width="300" height="22" rx="11" />
      </g>
    </g>

    <g class="depth" style="--d:14">
      <path data-part="far" d="M-100 1220 V1080 H40 L70 1030 H200 L230 1090 H330 L360 1040 H540 L570 1095 H660 L690 1020 H840 L870 1070 H1000 V1220 Z" fill="#7b2d8e" />
    </g>

    <g class="depth" style="--d:22">
      <Nube variant={0} attrs={{ x: 175, y: 150, width: 550, height: 354 }} />
      <Nube variant={2} fill="#f6b7cf" attrs={{ x: 30, y: 560, width: 190, height: 122 }} />
    </g>

    <g class="depth" style="--d:30" stroke={ink} stroke-width="6" stroke-linejoin="round">
      <path data-part="mid" d="M-100 1600 V1300 H70 L100 1260 H260 V1600 Z" fill="#1f3fcf" />
      <path data-part="mid" d="M640 1600 V1280 H780 L810 1230 H1000 V1600 Z" fill="#1f3fcf" />
      <!-- The butte, with the practice on top. -->
      <path data-part="mid" d="M150 1600 L182 1240 L212 1180 L198 1120 L232 960 L230 880 H670 L672 960 L702 1120 L688 1180 L718 1240 L750 1600 Z" fill="#1f3fcf" />
      <path d="M236 990 H664 M206 1110 H694 M200 1230 H708" fill="none" stroke-width="3" opacity="0.35" />
      <g transform="translate(450 880)">
        <rect x="-205" y="-9" width="410" height="12" rx="2" fill="#f0508f" stroke-width="5" />
        <g data-part="yogi" transform="translate(0 -9) scale(-2.4 2.4)" stroke-width="0" set:html={draw(poses.samasthiti)} />
      </g>
    </g>

    <g class="depth" style="--d:44" stroke={ink} stroke-width="6" stroke-linejoin="round">
      <path d={saguaro(110, 1500, 2.0)} fill="#2f8f4e" />
      <path d={saguaro(800, 1540, 1.6)} fill="#2f8f4e" />
      <path d={saguaro(320, 1450, 0.8)} fill="#2f8f4e" />
      <path data-part="near" d="M-100 2000 V1440 H120 L160 1410 H300 L330 1460 H560 L600 1420 H760 L800 1470 H1000 V2000 Z" fill={ink} />
    </g>
  </svg>

  <div class="placard">
    <h2 id="piece-title">Practice at <span id="piece-phase">dusk</span></h2>
    <p><span id="piece-clock"></span> Scottsdale, Arizona</p>
    <p><span id="piece-series">Primary series</span>: <span id="piece-asana">Samasthiti</span></p>
    <button class="next-page-back" type="button" id="back-to-start">Back to the street</button>
  </div>
</section>

<script>
  import { poses, practice, blend, draw } from '../lib/yogi';
  import { scottsdaleNow, skyAt, formatHour } from '../lib/sky';

  const el = (id: string) => document.getElementById(id)!;
  const frame = el('next-page');
  const pictures = [...frame.querySelectorAll<SVGSVGElement>('.piece')];
  const parts = (name: string) => [...frame.querySelectorAll<SVGElement>(`[data-part="${name}"]`)];

  // The sky. Add ?hour=6.5 to the address to see any time of day.
  const asked = new URLSearchParams(location.search).get('hour');
  const paintSky = () => {
    const now = scottsdaleNow();
    const hour = asked !== null && !Number.isNaN(Number(asked)) ? Number(asked) % 24 : now.hour;
    const sky = skyAt(hour, now.day);

    frame.querySelectorAll('[data-stop]').forEach((stop) => stop.setAttribute('stop-color', sky.sky[Number((stop as HTMLElement).dataset.stop)]));
    const paint = { far: sky.far, mid: sky.mid, near: sky.near, 'band-a': sky.bandA, 'band-b': sky.bandB };
    for (const [name, color] of Object.entries(paint)) parts(name).forEach((part) => part.setAttribute('fill', color));
    parts('stars').forEach((part) => part.setAttribute('opacity', String(sky.stars)));

    // The sun and the moon each cross the sky in an arc. Each picture says where its arcs run:
    // data-sun is "left width horizon rise size shrink", data-moon is "left width horizon rise".
    for (const picture of pictures) {
      const [sx, sw, sh, sr, size, shrink] = picture.dataset.sun!.split(' ').map(Number);
      const [mx, mw, mh, mr] = picture.dataset.moon!.split(' ').map(Number);
      const sun = picture.querySelector('[data-part="sun"]')!;
      const moon = picture.querySelector('[data-part="moon"]')!;
      if (sky.sunAt === null) sun.setAttribute('visibility', 'hidden');
      else {
        const height = Math.max(0, Math.sin(Math.PI * sky.sunAt));
        sun.setAttribute('visibility', 'visible');
        sun.setAttribute('cx', (sx + sky.sunAt * sw).toFixed(0));
        sun.setAttribute('cy', (sh - Math.sin(Math.PI * sky.sunAt) * sr).toFixed(0));
        sun.setAttribute('r', (size - height * shrink).toFixed(0));
        sun.setAttribute('fill', sky.sun);
      }
      // The moon keeps clear of the big cloud so it is never hidden behind it.
      if (sky.moonAt === null) moon.setAttribute('visibility', 'hidden');
      else {
        const x = mx + sky.moonAt * mw;
        const y = mh - Math.sin(Math.PI * sky.moonAt) * mr;
        moon.setAttribute('visibility', 'visible');
        moon.setAttribute('transform', `translate(${x.toFixed(0)} ${y.toFixed(0)}) rotate(-25)`);
      }
    }

    el('piece-phase').textContent = sky.phase;
    el('piece-clock').textContent = `${asked !== null ? formatHour(hour) : now.clock},`;
    // The rest of the page takes its edges from the picture.
    document.documentElement.style.setProperty('--sky-top', sky.sky[0]);
    document.documentElement.style.setProperty('--ground', sky.near);
  };
  paintSky();
  setInterval(paintSky, 30_000);

  // Portrait screens get the tall picture.
  const fit = () => frame.classList.toggle('is-tall', frame.clientWidth / Math.max(1, frame.clientHeight) < 0.85);
  new ResizeObserver(fit).observe(frame);
  fit();

  // The practice: primary series, Savasana, second series, Savasana, and round again.
  const yogis = parts('yogi');
  const steps = practice.flatMap((part) => part.steps.map((s) => ({ ...s, series: part.series })));
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MOVE = calm ? 0 : 1.4;
  let index = 0;
  // Begin already standing, not halfway out of the last pose.
  let since = performance.now() - MOVE * 1000;
  let settled = false;

  const announce = () => {
    el('piece-series').textContent = steps[index].series;
    el('piece-asana').textContent = steps[index].name;
  };
  announce();

  const tick = (time: number) => {
    const step = steps[index];
    const previous = steps[(index - 1 + steps.length) % steps.length];
    const elapsed = (time - since) / 1000;
    if (elapsed < MOVE) {
      const k = elapsed / MOVE;
      const drawn = draw(blend(poses[previous.pose], poses[step.pose], k * k * (3 - 2 * k)));
      yogis.forEach((yogi) => (yogi.innerHTML = drawn));
      settled = false;
    } else if (!settled) {
      const drawn = draw(poses[step.pose]);
      yogis.forEach((yogi) => (yogi.innerHTML = drawn));
      settled = true;
    } else if (elapsed > MOVE + step.hold) {
      index = (index + 1) % steps.length;
      since = time;
      announce();
    }
    requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
</script>
