---
// Page two: one picture that takes the whole page. A desert at dusk, a figure in crow pose
// on a pink mat on top of a mesa, and a very large cloud watching.
import Nube from './Nube.astro';

const ink = '#121a3a';

// Stars scattered with a fixed seed, so the sky is the same on every visit.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 90 }, () => ({
  x: Math.round(rand() * 1600),
  y: Math.round(rand() * 430),
  r: +(0.8 + rand() * 1.8).toFixed(1),
  gold: rand() > 0.8,
  twinkle: rand() > 0.72,
  delay: +(rand() * 4).toFixed(1),
}));

const saguaro = (x: number, y: number, s: number) =>
  `M${x - 9 * s} ${y} V${y - 150 * s} a${9 * s} ${9 * s} 0 0 1 ${18 * s} 0 V${y} Z ` +
  `M${x - 9 * s} ${y - 70 * s} h${-22 * s} a${8 * s} ${8 * s} 0 0 1 ${-8 * s} ${-8 * s} v${-34 * s} a${7 * s} ${7 * s} 0 0 1 ${14 * s} 0 v${28 * s} h${16 * s} Z ` +
  `M${x + 9 * s} ${y - 96 * s} h${24 * s} a${8 * s} ${8 * s} 0 0 0 ${8 * s} ${-8 * s} v${-40 * s} a${7 * s} ${7 * s} 0 0 0 ${-14 * s} 0 v${34 * s} h${-18 * s} Z`;
---

<section class="next-page" id="next-page" aria-labelledby="piece-title">
  <svg class="piece" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" role="img" aria-label="A desert at dusk. On top of a blue mesa a small figure balances in crow pose on a pink mat, under a huge white cloud with eyes. A yellow moon sets behind purple mesas, with saguaros in the foreground.">
    <defs>
      <linearGradient id="dusk" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1b1147" />
        <stop offset="0.38" stop-color="#3a1a6e" />
        <stop offset="0.56" stop-color="#7b2d8e" />
        <stop offset="0.68" stop-color="#f0508f" />
        <stop offset="0.76" stop-color="#ffb37a" />
      </linearGradient>
    </defs>
    <rect width="1600" height="900" fill="url(#dusk)" />

    <g class="depth" style="--d:4">
      {
        stars.map((s) => (
          <circle class={s.twinkle ? 'star twinkle' : 'star'} cx={s.x} cy={s.y} r={s.r} fill={s.gold ? '#f2cb3a' : '#fbf4e4'} style={s.twinkle ? `animation-delay:${s.delay}s` : undefined} />
        ))
      }
    </g>

    <g class="depth" style="--d:8">
      <circle cx="1150" cy="505" r="150" fill="#f2cb3a" />
      <g fill="#f6b7cf">
        <rect x="90" y="330" width="430" height="30" rx="15" />
        <rect x="200" y="368" width="250" height="22" rx="11" />
        <rect x="1280" y="330" width="330" height="28" rx="14" />
      </g>
      <g fill="#f0508f">
        <rect x="980" y="430" width="380" height="26" rx="13" />
        <rect x="1060" y="468" width="220" height="20" rx="10" />
        <rect x="-40" y="486" width="300" height="24" rx="12" />
      </g>
    </g>

    <g class="depth" style="--d:14">
      <path d="M0 640 V540 H120 L150 500 H330 L360 560 H520 L560 470 H700 L730 560 H980 L1010 520 H1180 L1210 580 H1420 L1450 510 H1600 V640 Z" fill="#7b2d8e" />
    </g>

    <g class="depth" style="--d:22">
      <Nube variant={0} attrs={{ x: 470, y: 50, width: 600, height: 386 }} />
      <Nube variant={2} fill="#f6b7cf" attrs={{ x: 1250, y: 130, width: 210, height: 135 }} />
    </g>

    <g class="depth" style="--d:30" stroke={ink} stroke-width="6" stroke-linejoin="round">
      <path d="M-20 720 V610 H200 L240 560 H420 L450 640 H590 L640 600 H960 L1000 660 H1150 L1190 590 H1330 L1360 650 H1620 V720 Z" fill="#1f3fcf" />
      <!-- The figure in crow pose, on a pink mat on the mesa. -->
      <g transform="translate(648 333) scale(1.5)" stroke-linecap="round">
        <rect x="6" y="169" width="190" height="9" rx="2" fill="#f0508f" stroke-width="4" />
        <path d="M140 96 L108 127" fill="none" stroke-width="22" />
        <path d="M140 96 L108 127" fill="none" stroke="#c98f5f" stroke-width="13" />
        <path d="M108 127 L166 128" fill="none" stroke-width="19" />
        <path d="M108 127 L166 128" fill="none" stroke="#c98f5f" stroke-width="10" />
        <ellipse cx="172" cy="126" rx="10" ry="6" fill="#c98f5f" stroke-width="4" />
        <ellipse cx="114" cy="101" rx="34" ry="18" transform="rotate(-35 114 101)" fill="#fbf4e4" stroke-width="4.5" />
        <ellipse cx="139" cy="88" rx="21" ry="18" fill="#1f3fcf" stroke-width="4.5" />
        <path d="M96 118 L103 166" fill="none" stroke-width="21" />
        <path d="M96 118 L103 166" fill="none" stroke="#fbf4e4" stroke-width="12" />
        <ellipse cx="100" cy="168" rx="13" ry="5" fill="#c98f5f" stroke-width="4" />
        <circle cx="76" cy="130" r="14" fill="#c98f5f" stroke-width="4.5" />
        <path d="M63 126 a14 14 0 0 1 22 -7 q-10 2 -12 12 Z" fill={ink} stroke-width="3" />
        <circle cx="62" cy="118" r="7" fill={ink} stroke-width="3" />
      </g>
    </g>

    <g class="depth" style="--d:44" stroke={ink} stroke-width="6" stroke-linejoin="round">
      <path d={saguaro(250, 730, 1.15)} fill="#2f8f4e" />
      <path d={saguaro(1420, 760, 1.45)} fill="#2f8f4e" />
      <path d={saguaro(1130, 716, 0.7)} fill="#2f8f4e" />
      <path d="M-30 920 V720 H260 L300 690 H520 L560 740 H1040 L1090 700 H1300 L1340 750 H1630 V920 Z" fill={ink} />
    </g>
  </svg>

  <div class="placard">
    <h2 id="piece-title">Bakasana at dusk</h2>
    <p>Page two</p>
    <button class="next-page-back" type="button" id="back-to-start">Back to the street</button>
  </div>
</section>
