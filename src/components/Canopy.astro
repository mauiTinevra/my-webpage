---
// A forest canopy in ink, drawn in code: scalloped crowns outlined in ink, each with a darker,
// hatched shadow and a lighter top, coral trunks showing through, and hatched clouds. Seeded,
// so it draws the same every build. "hero" is the full scene; "strip" is a low band of treetops.
interface Props {
  variant?: 'hero' | 'strip';
  class?: string;
}
const { variant = 'hero', class: className } = Astro.props;

const W = 1600;
const H = variant === 'hero' ? 600 : 220;
const ink = '#17271d';

// A small seeded random generator (mulberry32).
let seed = variant === 'hero' ? 20261117 : 7;
const rand = () => {
  seed |= 0;
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const between = (a: number, b: number) => a + rand() * (b - a);
const r1 = (n: number) => Math.round(n * 10) / 10;

// Mix two hex colors.
const mix = (a: string, b: string, t: number) => {
  const p = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const [x, y] = [p(a), p(b)];
  return '#' + x.map((v, i) => Math.round(v + (y[i] - v) * t).toString(16).padStart(2, '0')).join('');
};

// A cauliflower blob: points around an ellipse, joined by curves that bulge outward.
const blob = (cx: number, cy: number, rx: number, ry: number, n: number, rough = 0.14) => {
  const turn = rand() * Math.PI * 2;
  const pts = Array.from({ length: n }, (_, i) => {
    const a = turn + (i / n) * Math.PI * 2;
    const k = 1 - rough + rand() * rough;
    return [cx + Math.cos(a) * rx * k, cy + Math.sin(a) * ry * k];
  });
  let d = `M${r1(pts[0][0])} ${r1(pts[0][1])}`;
  pts.forEach((p, i) => {
    const q = pts[(i + 1) % n];
    const mx = (p[0] + q[0]) / 2;
    const my = (p[1] + q[1]) / 2;
    const len = Math.hypot(q[0] - p[0], q[1] - p[1]);
    const ox = mx - cx;
    const oy = my - cy;
    const ol = Math.hypot(ox, oy) || 1;
    const bulge = len * between(0.3, 0.45);
    d += `Q${r1(mx + (ox / ol) * bulge)} ${r1(my + (oy / ol) * bulge)} ${r1(q[0])} ${r1(q[1])}`;
  });
  return d + 'Z';
};

type Crown = { d: string; shade: string; shadow: string; light: string; lightD: string; fill: string; clumps: string };
// One row of crowns along the canopy line. `top(x)` is where crown centers sit.
const row = (fill: string, rMin: number, rMax: number, top: (x: number) => number, gap = 0.95): Crown[] => {
  const out: Crown[] = [];
  let x = -rMax * 0.6;
  while (x < W + rMax) {
    const R = between(rMin, rMax);
    const cx = x + R * 0.5;
    const cy = top(cx) + between(-R * 0.25, R * 0.25);
    const ry = R * between(0.72, 0.9);
    const n = Math.max(9, Math.round(R / 7));
    const clumps = Array.from({ length: Math.round(R / 22) }, () => {
      const a = between(Math.PI * 0.95, Math.PI * 1.75);
      const dist = between(0.25, 0.7) * R;
      const px = cx + Math.cos(a) * dist;
      const py = cy + Math.sin(a) * dist * 0.8;
      const s = between(5, 10);
      return `M${r1(px)} ${r1(py)}q${r1(s * 0.6)} ${r1(-s * 0.7)} ${r1(s * 1.3)} ${r1(-s * 0.1)}`;
    }).join('');
    out.push({
      d: blob(cx, cy, R, ry, n),
      shadow: blob(cx + R * 0.2, cy + ry * 0.24, R * 0.66, ry * 0.6, Math.max(8, n - 3), 0.2),
      lightD: blob(cx - R * 0.26, cy - ry * 0.3, R * 0.36, ry * 0.3, 8, 0.2),
      fill,
      shade: mix(fill, '#0b1f14', 0.38),
      light: mix(fill, '#e8f5c8', 0.28),
      clumps,
    });
    x += R * gap * between(0.75, 1.1);
  }
  return out;
};

// The canopy line rises toward the right, so words can sit in the sky on the left.
const wave = (x: number, amp: number, f: number, ph: number) => Math.sin(x * f + ph) * amp;
const hero = variant === 'hero';
const lift = (x: number) => (hero ? (x / W) * 230 - 50 : 0);
const rows: Crown[][] = hero
  ? [
      row('#2f8f7b', 70, 120, (x) => 300 - lift(x) + wave(x, 30, 0.006, 1)),
      row('#2a6f45', 80, 130, (x) => 360 - lift(x) * 0.8 + wave(x, 26, 0.008, 3)),
      row('#3d9a5a', 70, 120, (x) => 430 - lift(x) * 0.5 + wave(x, 22, 0.01, 0.5)),
      row('#5fbb74', 60, 100, (x) => 505 - lift(x) * 0.2 + wave(x, 18, 0.013, 2)),
      row('#2f8a5c', 55, 90, (x) => 585 + wave(x, 12, 0.02, 4), 0.85),
    ]
  : [
      row('#2a6f45', 55, 90, (x) => 95 + wave(x, 18, 0.009, 2)),
      row('#3d9a5a', 50, 80, (x) => 150 + wave(x, 14, 0.012, 5)),
      row('#2f8a5c', 45, 70, (x) => 210 + wave(x, 10, 0.02, 1), 0.85),
    ];

// Coral trunks between the back rows, leaning a little.
const trunks = hero
  ? [
      { x: 1010, top: 150, lean: -60, w: 16 },
      { x: 560, top: 330, lean: 30, w: 11 },
      { x: 1330, top: 210, lean: 24, w: 10 },
    ].map(({ x, top, lean, w }) => {
      const bx = x - lean;
      return {
        d: `M${bx - w} ${H}L${x - w * 0.45} ${top}L${x + w * 0.45} ${top}L${bx + w} ${H}Z`,
        branch: `M${x - lean * 0.35} ${top + (H - top) * 0.35}q${-w * 2} ${-w * 3} ${-w * 4.5} ${-w * 4}`,
        crown: blob(x, top - 10, 62 + w * 2, 48 + w, 12),
      };
    })
  : [];

// Clouds: overlapping circles over a flat base, outlined once, hatched underneath.
const clouds = hero
  ? [
      { x: 1180, y: 190, w: 300 },
      { x: 880, y: 120, w: 150 },
      { x: 1490, y: 105, w: 120 },
    ].map(({ x, y, w }) => {
      const k = Math.max(3, Math.round(w / 55));
      const puffs = Array.from({ length: k }, (_, i) => {
        const t = (i + 0.5) / k;
        const r = w * (0.16 + Math.sin(t * Math.PI) * 0.16) * between(0.85, 1.1);
        return { cx: r1(x - w / 2 + t * w), cy: r1(y - r * 0.55), r: r1(r) };
      });
      return { x, y, w, puffs };
    })
  : [];

const id = `cn-${variant}`;
---

<svg
  class:list={['canopy', `canopy-${variant}`, className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
>
  <defs>
    <pattern id={`${id}-hatch`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(38)">
      <line x1="0" y1="0" x2="0" y2="7" stroke={ink} stroke-width="1.1" />
    </pattern>
  </defs>

  {
    clouds.map((c, i) => (
      <g class="cloud">
        <clipPath id={`${id}-cloud-${i}`}>
          {c.puffs.map((p) => <circle cx={p.cx} cy={p.cy} r={p.r} />)}
          <rect x={c.x - c.w / 2} y={c.y - 20} width={c.w} height="20" rx="10" />
        </clipPath>
        {c.puffs.map((p) => <circle cx={p.cx} cy={p.cy} r={p.r} fill="none" stroke={ink} stroke-width="3" />)}
        <rect x={c.x - c.w / 2} y={c.y - 20} width={c.w} height="20" rx="10" fill="none" stroke={ink} stroke-width="3" />
        <g clip-path={`url(#${id}-cloud-${i})`}>
          <rect x={c.x - c.w} y={c.y - c.w} width={c.w * 2} height={c.w * 2} fill="#e3efe6" />
          <rect x={c.x - c.w} y={c.y - c.w * 0.12} width={c.w * 2} height={c.w} fill="#c7dccf" />
          <rect x={c.x - c.w} y={c.y - c.w * 0.1} width={c.w * 2} height={c.w} fill={`url(#${id}-hatch)`} opacity="0.55" />
          {c.puffs.slice(1).map((p) => (
            <path d={`M${p.cx - p.r * 0.7} ${p.cy + p.r * 0.2}a${p.r * 0.7} ${p.r * 0.7} 0 0 1 ${p.r * 0.9} ${-p.r * 0.55}`} fill="none" stroke={ink} stroke-width="1.4" opacity="0.6" />
          ))}
        </g>
      </g>
    ))
  }

  <!-- The dark behind the leaves, so gaps between crowns read as deep shade. -->
  <path d={`M0 ${hero ? 360 : 120}${Array.from({ length: 17 }, (_, i) => `L${i * 100} ${(hero ? 420 - (i * 100 / W) * 230 : 130)}`).join('')}L${W} ${H}L0 ${H}Z`} fill="#0e2a1b" />

  {
    rows.map((r, i) => (
      <g>
        {i === 2 && trunks.map((t) => (
          <g>
            <path d={t.d} fill="#e8836b" stroke={ink} stroke-width="2.5" stroke-linejoin="round" />
            <path d={t.branch} fill="none" stroke="#e8836b" stroke-width="5" stroke-linecap="round" />
            <path d={t.crown} fill="#2f8f7b" stroke={ink} stroke-width="2.4" stroke-linejoin="round" />
          </g>
        ))}
        {r.map((c) => (
          <g>
            <path d={c.d} fill={c.fill} stroke={ink} stroke-width="2.4" stroke-linejoin="round" />
            <path d={c.shadow} fill={c.shade} />
            <path d={c.shadow} fill={`url(#${id}-hatch)`} opacity="0.35" />
            <path d={c.lightD} fill={c.light} />
            <path d={c.clumps} fill="none" stroke={ink} stroke-width="1.4" stroke-linecap="round" opacity="0.7" />
          </g>
        ))}
      </g>
    ))
  }
</svg>

<style>
  .canopy { display: block; width: 100%; height: 100%; }
</style>
