---
// A cloud character, sprayed on a shutter. Each variant is a different cluster of bubbles.
interface Props {
  variant?: 0 | 1 | 2;
  fill?: string;
  line?: string;
}

const { variant = 0, fill = '#fff', line = '#121a3a' } = Astro.props;

const shapes = [
  [
    [70, 95, 42],
    [120, 70, 52],
    [178, 82, 46],
    [222, 104, 34],
    [150, 112, 44],
    [100, 118, 36],
  ],
  [
    [62, 104, 34],
    [104, 78, 44],
    [156, 62, 50],
    [206, 88, 44],
    [176, 116, 40],
    [118, 120, 40],
  ],
  [
    [80, 84, 46],
    [138, 96, 40],
    [190, 72, 48],
    [226, 110, 30],
    [164, 122, 36],
    [104, 122, 34],
  ],
];
const bubbles = shapes[variant];
const eyes = [
  [118, 92],
  [164, 92],
];
---

<svg class="nube" viewBox="0 0 280 180" aria-hidden="true" data-nube>
  <g fill={line} stroke={line} stroke-width="16">
    {bubbles.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
  </g>
  <g fill={fill}>
    {bubbles.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
  </g>
  {
    eyes.map(([cx, cy]) => (
      <g data-eye={`${cx},${cy}`}>
        <ellipse cx={cx} cy={cy} rx="13" ry="18" fill="#fff" stroke={line} stroke-width="5" />
        <ellipse class="pupil" cx={cx} cy={cy} rx="6" ry="9" fill={line} />
      </g>
    ))
  }
</svg>
