---
// Row two: the same five places as printed posters, in the manner of Sam's Solo Sport poster.
// Each poster leans toward the pointer and turns over to show what is inside.
import { Image } from 'astro:assets';
import { site, sections } from '../../site';
import pinkWall from '../../assets/photos/pink-wall.jpg';

interface Item {
  label: string;
  href?: string;
}
interface Props {
  // What is printed on the back of each poster.
  backs: Record<string, Item[]>;
}
const { backs } = Astro.props;
---

<div class="row row-posters" data-row data-reverse>
  <div class="scene">
    <div class="track">
      <article class="cartel cartel-sam">
        <div class="cartel-card">
          <button class="cartel-front" type="button" aria-expanded="false" aria-controls="back-sam">
            <Image class="cartel-photo" src={pinkWall} alt="Sam standing in front of a pink wall in layered clothes" widths={[480, 900]} sizes="(max-width: 700px) 70vw, 420px" />
            <span class="cartel-wedge"></span>
            <span class="cartel-title">Sam</span>
            <span class="cartel-second">Tinevra</span>
            <span class="cartel-credit">Artist <i>Scottsdale</i></span>
            <span class="visually-hidden">Turn the poster over</span>
          </button>
          <div class="cartel-back" id="back-sam" inert>
            <h2>{site.name}</h2>
            <p>{site.intro}</p>
            <ul>
              {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
            <button class="cartel-turn" type="button">Turn it back over</button>
          </div>
        </div>
      </article>

      {
        sections.map((s) => (
          <article class={`cartel cartel-${s.place}`}>
            <div class="cartel-card">
              <button class="cartel-front" type="button" aria-expanded="false" aria-controls={`back-${s.place}`}>
                <span class="cartel-disc" />
                <span class="cartel-wedge" />
                <span class="cartel-title">{s.name}</span>
                <span class="cartel-second">{s.note}</span>
                <span class="cartel-credit">
                  Samuel Tinevra <i>Scottsdale</i>
                </span>
                <span class="visually-hidden">Turn the poster over</span>
              </button>
              <div class="cartel-back" id={`back-${s.place}`} inert>
                <h2>{s.name}</h2>
                <ul>
                  {backs[s.place].map((item) => (
                    <li>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</li>
                  ))}
                </ul>
                <a class="cartel-go" href={s.href}>
                  Go to {s.name.toLowerCase()}
                </a>
                <button class="cartel-turn" type="button">
                  Turn it back over
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</div>

<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.cartel').forEach((cartel) => {
    const card = cartel.querySelector<HTMLElement>('.cartel-card')!;
    const front = cartel.querySelector<HTMLButtonElement>('.cartel-front')!;
    const back = cartel.querySelector<HTMLElement>('.cartel-back')!;
    const turn = cartel.querySelector<HTMLButtonElement>('.cartel-turn')!;

    const flip = (over: boolean) => {
      cartel.classList.toggle('is-flipped', over);
      front.setAttribute('aria-expanded', String(over));
      front.inert = over;
      back.inert = !over;
      card.style.removeProperty('--rx');
      card.style.removeProperty('--ry');
      (over ? turn : front).focus({ preventScroll: true });
    };
    front.addEventListener('click', () => flip(true));
    turn.addEventListener('click', () => flip(false));
    back.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') flip(false);
    });

    if (calm) return;
    // The poster leans toward the pointer.
    cartel.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || cartel.classList.contains('is-flipped')) return;
      const r = cartel.getBoundingClientRect();
      card.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * 12}deg`);
      card.style.setProperty('--rx', `${(0.5 - (e.clientY - r.top) / r.height) * 9}deg`);
    });
    cartel.addEventListener('pointerleave', () => {
      card.style.removeProperty('--rx');
      card.style.removeProperty('--ry');
    });
  });
</script>
