---
// Page three: an arcade game in white pixels on black. Rows of small pixel creatures march
// down the screen: an eye, a cloud, a saguaro, a piñata star and the dog. Your ship is a
// spray can from the street; it shoots paint.
---

<section class="space-page" id="space-page" aria-labelledby="space-title">
  <canvas id="space-canvas" aria-label="Game area"></canvas>

  <div class="space-hud visually-hidden" aria-live="off">
    <span>Score <b id="space-score">0</b></span>
    <span>Best <b id="space-best">0</b></span>
    <span>Lives <b id="space-lives">3</b></span>
  </div>

  <div class="space-panel" id="space-panel">
    <h2 id="space-title" class="space-title">Paint them out</h2>
    <p id="space-message">They are coming down. Paint them before they reach you.</p>
    <p class="space-keys">
      Move with the arrow keys or your mouse. Shoot with the space bar or a click. On a phone, drag to move and
      the can sprays by itself. Press Escape to pause.
    </p>
    <button class="space-play" type="button" id="space-play">Play</button>
  </div>
</section>

<script>
  const section = document.getElementById('space-page')!;
  const canvas = document.getElementById('space-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const panel = document.getElementById('space-panel')!;
  const message = document.getElementById('space-message')!;
  const playButton = document.getElementById('space-play') as HTMLButtonElement;
  const scoreEl = document.getElementById('space-score')!;
  const bestEl = document.getElementById('space-best')!;
  const livesEl = document.getElementById('space-lives')!;

  const CREAM = '#fbf4e4';
  const INK = '#121a3a';
  const PAINTS = ['#f0508f', '#f2cb3a', '#1e9fea', '#ffffff'];
  const BEST_KEY = 'sam-tinevra-arcade-best';
  // The creatures, one kind per row, each with two frames it flips between as it marches.
  // Every one is drawn on a 12 by 8 grid of pixels.
  const SPRITES: [string[], string[]][] = [
    // An eye that looks from side to side.
    [
      ['....####....', '..########..', '.###....###.', '###.##...###', '###.##...###', '.###....###.', '..########..', '....####....'],
      ['....####....', '..########..', '.###....###.', '###...##.###', '###...##.###', '.###....###.', '..########..', '....####....'],
    ],
    // A cloud with eyes, dripping.
    [
      ['....####....', '..########..', '.##########.', '############', '##.##..##.##', '############', '.##########.', '..#..#..#...'],
      ['....####....', '..########..', '.##########.', '############', '##.##..##.##', '############', '.##########.', '...#..#..#..'],
    ],
    // A saguaro waving its arms.
    [
      ['.....##.....', '.##..##.....', '.##..##..##.', '.##..##..##.', '.######..##.', '.....######.', '.....##.....', '....####....'],
      ['.....##.....', '.....##..##.', '.##..##..##.', '.##..##..##.', '.##..######.', '.######.....', '.....##.....', '....####....'],
    ],
    // A piñata star.
    [
      ['.....##.....', '.#...##...#.', '..#.####.#..', '...######...', '####.##.####', '...######...', '..#.####.#..', '.#...##...#.'],
      ['............', '.....##.....', '..#.####.#..', '...######...', '.###.##.###.', '...######...', '..#.####.#..', '.....##.....'],
    ],
    // The dog, ears down and ears up.
    [
      ['.##......##.', '####....####', '.##########.', '.##.####.##.', '.##########.', '.####..####.', '..########..', '....####....'],
      ['##........##', '###......###', '.##########.', '.##.####.##.', '.##########.', '.####..####.', '..########..', '....####....'],
    ],
  ];
  const ROWS = SPRITES.length;
  // The size of one pixel, set from the screen in resize().
  let PX = 4;
  let CLOUD_W = 48;
  let CLOUD_H = 32;
  let tick = 0;
  let stepIn = 0;

  type Cloud = { col: number; row: number; alive: boolean };
  type Shot = { x: number; y: number; color: string };
  type Splat = { x: number; y: number; vx: number; vy: number; life: number; color: string };

  let width = 0;
  let height = 0;
  let state: 'idle' | 'playing' | 'paused' | 'over' = 'idle';
  let clouds: Cloud[] = [];
  let cols = 0;
  let groupX = 0;
  let groupY = 0;
  let direction = 1;
  let shots: Shot[] = [];
  let rain: Shot[] = [];
  let splats: Splat[] = [];
  let shipX = 0;
  let cooldown = 0;
  let rainIn = 1;
  let safeFor = 0;
  let paint = 0;
  let score = 0;
  let lives = 3;
  let wave = 1;
  let best = 0;
  let last = 0;
  let auto = false;
  const held = new Set<string>();

  try {
    best = Number(localStorage.getItem(BEST_KEY)) || 0;
  } catch {
    best = 0;
  }
  bestEl.textContent = String(best);

  const cellW = () => CLOUD_W + PX * 4;
  const cellH = () => CLOUD_H + PX * 4;
  const shipY = () => height - 64;
  const cloudAt = (cloud: Cloud) => [groupX + cloud.col * cellW(), groupY + cloud.row * cellH()];

  const spawn = () => {
    cols = Math.max(4, Math.min(11, Math.floor((width - PX * 24) / cellW())));
    clouds = [];
    for (let row = 0; row < ROWS; row++) for (let col = 0; col < cols; col++) clouds.push({ col, row, alive: true });
    groupX = (width - cols * cellW()) / 2;
    // Start under the header and the score.
    groupY = headerHeight() + PX * 14;
    direction = 1;
    shots = [];
    rain = [];
    rainIn = 1.2;
  };

  const hud = () => {
    scoreEl.textContent = String(score);
    livesEl.textContent = String(lives);
    bestEl.textContent = String(best);
  };

  const show = (text: string, button: string) => {
    message.textContent = text;
    playButton.textContent = button;
    panel.hidden = false;
  };

  const start = () => {
    if (state === 'idle' || state === 'over') {
      score = 0;
      lives = 3;
      wave = 1;
      shipX = width / 2;
      spawn();
    }
    state = 'playing';
    panel.hidden = true;
    last = performance.now();
    hud();
    canvas.focus({ preventScroll: true });
    requestAnimationFrame(frame);
  };

  const pause = () => {
    if (state !== 'playing') return;
    state = 'paused';
    held.clear();
    show('Paused.', 'Keep playing');
  };

  const end = () => {
    state = 'over';
    held.clear();
    if (score > best) {
      best = score;
      try {
        localStorage.setItem(BEST_KEY, String(best));
      } catch {
        /* Storage unavailable: the best score lasts until the page closes. */
      }
    }
    hud();
    show(`They got you. You scored ${score}.`, 'Play again');
  };

  const burst = (x: number, y: number, color: string) => {
    for (let i = 0; i < 9; i++) {
      const angle = Math.random() * Math.PI * 2;
      const speed = 60 + Math.random() * 160;
      splats.push({ x, y, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed, life: 0.5, color });
    }
  };

  const update = (dt: number) => {
    // The can.
    const steer = (held.has('ArrowRight') || held.has('d') ? 1 : 0) - (held.has('ArrowLeft') || held.has('a') ? 1 : 0);
    shipX = Math.min(width - 24, Math.max(24, shipX + steer * 440 * dt));
    cooldown -= dt;
    safeFor -= dt;
    if ((held.has(' ') || auto) && cooldown <= 0) {
      shots.push({ x: shipX, y: shipY() - 26, color: PAINTS[paint++ % PAINTS.length] });
      cooldown = 0.26;
    }

    // They march in steps, quicker as their numbers thin, and drop a row at each edge.
    const alive = clouds.filter((c) => c.alive);
    stepIn -= dt;
    if (stepIn <= 0) {
      stepIn = Math.max(0.05, (0.62 - wave * 0.05) * (0.12 + 0.88 * (alive.length / clouds.length)));
      tick += 1;
      const xs = alive.map((c) => cloudAt(c)[0]);
      const next = direction * PX * 2;
      if (Math.min(...xs) + next < PX * 2 || Math.max(...xs) + CLOUD_W + next > width - PX * 2) {
        direction *= -1;
        groupY += PX * 4;
      } else groupX += next;
    }

    // Paint going up.
    for (const shot of shots) shot.y -= 640 * dt;
    shots = shots.filter((shot) => {
      if (shot.y < -10) return false;
      for (const cloud of alive) {
        if (!cloud.alive) continue;
        const [x, y] = cloudAt(cloud);
        if (shot.x > x && shot.x < x + CLOUD_W && shot.y > y && shot.y < y + CLOUD_H) {
          cloud.alive = false;
          score += 10 * (ROWS - cloud.row);
          burst(x + CLOUD_W / 2, y + CLOUD_H / 2, shot.color);
          hud();
          return false;
        }
      }
      return true;
    });

    // Rain coming down.
    rainIn -= dt;
    if (rainIn <= 0 && alive.length) {
      const cloud = alive[Math.floor(Math.random() * alive.length)];
      const [x, y] = cloudAt(cloud);
      rain.push({ x: x + CLOUD_W / 2, y: y + CLOUD_H, color: '#fff' });
      rainIn = Math.max(0.4, 1.15 - wave * 0.08) * (0.6 + Math.random() * 0.8);
    }
    for (const drop of rain) drop.y += (210 + wave * 14) * dt;
    rain = rain.filter((drop) => {
      if (drop.y > height + 10) return false;
      if (safeFor <= 0 && Math.abs(drop.x - shipX) < 17 && drop.y > shipY() - 24 && drop.y < shipY() + 22) {
        lives -= 1;
        safeFor = 1.4;
        burst(shipX, shipY(), '#fff');
        hud();
        return false;
      }
      return true;
    });

    for (const splat of splats) {
      splat.x += splat.vx * dt;
      splat.y += splat.vy * dt;
      splat.life -= dt;
    }
    splats = splats.filter((splat) => splat.life > 0);

    const lowest = Math.max(...alive.map((c) => cloudAt(c)[1] + CLOUD_H), 0);
    if (lives <= 0 || lowest > shipY() - 20) return end();
    if (!alive.some((c) => c.alive)) {
      wave += 1;
      spawn();
    }
  };

  const draw = () => {
    ctx.clearRect(0, 0, width, height);

    ctx.fillStyle = '#fff';
    for (const cloud of clouds) {
      if (!cloud.alive) continue;
      const [x, y] = cloudAt(cloud);
      const rows = SPRITES[cloud.row % SPRITES.length][tick % 2];
      for (let r = 0; r < rows.length; r++) {
        for (let c = 0; c < 12; c++) {
          if (rows[r][c] === '#') ctx.fillRect(Math.round(x) + c * PX, Math.round(y) + r * PX, PX, PX);
        }
      }
    }

    // The score and the best score, in pixel numerals, with a can for each life left.
    const top = headerHeight() + PX * 2;
    digits(String(score).padStart(4, '0'), PX * 6, top);
    digits(String(Math.max(best, score)).padStart(4, '0'), PX * 6 + PX * 30, top);
    for (let i = 0; i < lives; i++) {
      ctx.fillRect(width - PX * 6 - i * PX * 6 - PX * 3, top + PX, PX * 3, PX * 4);
      ctx.fillRect(width - PX * 6 - i * PX * 6 - PX * 2, top, PX, PX);
    }

    for (const shot of shots) {
      ctx.fillStyle = shot.color;
      ctx.fillRect(shot.x - PX / 2, shot.y - PX * 2, PX, PX * 4);
    }
    // What they drop: a zigzag of white pixels.
    ctx.fillStyle = '#fff';
    for (const drop of rain) {
      for (let i = 0; i < 4; i++) ctx.fillRect(drop.x + ((i + tick) % 2 ? 0 : -PX), drop.y - PX * 2 + i * PX, PX, PX);
    }
    for (const splat of splats) {
      ctx.globalAlpha = Math.max(0, splat.life * 2);
      ctx.fillStyle = splat.color;
      ctx.fillRect(splat.x, splat.y, PX, PX);
    }
    ctx.globalAlpha = 1;

    // The spray can. It blinks while it shakes off a hit.
    if (safeFor <= 0 || Math.floor(safeFor * 10) % 2 === 0) {
      const y = shipY();
      ctx.fillStyle = '#fff';
      ctx.fillRect(shipX - PX * 3, y - PX * 2, PX * 6, PX * 8);
      ctx.fillRect(shipX - PX, y - PX * 5, PX * 2, PX * 3);
      // The band on the can shows the colour it sprays next.
      ctx.fillStyle = PAINTS[paint % PAINTS.length];
      ctx.fillRect(shipX - PX * 3, y + PX, PX * 6, PX * 2);
    }
  };

  // Numerals on a 3 by 5 grid.
  const NUMERALS = ['###/#.#/#.#/#.#/###', '.#./##./.#./.#./###', '###/..#/###/#../###', '###/..#/###/..#/###', '#.#/#.#/###/..#/..#', '###/#../###/..#/###', '###/#../###/#.#/###', '###/..#/..#/..#/..#', '###/#.#/###/#.#/###', '###/#.#/###/..#/###'];
  const digits = (text: string, x: number, y: number) => {
    ctx.fillStyle = '#fff';
    [...text].forEach((char, i) => {
      NUMERALS[Number(char)].split('/').forEach((row, r) => {
        for (let c = 0; c < 3; c++) if (row[c] === '#') ctx.fillRect(x + i * PX * 5 + c * PX, y + r * PX, PX, PX);
      });
    });
  };
  const headerHeight = () => document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 64;

  const frame = (time: number) => {
    if (state !== 'playing') return draw();
    // Step away from the game and it waits for you.
    const box = section.getBoundingClientRect();
    if (box.bottom < innerHeight * 0.6 || box.top > innerHeight * 0.4) pause();
    else update(Math.min(0.05, (time - last) / 1000));
    last = time;
    draw();
    if (state === 'playing') requestAnimationFrame(frame);
  };

  const resize = () => {
    const ratio = Math.min(2, devicePixelRatio || 1);
    width = canvas.clientWidth;
    height = canvas.clientHeight;
    PX = Math.max(3, Math.min(5, Math.floor(width / 250), Math.floor(height / 170)));
    CLOUD_W = PX * 12;
    CLOUD_H = PX * 8;
    canvas.width = Math.round(width * ratio);
    canvas.height = Math.round(height * ratio);
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    shipX = Math.min(Math.max(shipX || width / 2, 24), width - 24);
    if (state === 'idle') spawn();
    draw();
  };

  playButton.addEventListener('click', start);

  addEventListener('keydown', (e) => {
    if (state !== 'playing') return;
    if (e.key === 'Escape') return pause();
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    if (!['ArrowLeft', 'ArrowRight', ' ', 'a', 'd'].includes(key)) return;
    // The space bar and arrows would otherwise scroll the page out from under the game.
    e.preventDefault();
    held.add(key);
  });
  addEventListener('keyup', (e) => held.delete(e.key.length === 1 ? e.key.toLowerCase() : e.key));
  addEventListener('blur', pause);

  canvas.addEventListener('pointermove', (e) => {
    if (state !== 'playing') return;
    shipX = e.clientX - canvas.getBoundingClientRect().left;
  });
  canvas.addEventListener('pointerdown', (e) => {
    if (state !== 'playing') return;
    shipX = e.clientX - canvas.getBoundingClientRect().left;
    if (e.pointerType === 'mouse') {
      if (cooldown <= 0) held.add(' ');
      setTimeout(() => held.delete(' '), 60);
    } else {
      // A finger on the screen keeps the can spraying.
      auto = true;
      canvas.setPointerCapture(e.pointerId);
    }
  });
  const release = () => (auto = false);
  canvas.addEventListener('pointerup', release);
  canvas.addEventListener('pointercancel', release);

  new ResizeObserver(resize).observe(canvas);
  resize();
</script>
