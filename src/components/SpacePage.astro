---
// Page three: Cloud Invaders. Above the desert the sky goes black, and the cloud characters
// come down in rows. Your ship is a spray can from the street; it shoots paint, and the
// clouds rain on you.
---

<section class="space-page" id="space-page" aria-labelledby="space-title">
  <canvas id="space-canvas" aria-label="Cloud Invaders game area"></canvas>

  <div class="space-hud" aria-live="off">
    <span>Score <b id="space-score">0</b></span>
    <span>Best <b id="space-best">0</b></span>
    <span>Lives <b id="space-lives">3</b></span>
  </div>

  <div class="space-panel" id="space-panel">
    <h2 id="space-title" class="rotulo">Cloud invaders</h2>
    <p id="space-message">The clouds are coming down. Paint them before they reach you.</p>
    <p class="space-keys">
      Move with the arrow keys or your mouse. Shoot with the space bar or a click. On a phone, drag to move and
      the can sprays by itself. Press Escape to pause.
    </p>
    <button class="space-play" type="button" id="space-play">Play</button>
  </div>
</section>

<script>
  const section = document.getElementById('space-page')!;
  const canvas = document.getElementById('space-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const panel = document.getElementById('space-panel')!;
  const message = document.getElementById('space-message')!;
  const playButton = document.getElementById('space-play') as HTMLButtonElement;
  const scoreEl = document.getElementById('space-score')!;
  const bestEl = document.getElementById('space-best')!;
  const livesEl = document.getElementById('space-lives')!;

  const CREAM = '#fbf4e4';
  const INK = '#121a3a';
  const PAINTS = ['#f0508f', '#f2cb3a', '#1e9fea', '#ffffff'];
  const CLOUDS = ['#ffffff', '#f6b7cf', '#f2cb3a', '#9fd8f6'];
  const BEST_KEY = 'sam-tinevra-cloud-invaders-best';
  // The cloud character: the same bubbles as the ones on the street, in a 280 by 180 box.
  const BUBBLES = [
    [70, 95, 42],
    [120, 70, 52],
    [178, 82, 46],
    [222, 104, 34],
    [150, 112, 44],
    [100, 118, 36],
  ];
  // Clouds are sized to the screen in resize().
  let CLOUD_W = 54;
  let CLOUD_H = (CLOUD_W * 180) / 280;
  const STAMP_W = 180;

  type Cloud = { col: number; row: number; alive: boolean };
  type Shot = { x: number; y: number; color: string };
  type Splat = { x: number; y: number; vx: number; vy: number; life: number; color: string };

  let width = 0;
  let height = 0;
  let state: 'idle' | 'playing' | 'paused' | 'over' = 'idle';
  let clouds: Cloud[] = [];
  let cols = 0;
  let groupX = 0;
  let groupY = 0;
  let direction = 1;
  let shots: Shot[] = [];
  let rain: Shot[] = [];
  let splats: Splat[] = [];
  let shipX = 0;
  let cooldown = 0;
  let rainIn = 1;
  let safeFor = 0;
  let paint = 0;
  let score = 0;
  let lives = 3;
  let wave = 1;
  let best = 0;
  let last = 0;
  let auto = false;
  const held = new Set<string>();
  const stars: [number, number, number][] = [];

  try {
    best = Number(localStorage.getItem(BEST_KEY)) || 0;
  } catch {
    best = 0;
  }
  bestEl.textContent = String(best);

  // Each colour of cloud is drawn once and stamped after that.
  const stamps = CLOUDS.map((fill) => {
    const stamp = document.createElement('canvas');
    const scale = STAMP_W / 280;
    stamp.width = STAMP_W;
    stamp.height = (STAMP_W * 180) / 280;
    const c = stamp.getContext('2d')!;
    c.scale(scale, scale);
    for (const [color, grow] of [
      [INK, 8],
      [fill, 0],
    ] as const) {
      c.fillStyle = color;
      for (const [x, y, r] of BUBBLES) {
        c.beginPath();
        c.arc(x, y, r + grow, 0, Math.PI * 2);
        c.fill();
      }
    }
    return stamp;
  });

  const cellW = () => CLOUD_W + 20;
  const cellH = () => CLOUD_H + 18;
  const shipY = () => height - 64;
  const cloudAt = (cloud: Cloud) => [groupX + cloud.col * cellW(), groupY + cloud.row * cellH()];

  const spawn = () => {
    cols = Math.max(4, Math.min(9, Math.floor((width - 120) / cellW())));
    clouds = [];
    for (let row = 0; row < 4; row++) for (let col = 0; col < cols; col++) clouds.push({ col, row, alive: true });
    groupX = (width - cols * cellW()) / 2;
    // Start just under the score line.
    const hudLine = section.querySelector<HTMLElement>('.space-hud')!;
    groupY = hudLine.offsetTop + hudLine.offsetHeight + 16;
    direction = 1;
    shots = [];
    rain = [];
    rainIn = 1.2;
  };

  const hud = () => {
    scoreEl.textContent = String(score);
    livesEl.textContent = String(lives);
    bestEl.textContent = String(best);
  };

  const show = (text: string, button: string) => {
    message.textContent = text;
    playButton.textContent = button;
    panel.hidden = false;
  };

  const start = () => {
    if (state === 'idle' || state === 'over') {
      score = 0;
      lives = 3;
      wave = 1;
      shipX = width / 2;
      spawn();
    }
    state = 'playing';
    panel.hidden = true;
    last = performance.now();
    hud();
    canvas.focus({ preventScroll: true });
    requestAnimationFrame(frame);
  };

  const pause = () => {
    if (state !== 'playing') return;
    state = 'paused';
    held.clear();
    show('Paused.', 'Keep playing');
  };

  const end = () => {
    state = 'over';
    held.clear();
    if (score > best) {
      best = score;
      try {
        localStorage.setItem(BEST_KEY, String(best));
      } catch {
        /* Storage unavailable: the best score lasts until the page closes. */
      }
    }
    hud();
    show(`The clouds got you. You scored ${score}.`, 'Play again');
  };

  const burst = (x: number, y: number, color: string) => {
    for (let i = 0; i < 9; i++) {
      const angle = Math.random() * Math.PI * 2;
      const speed = 60 + Math.random() * 160;
      splats.push({ x, y, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed, life: 0.5, color });
    }
  };

  const update = (dt: number) => {
    // The can.
    const steer = (held.has('ArrowRight') || held.has('d') ? 1 : 0) - (held.has('ArrowLeft') || held.has('a') ? 1 : 0);
    shipX = Math.min(width - 24, Math.max(24, shipX + steer * 440 * dt));
    cooldown -= dt;
    safeFor -= dt;
    if ((held.has(' ') || auto) && cooldown <= 0) {
      shots.push({ x: shipX, y: shipY() - 26, color: PAINTS[paint++ % PAINTS.length] });
      cooldown = 0.26;
    }

    // The clouds march sideways, and step down at each edge.
    const alive = clouds.filter((c) => c.alive);
    const pace = (30 + wave * 9) * (1 + (1 - alive.length / clouds.length) * 2.2);
    groupX += direction * pace * dt;
    const xs = alive.map((c) => cloudAt(c)[0]);
    if (Math.min(...xs) < 12 || Math.max(...xs) + CLOUD_W > width - 12) {
      direction *= -1;
      groupX += direction * 4;
      groupY += 18;
    }

    // Paint going up.
    for (const shot of shots) shot.y -= 640 * dt;
    shots = shots.filter((shot) => {
      if (shot.y < -10) return false;
      for (const cloud of alive) {
        if (!cloud.alive) continue;
        const [x, y] = cloudAt(cloud);
        if (shot.x > x && shot.x < x + CLOUD_W && shot.y > y && shot.y < y + CLOUD_H) {
          cloud.alive = false;
          score += 10 * (4 - cloud.row);
          burst(x + CLOUD_W / 2, y + CLOUD_H / 2, shot.color);
          hud();
          return false;
        }
      }
      return true;
    });

    // Rain coming down.
    rainIn -= dt;
    if (rainIn <= 0 && alive.length) {
      const cloud = alive[Math.floor(Math.random() * alive.length)];
      const [x, y] = cloudAt(cloud);
      rain.push({ x: x + CLOUD_W / 2, y: y + CLOUD_H, color: '#1e9fea' });
      rainIn = Math.max(0.4, 1.15 - wave * 0.08) * (0.6 + Math.random() * 0.8);
    }
    for (const drop of rain) drop.y += (210 + wave * 14) * dt;
    rain = rain.filter((drop) => {
      if (drop.y > height + 10) return false;
      if (safeFor <= 0 && Math.abs(drop.x - shipX) < 17 && drop.y > shipY() - 24 && drop.y < shipY() + 22) {
        lives -= 1;
        safeFor = 1.4;
        burst(shipX, shipY(), '#1e9fea');
        hud();
        return false;
      }
      return true;
    });

    for (const splat of splats) {
      splat.x += splat.vx * dt;
      splat.y += splat.vy * dt;
      splat.life -= dt;
    }
    splats = splats.filter((splat) => splat.life > 0);

    const lowest = Math.max(...alive.map((c) => cloudAt(c)[1] + CLOUD_H), 0);
    if (lives <= 0 || lowest > shipY() - 20) return end();
    if (!alive.some((c) => c.alive)) {
      wave += 1;
      spawn();
    }
  };

  const draw = () => {
    ctx.clearRect(0, 0, width, height);
    for (const [x, y, r] of stars) {
      ctx.fillStyle = r > 1.4 ? '#f2cb3a' : CREAM;
      ctx.beginPath();
      ctx.arc(x * width, y * height, r, 0, Math.PI * 2);
      ctx.fill();
    }

    for (const cloud of clouds) {
      if (!cloud.alive) continue;
      const [x, y] = cloudAt(cloud);
      ctx.drawImage(stamps[cloud.row % stamps.length], x, y, CLOUD_W, CLOUD_H);
      // The eyes watch the can.
      const scale = CLOUD_W / 280;
      for (const ex of [118, 164]) {
        const cx = x + ex * scale;
        const cy = y + 92 * scale;
        const angle = Math.atan2(shipY() - cy, shipX - cx);
        ctx.fillStyle = '#fff';
        ctx.strokeStyle = INK;
        ctx.lineWidth = Math.max(1.2, 5 * scale);
        ctx.beginPath();
        ctx.ellipse(cx, cy, 13 * scale, 18 * scale, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = INK;
        ctx.beginPath();
        ctx.ellipse(cx + Math.cos(angle) * 6 * scale, cy + Math.sin(angle) * 8 * scale, 6 * scale, 9 * scale, 0, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    for (const shot of shots) {
      ctx.fillStyle = shot.color;
      ctx.beginPath();
      ctx.arc(shot.x, shot.y, 5, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.fillStyle = '#1e9fea';
    for (const drop of rain) {
      ctx.beginPath();
      ctx.moveTo(drop.x, drop.y - 9);
      ctx.quadraticCurveTo(drop.x + 6, drop.y + 2, drop.x, drop.y + 5);
      ctx.quadraticCurveTo(drop.x - 6, drop.y + 2, drop.x, drop.y - 9);
      ctx.fill();
    }
    for (const splat of splats) {
      ctx.globalAlpha = Math.max(0, splat.life * 2);
      ctx.fillStyle = splat.color;
      ctx.beginPath();
      ctx.arc(splat.x, splat.y, 3.5, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    // The spray can. It blinks while it shakes off a hit.
    if (safeFor <= 0 || Math.floor(safeFor * 10) % 2 === 0) {
      const y = shipY();
      ctx.lineWidth = 3;
      ctx.strokeStyle = CREAM;
      ctx.fillStyle = PAINTS[paint % PAINTS.length];
      ctx.beginPath();
      ctx.roundRect(shipX - 13, y - 14, 26, 38, 4);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = CREAM;
      ctx.beginPath();
      ctx.roundRect(shipX - 6, y - 24, 12, 10, 2);
      ctx.fill();
      ctx.stroke();
    }
  };

  const frame = (time: number) => {
    if (state !== 'playing') return draw();
    // Step away from the game and it waits for you.
    const box = section.getBoundingClientRect();
    if (box.bottom < innerHeight * 0.6 || box.top > innerHeight * 0.4) pause();
    else update(Math.min(0.05, (time - last) / 1000));
    last = time;
    draw();
    if (state === 'playing') requestAnimationFrame(frame);
  };

  const resize = () => {
    const ratio = Math.min(2, devicePixelRatio || 1);
    width = canvas.clientWidth;
    height = canvas.clientHeight;
    CLOUD_W = Math.max(42, Math.min(84, width / 15, height / 9));
    CLOUD_H = (CLOUD_W * 180) / 280;
    canvas.width = Math.round(width * ratio);
    canvas.height = Math.round(height * ratio);
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    shipX = Math.min(Math.max(shipX || width / 2, 24), width - 24);
    if (state === 'idle') spawn();
    draw();
  };

  let seed = 3;
  const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
  for (let i = 0; i < 110; i++) stars.push([rand(), rand(), 0.5 + rand() * 1.3]);

  playButton.addEventListener('click', start);

  addEventListener('keydown', (e) => {
    if (state !== 'playing') return;
    if (e.key === 'Escape') return pause();
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    if (!['ArrowLeft', 'ArrowRight', ' ', 'a', 'd'].includes(key)) return;
    // The space bar and arrows would otherwise scroll the page out from under the game.
    e.preventDefault();
    held.add(key);
  });
  addEventListener('keyup', (e) => held.delete(e.key.length === 1 ? e.key.toLowerCase() : e.key));
  addEventListener('blur', pause);

  canvas.addEventListener('pointermove', (e) => {
    if (state !== 'playing') return;
    shipX = e.clientX - canvas.getBoundingClientRect().left;
  });
  canvas.addEventListener('pointerdown', (e) => {
    if (state !== 'playing') return;
    shipX = e.clientX - canvas.getBoundingClientRect().left;
    if (e.pointerType === 'mouse') {
      if (cooldown <= 0) held.add(' ');
      setTimeout(() => held.delete(' '), 60);
    } else {
      // A finger on the screen keeps the can spraying.
      auto = true;
      canvas.setPointerCapture(e.pointerId);
    }
  });
  const release = () => (auto = false);
  canvas.addEventListener('pointerup', release);
  canvas.addEventListener('pointercancel', release);

  new ResizeObserver(resize).observe(canvas);
  resize();
</script>
