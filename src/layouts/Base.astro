---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource-variable/literata';
import '../styles/global.css';
import { site, sections, type Place } from '../site';

interface Props {
  title?: string;
  description?: string;
  place?: Place;
  street?: boolean;
}

const { title, description = site.intro, place, street = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const bodyClass = [place && `at-${place}`, street && 'is-street'].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <noscript><style>.scene{overflow-x:auto}</style></noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>{site.name}</a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a></li>
          {
            sections.map((s) => (
              <li>
                <a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    {place && <div class="slats strip" aria-hidden="true" />}
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>
        {site.name}, {new Date().getFullYear()}
      </span>
      <ul>
        {site.links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </footer>
  </body>
</html>
