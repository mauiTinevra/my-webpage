---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource-variable/literata';
import '../styles/global.css';
import { site, sections, type Place } from '../site';

interface Props {
  title?: string;
  description?: string;
  place?: Place;
  street?: boolean;
}

const { title, description = site.description, place, street = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og.png', Astro.site);
// Tells search engines who this is and what he offers.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site,
  email: `mailto:${site.email}`,
  jobTitle: 'Web designer and developer',
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Scottsdale', addressRegion: 'AZ', addressCountry: 'US' },
  knowsAbout: ['Web design', 'Web development', 'Interactive design', 'Illustration'],
  sameAs: site.links.map((l) => l.href),
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'Custom website design and development',
      areaServed: ['Scottsdale, AZ', 'Phoenix, AZ', 'Arizona'],
      url: new URL('/web-design', Astro.site),
    },
  },
};
const bodyClass = [place && `at-${place}`, street && 'is-street'].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <noscript><style>.scene{overflow-x:auto}</style></noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>{site.name}</a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a></li>
          {
            sections.map((s) => (
              <li>
                <a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="cta" href={`mailto:${site.email}?subject=${encodeURIComponent('I want a website')}`}>Start a project</a>
    </header>
    {place && <div class="slats strip" aria-hidden="true" />}
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>
        {site.name}, {new Date().getFullYear()}
      </span>
      <ul>
        <li>
          <a href="/web-design">Website design</a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>Email</a>
        </li>
        {site.links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </footer>
  </body>
</html>
