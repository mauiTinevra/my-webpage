---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource-variable/geist/wght.css';
import '../styles/global.css';
import { site, type Place } from '../site';
import Doodle from '../components/Doodle.astro';

interface Props {
  title?: string;
  description?: string;
  place?: Place;
  street?: boolean;
  /** Full-bleed pages: sections set their own padding. */
  bare?: boolean;
  /** Keep a thin or empty page out of search results. */
  noindex?: boolean;
  /** Extra structured data for this page (for example its questions and answers). */
  schema?: Record<string, unknown>;
}

const { title, description = site.description, place, street = false, bare = false, noindex = false, schema } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og.png', Astro.site);
// Tells search engines who this is and what he offers.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site,
  email: `mailto:${site.email}`,
  jobTitle: 'Web designer and developer',
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Scottsdale', addressRegion: 'AZ', addressCountry: 'US' },
  knowsAbout: ['Web design', 'Web development', 'Interactive design', 'Illustration'],
  sameAs: site.links.map((l) => l.href),
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'Custom website design and development',
      areaServed: ['Scottsdale, AZ', 'Phoenix, AZ', 'Arizona'],
      url: new URL('/web-design', Astro.site),
    },
  },
};
// The business, for local search: what it is, where it works and what it costs to start.
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#business', Astro.site),
  name: `${site.name}, web design`,
  url: Astro.site,
  image: shareImage,
  email: `mailto:${site.email}`,
  description: site.description,
  founder: { '@type': 'Person', name: site.name },
  address: { '@type': 'PostalAddress', addressLocality: 'Scottsdale', addressRegion: 'AZ', addressCountry: 'US' },
  areaServed: ['Scottsdale', 'Phoenix', 'Tempe', 'Mesa', 'Paradise Valley', 'Arizona'].map((name) => ({ '@type': 'Place', name })),
  priceRange: 'Websites from $3,500',
  knowsAbout: ['Website design', 'Web development', 'Restaurant websites', 'Yoga studio websites', 'Small business websites', 'Online booking and ordering'],
  sameAs: site.links.map((l) => l.href),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Website services',
    itemListElement: [
      { name: 'Custom website design and development', price: '3500', note: 'Starting price. Two to three weeks.' },
      { name: 'Website care plan', price: '150', note: 'Starting price per month. Updates, hosting and security.' },
    ].map((o) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: o.name, description: o.note },
      priceSpecification: { '@type': 'PriceSpecification', price: o.price, priceCurrency: 'USD', minPrice: o.price },
    })),
  },
};
// What a visitor came for, in the order they look for it.
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/web-design', label: 'Services' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
const bodyClass = [place && `at-${place}`, street && 'is-street', bare && 'is-bare', !street && 'is-bold', !street && path === '/' && 'is-home'].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <noscript><style>.scene{overflow-x:auto}</style></noscript>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>
        {!street && <img class="wordmark-mark" src="/favicon.svg" alt="" width="36" height="36" />}
        <span class="wordmark-name">{site.name}</span>
      </a>
      {
        !street && (
          <button type="button" class="clock" id="clock" aria-haspopup="dialog" aria-controls="here-sheet">
            <Doodle name="cactus" size="1.6em" class="clock-cactus" />
            <span class="clock-time" id="clock-time">Scottsdale, AZ</span>
          </button>
        )
      }
      <nav aria-label="Sections">
        <ul>
          {
            nav.map((n) => (
              <li>
                <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="cta" href="/#contact">Start a project</a>
    </header>
    {place && <div class="slats strip" aria-hidden="true" />}
    <main id="main">
      <slot />
    </main>
    {
      !street && (
        <dialog class="sheet" id="here-sheet" aria-labelledby="sheet-title">
          <div class="sheet-grip" aria-hidden="true" />
          <Doodle name="cactus" size="3.25rem" class="sheet-cactus" />
          <h2 class="sheet-title" id="sheet-title">Scottsdale, Arizona</h2>
          <p class="sheet-now" id="sheet-now">Right now in Scottsdale.</p>
          <p class="sheet-line">
            I work from here, meet clients around Scottsdale and Phoenix, and work with anyone else over video calls. I answer
            within a day.
          </p>
          <div class="sheet-actions">
            <a class="btn btn-dark" href="/#contact">Start a project</a>
            <button type="button" class="btn" id="sheet-close">Close</button>
          </div>
        </dialog>
      )
    }
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-about">
          <p class="footer-name">{site.name}</p>
          <p>{site.offer}</p>
          <p>Scottsdale, Arizona</p>
        </div>
        <nav aria-label="Work">
          <h2>Work</h2>
          <ul>
            <li><a href="/work#dos-gatos-books">Dos Gatos Books</a></li>
            <li><a href="/work#ocotillo-records">Ocotillo Records</a></li>
            <li><a href="/work#this-site">This site</a></li>
            <li><a href="/work">All work</a></li>
          </ul>
        </nav>
        <nav aria-label="Services">
          <h2>Services</h2>
          <ul>
            <li><a href="/web-design">Website design and pricing</a></li>
            <li><a href="/#contact">Start a project</a></li>
          </ul>
        </nav>
        <nav aria-label="About">
          <h2>About</h2>
          <ul>
            <li><a href="/#about">About me</a></li>
            <li><a href="/art">Art</a></li>
            <li><a href="/journal">Journal</a></li>
            <li><a href="/street">Interactive site</a></li>
          </ul>
        </nav>
        <nav aria-label="Elsewhere">
          <h2>Elsewhere</h2>
          <ul>
            <li><a href={`mailto:${site.email}`}>Email</a></li>
            {site.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <p class="footer-legal">{site.name}, {new Date().getFullYear()}. Designed and built by hand.</p>
    </footer>
<script>
  import { nowAt, nextSun, formatHour } from '../lib/sky';
  import { here } from '../site';

  const header = document.querySelector<HTMLElement>('.site-header');
  const clock = document.getElementById('clock');
  const sheet = document.getElementById('here-sheet') as HTMLDialogElement | null;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The local time in the header, and the same with the sunset in the sheet.
  if (clock && sheet) {
    const tell = () => {
      const now = nowAt(here);
      const t = formatHour(now.hour);
      const sun = nextSun(now.hour, now.day, here, now.offset);
      const h = Math.floor(sun.in);
      const m = Math.round((sun.in - h) * 60);
      document.getElementById('clock-time')!.innerHTML = `${t.time} ${t.half}<span class="clock-where"> in Scottsdale</span>`;
      document.getElementById('sheet-now')!.textContent =
        `It\u2019s ${t.time} ${t.half} here. ${sun.event} in ${h ? `${h} h ${m} min` : `${m} min`}.`;
    };
    tell();
    setInterval(tell, 30_000);

    // Tapping the cactus makes it wiggle, then opens the sheet.
    clock.addEventListener('click', () => {
      if (!calm) {
        clock.classList.remove('is-wiggling');
        void clock.offsetWidth;
        clock.classList.add('is-wiggling');
      }
      window.setTimeout(() => sheet.showModal(), calm ? 0 : 260);
    });
    const close = () => {
      if (calm) return sheet.close();
      sheet.classList.add('is-closing');
      window.setTimeout(() => {
        sheet.classList.remove('is-closing');
        sheet.close();
      }, 220);
    };
    document.getElementById('sheet-close')!.addEventListener('click', close);
    sheet.addEventListener('click', (e) => {
      if (e.target === sheet) close();
    });
    sheet.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    sheet.querySelector('a')!.addEventListener('click', () => sheet.close());
  }

  // The header slides away while you scroll down and comes back when you scroll up. It stays put
  // near the top of the page, while it holds keyboard focus, and on the street, which runs its own.
  if (header && document.body.classList.contains('is-bold')) {
    let last = scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = scrollY;
      const down = y > last + 4;
      const up = y < last - 4;
      if (y < header.offsetHeight + 40 || header.querySelector(':focus-visible') || sheet?.open) header.classList.remove('is-hidden');
      else if (down) header.classList.add('is-hidden');
      else if (up) header.classList.remove('is-hidden');
      if (down || up) last = y;
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    header.addEventListener('focusin', () => {
      if (header.querySelector(':focus-visible')) header.classList.remove('is-hidden');
    });
  }
</script>
  </body>
</html>
