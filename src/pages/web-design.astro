---
// Services & pricing, in plain words: what a client gets, what it costs, how it goes, how to start.
import Base from '../layouts/Base.astro';
import { site } from '../site';

const steps = [
  { name: 'We talk', what: 'A call about who you are, what you make, and what the site needs to do for your visitors.' },
  { name: 'I sketch', what: 'Before any code, you see the design: the pages, the colors, the one moment that makes it yours.' },
  { name: 'I build', what: 'Designed and coded by hand, tested on phones and desktops. You review it as it comes together.' },
  { name: 'It goes live', what: 'Launched on your domain and handed over, with a walkthrough of how to update it.' },
];

// Who this is for, with a real example of each from the work.
const kinds: { name: string; what: string; href?: string; see?: string }[] = [
  { name: 'Restaurants and cafes', what: 'Hours, the menu and ordering first, so a hungry visitor can order in a minute.', href: '/work#el-unico', see: 'El Único Taquería' },
  { name: 'Yoga and fitness studios', what: 'A schedule that opens on today, class descriptions and a first-week offer.', href: '/work#saguaro', see: 'Saguaro Yoga Club' },
  { name: 'Barbers and salons', what: 'Who is free right now, and a booking that takes four taps.' },
  { name: 'Shops and florists', what: 'What came in this week, and a way to order or hold something before driving over.' },
  { name: 'Classes and workshops', what: 'Dates, prices and a seat to book, with something to try on the page.' },
  { name: 'Tours and guides', what: 'Whether today is a good day to go, and a seat to book.' },
];
// Questions clients ask. The answers repeat what is promised elsewhere on this page.
const faq = [
  { q: 'How much does a custom website cost?', a: 'Websites start at $3,500. That covers a design made for you, the build, and launch on your domain. Interactive extras such as ordering, booking or a live schedule are quoted per idea before any work starts.' },
  { q: 'How long does it take?', a: 'Two to three weeks from the first call to launch for a typical site. Larger sites or extra interactive parts can take longer, and you get a date before we start.' },
  { q: 'Do you only work with businesses in Scottsdale?', a: 'No. I am based in Scottsdale and often meet clients around Scottsdale and Phoenix, and I work with clients anywhere else over video calls.' },
  { q: 'Can I update the site myself after launch?', a: 'Yes. The site is handed over to you with a walkthrough of how to update it. If you would rather not, the care plan covers text and photo updates for you.' },
  { q: 'What does the care plan include?', a: 'From $150 a month: text and photo updates, hosting, domain and security kept current, and a small change each month. You can cancel anytime.' },
  { q: 'Who will I be working with?', a: 'Me, Maui, directly, from the first call to launch day. There is no account manager and no handoff.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  schema={faqSchema}
  title="Web design in Scottsdale, AZ: services and pricing"
  description="Custom websites from $3,500, designed and built by hand by Maui Tinevra in Scottsdale, Arizona. Two to three weeks from first call to launch. Care plans from $150 a month."
>
  <header class="page-head">
    <h1 class="rotulo">Web design in Scottsdale, Arizona</h1>
    <p>
      Services and pricing. One-of-a-kind websites for restaurants, studios, shops and small businesses in Scottsdale, Phoenix
      and beyond, from $3,500.
    </p>
  </header>

  <div class="prose">
    <h2>What it costs</h2>
    <ul>
      <li><strong>Website, from $3,500.</strong> A design made for you, built by hand, launched on your domain. Two to three weeks.</li>
      <li><strong>Interactive extras, quoted per idea.</strong> Ordering, booking, a live schedule, illustrations, or a signature moment like <a href="/work#el-unico">El Único’s turning trompo</a>.</li>
      <li><strong>Care plan, from $150 a month.</strong> Text and photo updates, hosting and security kept current, and a small change each month. Cancel anytime.</li>
    </ul>

    <h2>How it works</h2>
    <ol>
      {steps.map((s) => <li><strong>{s.name}.</strong> {s.what}</li>)}
    </ol>

    <h2>Who it’s for</h2>
    <p>
      Small businesses that want a website people remember, and that their customers can actually use. I work with clients in
      Scottsdale, Phoenix, Tempe and Mesa, and anywhere else over video calls.
    </p>
    <ul>
      {kinds.map((k) => (
        <li>
          <strong>{k.name}.</strong> {k.what}{k.href && <> See <a href={k.href}>{k.see}</a>.</>}
        </li>
      ))}
    </ul>

    <h2>See the work</h2>
    <p>
      <a href="/work">The case studies</a> show what each project needed and what I did about it, including a restaurant
      site I rebuilt after a design review.
    </p>

    <h2>Questions people ask</h2>
    {faq.map((f) => (
      <>
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </>
    ))}

    <h2>Start a project</h2>
    <p>
      Tell me who you are, what you make and when you’d like to launch: <a href={`mailto:${site.email}?subject=${encodeURIComponent('A website for me')}`}>{site.email}</a>.
      If your computer has no mail app set up, <a href="/#contact">copy the address here</a>, or send me a DM on <a href={site.links.find((l) => l.label === 'Instagram')?.href}>Instagram</a>.
    </p>
  </div>
</Base>
