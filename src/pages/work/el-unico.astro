---
// A concept site for an imaginary taquería, made to show what Maui could build for a restaurant.
// One taco, three aguas frescas, two desserts. Everything on the page is drawn in code.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/literata';
import { site } from '../../site';

const menu = {
  taco: { name: 'Taco al pastor', price: '$3.50' },
  drinks: [
    { key: 'horchata', name: 'Horchata', about: 'Rice, cinnamon, a little vanilla.', price: '$3', color: '#f3ead8', ice: '#fffaf0' },
    { key: 'jamaica', name: 'Jamaica', about: 'Hibiscus flowers, steeped cold.', price: '$3', color: '#a3123a', ice: '#e0507a' },
    { key: 'tamarindo', name: 'Tamarindo', about: 'Tamarind, sweet and sour.', price: '$3', color: '#8a5523', ice: '#c08850' },
  ],
  desserts: [
    { key: 'chocoflan', name: 'Chocoflan', about: 'Chocolate cake under a layer of flan, baked together.', price: '$5' },
    { key: 'tresleches', name: 'Tres leches', about: 'Sponge cake soaked in three milks.', price: '$5' },
  ],
};
// Open Tuesday to Sunday, 11 AM to 10 PM. Monday is for the trompo to rest.
const hours = { open: 11, close: 22, closedDay: 'Mon' };

// Toppings land in the same places every time.
let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const inTortilla = (count: number, radius: number) =>
  Array.from({ length: count }, () => {
    const a = rand() * Math.PI * 2;
    const r = Math.sqrt(rand()) * radius;
    return { x: +(Math.cos(a) * r).toFixed(1), y: +(Math.sin(a) * r).toFixed(1), turn: Math.round(rand() * 180) };
  });
const pastor = inTortilla(26, 78);
const pineapple = inTortilla(9, 70);
const onion = inTortilla(22, 82);
const cilantro = inTortilla(18, 84);
const mail = `mailto:${site.email}?subject=${encodeURIComponent('A website for my restaurant')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>El Único, a concept taquería site by {site.name}</title>
    <meta name="description" content={`A concept website for an imaginary taquería with one taco, designed and built by ${site.name}.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="unico" data-open={hours.open} data-close={hours.close} data-closed-day={hours.closedDay}>
    <p class="concept-bar">
      An imaginary taquería, built by <a href="/">{site.name}</a> to show what a restaurant site could be.
    </p>

    <header class="hero">
      <div class="hero-words">
        <p class="neon" id="neon" aria-live="polite"><span id="neon-word">Abierto</span></p>
        <h1 class="sign">El Único</h1>
        <p class="sign-sub">Taquería</p>
        <p class="hero-line">
          We make one taco. Al pastor, cut from the trompo, with pineapple off the top.
        </p>
        <p class="status" id="status">Open now</p>
      </div>
      <div class="trompo" aria-hidden="true">
        <svg viewBox="0 0 260 420">
          <defs>
            <clipPath id="meat"><path d="M70 120 Q60 230 90 330 H170 Q200 230 190 120 Z" /></clipPath>
            <radialGradient id="heat" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#ffb347" stop-opacity="0.9" />
              <stop offset="1" stop-color="#ff6a2a" stop-opacity="0" />
            </radialGradient>
          </defs>
          <ellipse class="heat" cx="215" cy="225" rx="70" ry="150" fill="url(#heat)" />
          <rect x="226" y="90" width="22" height="270" rx="6" fill="#3b3b44" stroke="#121a3a" stroke-width="5" />
          <g fill="#ff8a2a"><rect x="230" y="110" width="14" height="40" rx="3" /><rect x="230" y="170" width="14" height="40" rx="3" /><rect x="230" y="230" width="14" height="40" rx="3" /><rect x="230" y="290" width="14" height="40" rx="3" /></g>
          <rect x="125" y="40" width="10" height="350" fill="#9aa0a8" stroke="#121a3a" stroke-width="4" />
          <g clip-path="url(#meat)">
            <rect x="40" y="110" width="200" height="230" fill="#b8411f" />
            <g class="trompo-turn">
              {Array.from({ length: 14 }, (_, i) => (
                <rect x={30 + i * 22} y="110" width="11" height="230" fill={i % 2 ? '#d2632a' : '#8f2e15'} opacity="0.75" />
              ))}
            </g>
            {Array.from({ length: 9 }, (_, i) => (
              <path d={`M40 ${132 + i * 23} Q130 ${140 + i * 23} 230 ${132 + i * 23}`} fill="none" stroke="#6e200d" stroke-width="3" opacity="0.55" />
            ))}
          </g>
          <path d="M70 120 Q60 230 90 330 H170 Q200 230 190 120 Z" fill="none" stroke="#121a3a" stroke-width="5" />
          <ellipse cx="130" cy="120" rx="60" ry="12" fill="#c9532a" stroke="#121a3a" stroke-width="5" />
          <!-- The pineapple on top. -->
          <g class="pina">
            <path d="M112 72 L104 40 L120 60 L130 30 L140 60 L156 40 L148 72 Z" fill="#2f8f4e" stroke="#121a3a" stroke-width="4" stroke-linejoin="round" />
            <ellipse cx="130" cy="96" rx="34" ry="26" fill="#f2cb3a" stroke="#121a3a" stroke-width="5" />
            <path d="M104 88 L156 104 M104 104 L156 88 M118 74 L118 118 M142 74 L142 118" stroke="#c99a1e" stroke-width="3" />
          </g>
          <ellipse cx="130" cy="335" rx="48" ry="9" fill="#9aa0a8" stroke="#121a3a" stroke-width="4" />
          <rect x="70" y="388" width="120" height="16" rx="4" fill="#3b3b44" stroke="#121a3a" stroke-width="4" />
        </svg>
      </div>
    </header>

    <main>
      <section class="block taco-block" aria-labelledby="taco-title">
        <div class="block-words">
          <h2 class="block-title" id="taco-title">The taco</h2>
          <p class="block-line">There is only one. Build it the way we do, in order.</p>
          <ol class="steps" role="list">
            <li><button type="button" class="step" data-layer="pastor">Shave the pastor</button></li>
            <li><button type="button" class="step" data-layer="pineapple">Flick the pineapple</button></li>
            <li><button type="button" class="step" data-layer="onion">Onion and cilantro</button></li>
            <li><button type="button" class="step" data-layer="salsa">Salsa verde</button></li>
          </ol>
          <p class="price-line" id="taco-done" hidden>
            That's the taco. <b>{menu.taco.name}, {menu.taco.price}</b>.
            <button type="button" class="again" id="taco-again">Make another</button>
          </p>
        </div>
        <div class="plate" aria-hidden="true">
          <svg viewBox="-130 -130 260 260">
            <circle r="122" fill="#fbfaf6" stroke="#121a3a" stroke-width="5" />
            <circle r="108" fill="none" stroke="#1f3fcf" stroke-width="5" stroke-dasharray="14 9" />
            <circle r="92" fill="#f2d9a0" stroke="#121a3a" stroke-width="4" />
            <g fill="#c9a060" opacity="0.6">
              <circle cx="-40" cy="-30" r="6" /><circle cx="30" cy="40" r="5" /><circle cx="50" cy="-45" r="4" /><circle cx="-55" cy="35" r="5" /><circle cx="5" cy="-60" r="3" />
            </g>
            <g class="layer" data-for="pastor">
              {pastor.map((p) => (
                <rect x={p.x - 9} y={p.y - 6} width="18" height="12" rx="4" fill="#b8411f" stroke="#6e200d" stroke-width="2" transform={`rotate(${p.turn} ${p.x} ${p.y})`} />
              ))}
            </g>
            <g class="layer" data-for="pineapple">
              {pineapple.map((p) => (
                <rect x={p.x - 6} y={p.y - 6} width="12" height="12" rx="2" fill="#f2cb3a" stroke="#c99a1e" stroke-width="2" transform={`rotate(${p.turn} ${p.x} ${p.y})`} />
              ))}
            </g>
            <g class="layer" data-for="onion">
              {onion.map((p) => (
                <rect x={p.x - 3} y={p.y - 3} width="6" height="6" fill="#fbfaf6" stroke="#d8d2c4" stroke-width="1" />
              ))}
              {cilantro.map((p) => (
                <ellipse cx={p.x} cy={p.y} rx="5" ry="3" fill="#2f8f4e" transform={`rotate(${p.turn} ${p.x} ${p.y})`} />
              ))}
            </g>
            <g class="layer" data-for="salsa">
              <path d="M-70 -20 C-40 -60 -10 20 20 -20 S60 10 75 -15 M-60 30 C-30 0 0 60 30 25 S60 50 70 30" fill="none" stroke="#5aa832" stroke-width="7" stroke-linecap="round" opacity="0.9" />
            </g>
          </svg>
        </div>
      </section>

      <section class="block drinks-block" aria-labelledby="drinks-title">
        <div class="block-words">
          <h2 class="block-title" id="drinks-title">Three aguas frescas</h2>
          <p class="block-line">Tap a jar to pour a glass.</p>
        </div>
        <div class="jars">
          {
            menu.drinks.map((d) => (
              <div class="jar-spot">
                <button type="button" class="jar" data-drink={d.key} aria-label={`Pour a glass of ${d.name}`}>
                  <svg viewBox="0 0 140 220" aria-hidden="true">
                    <rect x="20" y="30" width="100" height="160" rx="22" fill="#e8f4fa" stroke="#121a3a" stroke-width="5" />
                    <rect x="27" y="62" width="86" height="121" rx="16" fill={d.color} />
                    <g fill={d.ice} opacity="0.85">
                      <rect x="40" y="70" width="16" height="14" rx="3" transform="rotate(-12 48 77)" />
                      <rect x="70" y="80" width="16" height="14" rx="3" transform="rotate(14 78 87)" />
                      <rect x="52" y="100" width="14" height="12" rx="3" />
                    </g>
                    <rect x="16" y="20" width="108" height="16" rx="5" fill="#fbfaf6" stroke="#121a3a" stroke-width="5" />
                    <path d="M95 10 V70" stroke="#121a3a" stroke-width="5" />
                    <ellipse cx="95" cy="74" rx="12" ry="6" fill="#9aa0a8" stroke="#121a3a" stroke-width="4" />
                  </svg>
                </button>
                <div class="glass" aria-hidden="true">
                  <svg viewBox="0 0 70 100">
                    <defs>
                      <clipPath id={`glass-${d.key}`}><path d="M10 8 L18 92 H52 L60 8 Z" /></clipPath>
                    </defs>
                    <g clip-path={`url(#glass-${d.key})`}>
                      <rect class="pour" x="0" y="8" width="70" height="84" fill={d.color} />
                    </g>
                    <path d="M10 8 L18 92 H52 L60 8 Z" fill="none" stroke="#121a3a" stroke-width="4" stroke-linejoin="round" />
                  </svg>
                </div>
                <h3 class="item-name">{d.name}</h3>
                <p class="item-about">{d.about}</p>
                <p class="item-price">{d.price}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="block desserts-block" aria-labelledby="desserts-title">
        <div class="block-words">
          <h2 class="block-title" id="desserts-title">Two desserts</h2>
          <p class="block-line">Tap a slice to take a bite.</p>
        </div>
        <div class="slices">
          {
            menu.desserts.map((d) => (
              <div class="slice-spot">
                <button type="button" class="slice" data-dessert={d.key} aria-label={`Take a bite of the ${d.name}`}>
                  <svg viewBox="0 0 240 170" aria-hidden="true">
                    <defs>
                      <mask id={`bites-${d.key}`}>
                        <rect x="0" y="0" width="240" height="170" fill="#fff" />
                        <g class="bites" fill="#000" />
                      </mask>
                    </defs>
                    <ellipse cx="120" cy="150" rx="112" ry="16" fill="#fbfaf6" stroke="#121a3a" stroke-width="4" />
                    <g mask={`url(#bites-${d.key})`}>
                      {d.key === 'chocoflan' ? (
                        <g stroke="#121a3a" stroke-width="4" stroke-linejoin="round">
                          <path d="M30 140 L210 140 L210 96 L30 96 Z" fill="#4a2414" />
                          <path d="M30 96 L210 96 L210 58 L30 58 Z" fill="#f2c14e" />
                          <path d="M30 58 L210 58 L210 46 L30 46 Z" fill="#8a4a12" />
                          <path d="M60 58 q6 16 0 24 M130 58 q5 12 0 18 M180 58 q6 18 0 26" fill="none" stroke="#8a4a12" stroke-width="6" stroke-linecap="round" />
                        </g>
                      ) : (
                        <g stroke="#121a3a" stroke-width="4" stroke-linejoin="round">
                          <path d="M30 140 L210 140 L210 70 L30 70 Z" fill="#f6e2b0" />
                          <path d="M30 70 L210 70 L210 44 L30 44 Z" fill="#fffaf0" />
                          <g fill="#c98f5f" stroke="none">
                            <circle cx="70" cy="56" r="2.5" /><circle cx="110" cy="52" r="2" /><circle cx="150" cy="58" r="2.5" /><circle cx="185" cy="52" r="2" />
                          </g>
                          <path d="M30 120 H210" stroke="#e8c98a" stroke-width="3" />
                          <circle cx="160" cy="36" r="10" fill="#c8102e" />
                        </g>
                      )}
                    </g>
                  </svg>
                </button>
                <h3 class="item-name">{d.name}</h3>
                <p class="item-about">{d.about}</p>
                <p class="item-price">{d.price}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="block visit-block" aria-labelledby="visit-title">
        <div class="block-words">
          <h2 class="block-title" id="visit-title">Come by</h2>
          <p class="block-line">
            Tuesday to Sunday, 11 AM to 10 PM. Closed Mondays. Scottsdale, Arizona.
          </p>
          <p class="block-line small">
            The neon and the lights follow our real hours, in Scottsdale time. After closing, the whole site goes dark.
          </p>
          <button type="button" class="again" id="after-hours">See it after closing</button>
        </div>
      </section>
    </main>

    <footer class="concept-foot">
      <p>
        El Único is imaginary. This site is a concept by {site.name}: one taco, drawn, built and coded by hand.
      </p>
      <a class="foot-ask" href={mail}>I want a site like this for my restaurant</a>
      <a class="foot-back" href="/">Back to {site.name}</a>
    </footer>

    <div class="lights-out" aria-hidden="true"></div>
  </body>
</html>

<script>
  import { nowAt, formatHour } from '../../lib/sky';
  import { here } from '../../site';

  const { dataset } = document.body;
  const hours = { open: Number(dataset.open), close: Number(dataset.close), closedDay: dataset.closedDay! };
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = (id: string) => document.getElementById(id)!;

  // Open or closed, by the clock in Scottsdale. The neon and the lights follow.
  let forced: boolean | null = null;
  const say = (h: number) => {
    const c = formatHour(h);
    return `${c.time.replace(':00', '')} ${c.half}`;
  };
  const update = () => {
    const now = nowAt(here);
    const weekday = new Intl.DateTimeFormat('en-US', { timeZone: here.timeZone, weekday: 'short' }).format(new Date());
    const openDay = weekday !== hours.closedDay;
    const realOpen = openDay && now.hour >= hours.open && now.hour < hours.close;
    const open = forced ?? realOpen;
    document.body.classList.toggle('is-closed', !open);
    el('neon-word').textContent = open ? 'Abierto' : 'Cerrado';
    if (forced === false) el('status').textContent = 'This is how the site looks after closing.';
    else if (open) el('status').textContent = `Open now. We close at ${say(hours.close)}.`;
    else if (openDay && now.hour < hours.open) el('status').textContent = `Closed. We open today at ${say(hours.open)}.`;
    else el('status').textContent = `Closed. We open at ${say(hours.open)}${weekday === 'Sun' && !openDay ? ' on Tuesday' : ''}.`;
  };
  update();
  setInterval(update, 30_000);
  const afterHours = el('after-hours');
  afterHours.addEventListener('click', () => {
    forced = forced === false ? null : false;
    afterHours.textContent = forced === false ? 'Back to our real hours' : 'See it after closing';
    update();
  });

  // The taco: each step adds its layer, in order.
  const steps = [...document.querySelectorAll<HTMLButtonElement>('.step')];
  const done = el('taco-done');
  const reset = () => {
    document.querySelectorAll('.layer').forEach((layer) => layer.classList.remove('is-on'));
    steps.forEach((step, i) => {
      step.disabled = i !== 0;
      step.classList.remove('is-done');
    });
    done.hidden = true;
  };
  steps.forEach((step, i) =>
    step.addEventListener('click', () => {
      document.querySelector(`.layer[data-for="${step.dataset.layer}"]`)!.classList.add('is-on');
      step.classList.add('is-done');
      step.disabled = true;
      if (steps[i + 1]) {
        steps[i + 1].disabled = false;
        steps[i + 1].focus();
      } else {
        done.hidden = false;
        el('taco-again').focus();
      }
    }),
  );
  el('taco-again').addEventListener('click', () => {
    reset();
    steps[0].focus();
  });
  reset();

  // The jars pour a glass each.
  document.querySelectorAll<HTMLButtonElement>('.jar').forEach((jar) => {
    const glass = jar.parentElement!.querySelector('.glass')!;
    jar.addEventListener('click', () => {
      glass.classList.remove('is-full');
      void (glass as HTMLElement).offsetWidth;
      glass.classList.add('is-full');
    });
  });

  // The desserts lose a bite each tap, then come back.
  document.querySelectorAll<HTMLButtonElement>('.slice').forEach((slice) => {
    const bites = slice.querySelector('.bites')!;
    const marks = [
      [212, 70],
      [205, 120],
      [180, 92],
      [150, 70],
      [140, 125],
      [110, 92],
      [80, 70],
      [70, 125],
      [40, 95],
    ];
    let taken = 0;
    slice.addEventListener('click', () => {
      if (taken >= marks.length) {
        bites.innerHTML = '';
        taken = 0;
        slice.setAttribute('aria-label', slice.getAttribute('aria-label')!.replace('Get another', 'Take a bite of the'));
        return;
      }
      const [x, y] = marks[taken++];
      const bite = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      bite.setAttribute('cx', String(x + (calm ? 0 : Math.random() * 8 - 4)));
      bite.setAttribute('cy', String(y));
      bite.setAttribute('r', '30');
      bites.append(bite);
      if (taken >= marks.length) slice.setAttribute('aria-label', slice.getAttribute('aria-label')!.replace('Take a bite of the', 'Get another'));
    });
  });
</script>

<style is:global>
  .unico {
    --ink: #121a3a;
    --cream: #fbf4e4;
    --pink: #f0508f;
    --orange: #f07a1e;
    --green: #2f8f4e;
    --cobalt: #1f3fcf;
    --yellow: #f2cb3a;
    --display: 'Archivo Variable', 'Arial Black', system-ui, sans-serif;
    --reading: 'Literata Variable', Georgia, serif;
    --edge: clamp(1.25rem, 5vw, 4rem);
    margin: 0;
    color: var(--ink);
    font-family: var(--reading);
    font-size: 1.1rem;
    line-height: 1.55;
    /* A white tiled wall with a talavera band along the top of each section. */
    background:
      linear-gradient(90deg, rgb(18 26 58 / 0.09) 1.5px, transparent 1.5px) 0 0 / 4rem 4rem,
      linear-gradient(rgb(18 26 58 / 0.09) 1.5px, transparent 1.5px) 0 0 / 4rem 4rem,
      #fbfaf6;
    transition: background-color 0.6s;
  }
  .unico *, .unico *::before, .unico *::after { box-sizing: border-box; }
  .unico a { color: inherit; text-underline-offset: 0.2em; }
  .unico :focus-visible { outline: 3px solid var(--cobalt); outline-offset: 3px; }

  .concept-bar {
    margin: 0;
    padding: 0.55rem var(--edge);
    background: var(--ink);
    color: var(--cream);
    font-family: var(--display);
    font-size: 0.85rem;
    text-align: center;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 2rem;
    min-height: calc(100vh - 2.4rem);
    min-height: calc(100dvh - 2.4rem);
    padding: 2rem var(--edge) 3rem;
  }
  .sign {
    margin: 0.5rem 0 0;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(3.5rem, 11vw, 9rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--pink);
    text-transform: uppercase;
    text-shadow: 0.04em 0.04em 0 var(--ink), 0.08em 0.08em 0 var(--orange);
  }
  .sign-sub {
    margin: 0.6rem 0 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--green);
  }
  .hero-line { max-width: 30rem; margin: 1.5rem 0 0; font-size: clamp(1.15rem, 2.2vw, 1.45rem); line-height: 1.45; }
  .status { margin: 1rem 0 0; font-family: var(--display); font-weight: 700; }

  /* Neon in the window: open or closed. */
  .neon {
    display: inline-block;
    margin: 0;
    padding: 0.25rem 0.9rem 0.35rem;
    border: 3px solid var(--ink);
    border-radius: 0.6rem;
    background: #1b1147;
    font-family: var(--reading);
    font-style: italic;
    font-weight: 700;
    font-size: 1.4rem;
    color: #7cf7d4;
    text-shadow: 0 0 6px #3fe8b8, 0 0 16px #3fe8b8;
  }
  .is-closed .neon { color: #ff7aa8; text-shadow: 0 0 6px #ff3d7f, 0 0 18px #ff3d7f; }

  .trompo svg { display: block; width: 100%; max-height: 72vh; }
  @media (prefers-reduced-motion: no-preference) {
    .trompo-turn { animation: turn 3.2s linear infinite; }
    .heat { animation: heat 2.4s ease-in-out infinite alternate; }
    @keyframes turn { to { transform: translateX(-44px); } }
    @keyframes heat { to { opacity: 0.55; } }
  }

  .block {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(3.5rem, 10vh, 6rem) var(--edge);
    border-top: 0.9rem solid transparent;
    border-image: repeating-linear-gradient(90deg, var(--cobalt) 0 1.2rem, var(--yellow) 1.2rem 1.6rem, var(--cobalt) 1.6rem 2.8rem, #fbfaf6 2.8rem 3.2rem) 1;
  }
  .drinks-block, .desserts-block { grid-template-columns: 1fr; }
  .block-title {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 112%;
