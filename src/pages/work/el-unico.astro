---
// A concept site for an imaginary taquería, made to show what Maui could build for a restaurant.
// One taco, three aguas frescas, two desserts. Everything on the page is drawn in code.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/literata';
import { site } from '../../site';

const menu = {
  taco: { name: 'Taco al pastor', price: '$3.50' },
  drinks: [
    { key: 'horchata', name: 'Horchata', about: 'Rice, cinnamon, a little vanilla.', price: '$3', color: '#f3ead8', ice: '#fffaf0' },
    { key: 'jamaica', name: 'Jamaica', about: 'Hibiscus flowers, steeped cold.', price: '$3', color: '#a3123a', ice: '#e0507a' },
    { key: 'tamarindo', name: 'Tamarindo', about: 'Tamarind, sweet and sour.', price: '$3', color: '#8a5523', ice: '#c08850' },
  ],
  desserts: [
    { key: 'chocoflan', name: 'Chocoflan', about: 'Chocolate cake under a layer of flan, baked together.', price: '$5' },
    { key: 'tresleches', name: 'Tres leches', about: 'Sponge cake soaked in three milks.', price: '$5' },
  ],
};
// Open Tuesday to Sunday, 11 AM to 10 PM. Monday is for the trompo to rest.
const hours = { open: 11, close: 22, closedDay: 'Mon' };
// Days that differ from the usual hours. A closing hour of 0 means closed all day.
const specialDays = [
  { date: '2026-11-26', close: 0, note: 'Closed for Thanksgiving' },
  { date: '2026-12-24', close: 16, note: 'Christmas Eve: open until 4 PM' },
  { date: '2026-12-25', close: 0, note: 'Closed for Christmas' },
  { date: '2026-12-31', close: 18, note: "New Year's Eve: open until 6 PM" },
  { date: '2027-01-01', close: 0, note: "Closed for New Year's Day" },
];
// Imaginary, so the details are too: 555-01xx numbers are reserved for fiction, and .example
// addresses never deliver anywhere.
const visit = {
  place: 'Inside Scottsdale Fashion Square',
  street: '7014 E Camelback Rd',
  city: 'Scottsdale, AZ 85251',
  phone: '(480) 555-0199',
  tel: '+14805550199',
  email: 'hola@elunico.example',
  directions: 'https://www.google.com/maps/search/?api=1&query=Scottsdale+Fashion+Square+7014+E+Camelback+Rd+Scottsdale+AZ',
};
const contact = (subject: string) => `mailto:${visit.email}?subject=${encodeURIComponent(subject)}`;

// Toppings land in the same places every time.
let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const inTortilla = (count: number, radius: number) =>
  Array.from({ length: count }, () => {
    const a = rand() * Math.PI * 2;
    const r = Math.sqrt(rand()) * radius;
    return { x: +(Math.cos(a) * r).toFixed(1), y: +(Math.sin(a) * r).toFixed(1), turn: Math.round(rand() * 180) };
  });
// Three tacos to the order, overlapping a little on the plate.
const tacos = [
  { x: 0, y: -50 },
  { x: 43, y: 25 },
  { x: -43, y: 25 },
].map((spot) => ({
  ...spot,
  pastor: inTortilla(11, 34),
  pineapple: inTortilla(4, 30),
  onion: inTortilla(9, 36),
  cilantro: inTortilla(7, 37),
  turn: Math.round(rand() * 360),
}));
const mail = `mailto:${site.email}?subject=${encodeURIComponent('A website for my restaurant')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>El Único, a concept taquería site by {site.name}</title>
    <meta name="description" content={`A concept website for an imaginary taquería with one taco, designed and built by ${site.name}.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="unico" data-open={hours.open} data-close={hours.close} data-closed-day={hours.closedDay} data-special={JSON.stringify(specialDays)}>
    <p class="concept-bar">
      An imaginary taquería, built by <a href="/">{site.name}</a> to show what a restaurant site could be.
    </p>

    <header class="hero">
      <div class="hero-words">
        <p class="neon" id="neon" aria-live="polite"><span id="neon-word">Abierto</span></p>
        <h1 class="sign">El Único</h1>
        <p class="sign-sub">Taquería</p>
        <p class="hero-line">
          We make one taco. Al pastor, cut from the trompo, with pineapple off the top.
        </p>
        <p class="status" id="status">Open now</p>
      </div>
      <div class="trompo" aria-hidden="true">
        <svg viewBox="0 0 260 420">
          <defs>
            <clipPath id="meat"><path d="M70 120 Q60 230 90 330 H170 Q200 230 190 120 Z" /></clipPath>
            <radialGradient id="heat" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#ffb347" stop-opacity="0.9" />
              <stop offset="1" stop-color="#ff6a2a" stop-opacity="0" />
            </radialGradient>
          </defs>
          <ellipse class="heat" cx="215" cy="225" rx="70" ry="150" fill="url(#heat)" />
          <rect x="226" y="90" width="22" height="270" rx="6" fill="#3b3b44" stroke="#121a3a" stroke-width="5" />
          <g fill="#ff8a2a"><rect x="230" y="110" width="14" height="40" rx="3" /><rect x="230" y="170" width="14" height="40" rx="3" /><rect x="230" y="230" width="14" height="40" rx="3" /><rect x="230" y="290" width="14" height="40" rx="3" /></g>
          <rect x="125" y="40" width="10" height="350" fill="#9aa0a8" stroke="#121a3a" stroke-width="4" />
          <g clip-path="url(#meat)">
            <rect x="40" y="110" width="200" height="230" fill="#b8411f" />
            <g class="trompo-turn">
              {Array.from({ length: 14 }, (_, i) => (
                <rect x={30 + i * 22} y="110" width="11" height="230" fill={i % 2 ? '#d2632a' : '#8f2e15'} opacity="0.75" />
              ))}
            </g>
            {Array.from({ length: 9 }, (_, i) => (
              <path d={`M40 ${132 + i * 23} Q130 ${140 + i * 23} 230 ${132 + i * 23}`} fill="none" stroke="#6e200d" stroke-width="3" opacity="0.55" />
            ))}
          </g>
          <path d="M70 120 Q60 230 90 330 H170 Q200 230 190 120 Z" fill="none" stroke="#121a3a" stroke-width="5" />
          <ellipse cx="130" cy="120" rx="60" ry="12" fill="#c9532a" stroke="#121a3a" stroke-width="5" />
          <!-- The pineapple on top. -->
          <g class="pina">
            <path d="M112 72 L104 40 L120 60 L130 30 L140 60 L156 40 L148 72 Z" fill="#2f8f4e" stroke="#121a3a" stroke-width="4" stroke-linejoin="round" />
            <ellipse cx="130" cy="96" rx="34" ry="26" fill="#f2cb3a" stroke="#121a3a" stroke-width="5" />
            <path d="M104 88 L156 104 M104 104 L156 88 M118 74 L118 118 M142 74 L142 118" stroke="#c99a1e" stroke-width="3" />
          </g>
          <ellipse cx="130" cy="335" rx="48" ry="9" fill="#9aa0a8" stroke="#121a3a" stroke-width="4" />
          <rect x="70" y="388" width="120" height="16" rx="4" fill="#3b3b44" stroke="#121a3a" stroke-width="4" />
        </svg>
      </div>
    </header>

    <main>
      <section class="block story-block" aria-labelledby="story-title">
        <h2 class="visually-hidden" id="story-title">Why one taco</h2>
        <p class="story">
          Why only one taco? Because once you find the love of your life, you don't need many options.
        </p>
      </section>

      <section class="block taco-block" aria-labelledby="taco-title">
        <div class="block-words">
          <h2 class="block-title" id="taco-title">The taco</h2>
          <p class="block-line">There is only one, and it comes three to an order. Build them the way we do.</p>
          <ol class="steps" role="list">
            <li><button type="button" class="step" data-layer="pastor">Shave the pastor</button></li>
            <li><button type="button" class="step" data-layer="pineapple">Flick the pineapple</button></li>
            <li><button type="button" class="step" data-layer="onion">Onion and cilantro</button></li>
            <li><button type="button" class="step" data-layer="salsa">Salsa verde</button></li>
          </ol>
          <p class="price-line" id="taco-done" hidden>
            That's the taco. <b>{menu.taco.name}, {menu.taco.price} each</b>.
            <button type="button" class="again" id="taco-again">Make another</button>
          </p>
        </div>
        <div class="plate" aria-hidden="true">
          <svg viewBox="-130 -130 260 260">
            <circle r="122" fill="#fbfaf6" stroke="#121a3a" stroke-width="5" />
            <circle r="108" fill="none" stroke="#1f3fcf" stroke-width="5" stroke-dasharray="14 9" />
            <g class="plate-tacos">
              {tacos.map((t) => (
                <g transform={`translate(${t.x} ${t.y})`}>
                  <circle r="48" fill="#f2d9a0" stroke="#121a3a" stroke-width="4" />
                  <g fill="#c9a060" opacity="0.6" transform={`rotate(${t.turn})`}>
                    <circle cx="-20" cy="-14" r="4" /><circle cx="16" cy="20" r="3.5" /><circle cx="24" cy="-22" r="3" /><circle cx="-26" cy="18" r="3.5" />
                  </g>
                </g>
              ))}
              <g class="layer" data-for="pastor">
                {tacos.map((t) =>
                  t.pastor.map((p) => (
                    <rect x={t.x + p.x - 7} y={t.y + p.y - 5} width="14" height="10" rx="3.5" fill="#b8411f" stroke="#6e200d" stroke-width="1.8" transform={`rotate(${p.turn} ${t.x + p.x} ${t.y + p.y})`} />
                  )),
                )}
              </g>
              <g class="layer" data-for="pineapple">
                {tacos.map((t) =>
                  t.pineapple.map((p) => (
                    <rect x={t.x + p.x - 5} y={t.y + p.y - 5} width="10" height="10" rx="2" fill="#f2cb3a" stroke="#c99a1e" stroke-width="1.8" transform={`rotate(${p.turn} ${t.x + p.x} ${t.y + p.y})`} />
                  )),
                )}
              </g>
              <g class="layer" data-for="onion">
                {tacos.map((t) => [
                  ...t.onion.map((p) => <rect x={t.x + p.x - 2.5} y={t.y + p.y - 2.5} width="5" height="5" fill="#fbfaf6" stroke="#d8d2c4" stroke-width="0.8" />),
                  ...t.cilantro.map((p) => (
                    <ellipse cx={t.x + p.x} cy={t.y + p.y} rx="4" ry="2.4" fill="#2f8f4e" transform={`rotate(${p.turn} ${t.x + p.x} ${t.y + p.y})`} />
                  )),
                ])}
              </g>
              <g class="layer" data-for="salsa">
                {tacos.map((t) => (
                  <path
                    d={`M${t.x - 32} ${t.y - 6} C${t.x - 16} ${t.y - 26} ${t.x - 4} ${t.y + 10} ${t.x + 10} ${t.y - 8} S${t.x + 26} ${t.y + 6} ${t.x + 32} ${t.y - 4}`}
                    fill="none"
                    stroke="#5aa832"
                    stroke-width="5"
                    stroke-linecap="round"
                    opacity="0.9"
                  />
                ))}
              </g>
            </g>

            <!-- The finale: one taco lifts off the plate, folded and steaming. -->
            <g class="hero-taco">
              <g class="rays">
                {Array.from({ length: 16 }, (_, i) => (
                  <path d="M0 0 L-9 -150 L9 -150 Z" fill={i % 2 ? '#f2cb3a' : '#f0508f'} opacity="0.25" transform={`rotate(${i * 22.5})`} />
                ))}
              </g>
              <g class="steam" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round">
                <path d="M-30 -62 q-10 -16 0 -30 q10 -14 0 -28" />
                <path d="M2 -70 q-10 -16 0 -30 q10 -14 0 -28" />
                <path d="M34 -62 q-10 -16 0 -30 q10 -14 0 -28" />
              </g>
              <g class="taco-side" stroke="#121a3a" stroke-linejoin="round">
                <!-- The far side of the tortilla, just showing at both ends behind the filling. -->
                <path d="M-92 -22 Q-86 -58 -60 -50 L-60 -22 Z M92 -22 Q86 -58 60 -50 L60 -22 Z" fill="#e2c07a" stroke-width="4" />
                <!-- The filling, heaped along the fold. -->
                <g stroke-width="2.5">
                  {[-62, -40, -18, 4, 26, 48, 66].map((x, i) => (
                    <rect x={x - 12} y={-36 + (i % 2) * 8} width="26" height="17" rx="6" fill={i % 3 ? '#b8411f' : '#d2632a'} transform={`rotate(${(i % 3) * 14 - 14} ${x} ${-28 + (i % 2) * 8})`} />
                  ))}
                  {[-50, -6, 38].map((x) => (
                    <rect x={x - 8} y="-46" width="16" height="16" rx="3" fill="#f2cb3a" transform={`rotate(18 ${x} -38)`} />
                  ))}
                </g>
                <g stroke="none">
                  {[-70, -52, -30, -12, 10, 30, 52, 70].map((x, i) => (
                    <rect x={x - 3} y={-48 + (i % 3) * 4} width="6" height="6" fill="#fbfaf6" />
                  ))}
                  {[-60, -36, -16, 18, 42, 62].map((x, i) => (
                    <ellipse cx={x} cy={-52 + (i % 2) * 5} rx="8" ry="4.5" fill="#2f8f4e" transform={`rotate(${i * 30} ${x} ${-52 + (i % 2) * 5})`} />
                  ))}
                </g>
                <path d="M-72 -44 C-48 -60 -26 -30 -2 -48 S40 -34 72 -50" fill="none" stroke="#5aa832" stroke-width="7" stroke-linecap="round" />
                <!-- Front of the tortilla, with char spots. -->
                <path d="M-100 -24 A100 86 0 0 0 100 -24 Z" fill="#f2d9a0" stroke-width="5" />
                <g fill="#c9a060" stroke="none" opacity="0.75">
                  <circle cx="-50" cy="8" r="6" /><circle cx="-12" cy="34" r="4" /><circle cx="30" cy="16" r="5" /><circle cx="60" cy="0" r="3.5" /><circle cx="6" cy="2" r="3" />
                </g>
                <!-- A wedge of lime. -->
                <g transform="translate(92 34) rotate(-20)">
                  <path d="M-26 0 A26 26 0 0 0 26 0 Z" fill="#7fc24a" stroke-width="4" />
                  <path d="M-19 2 A19 19 0 0 0 19 2 Z" fill="#d9f0a8" stroke="none" />
                  <path d="M0 2 V18 M0 2 L-12 14 M0 2 L12 14" stroke="#7fc24a" stroke-width="2" />
                </g>
              </g>
            </g>
          </svg>
        </div>
      </section>

      <section class="block drinks-block" aria-labelledby="drinks-title">
        <div class="block-words">
          <h2 class="block-title" id="drinks-title">Three aguas frescas</h2>
          <p class="block-line">Tap a jar to pour a glass.</p>
        </div>
        <div class="jars">
          {
            menu.drinks.map((d) => (
              <div class="jar-spot">
                <button type="button" class="jar" data-drink={d.key} aria-label={`Pour a glass of ${d.name}`}>
                  <svg viewBox="0 0 140 220" aria-hidden="true">
                    <rect x="20" y="30" width="100" height="160" rx="22" fill="#e8f4fa" stroke="#121a3a" stroke-width="5" />
                    <rect x="27" y="62" width="86" height="121" rx="16" fill={d.color} />
                    <g fill={d.ice} opacity="0.85">
                      <rect x="40" y="70" width="16" height="14" rx="3" transform="rotate(-12 48 77)" />
                      <rect x="70" y="80" width="16" height="14" rx="3" transform="rotate(14 78 87)" />
                      <rect x="52" y="100" width="14" height="12" rx="3" />
                    </g>
                    <rect x="16" y="20" width="108" height="16" rx="5" fill="#fbfaf6" stroke="#121a3a" stroke-width="5" />
                    <path d="M95 10 V70" stroke="#121a3a" stroke-width="5" />
                    <ellipse cx="95" cy="74" rx="12" ry="6" fill="#9aa0a8" stroke="#121a3a" stroke-width="4" />
                  </svg>
                </button>
                <div class="glass" aria-hidden="true">
                  <svg viewBox="0 0 70 100">
                    <defs>
                      <clipPath id={`glass-${d.key}`}><path d="M10 8 L18 92 H52 L60 8 Z" /></clipPath>
                    </defs>
                    <g clip-path={`url(#glass-${d.key})`}>
                      <rect class="pour" x="0" y="8" width="70" height="84" fill={d.color} />
                    </g>
                    <path d="M10 8 L18 92 H52 L60 8 Z" fill="none" stroke="#121a3a" stroke-width="4" stroke-linejoin="round" />
                  </svg>
                </div>
                <h3 class="item-name">{d.name}</h3>
                <p class="item-about">{d.about}</p>
                <p class="item-price">{d.price}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="block drink-block" aria-labelledby="drink-title">
        <div class="block-words">
          <h2 class="block-title" id="drink-title">One drink, too</h2>
          <p class="block-line">
            <b>La Única.</b> Bacardi over a scoop of lime nieve de garrafa, a splash of Coke, fresh lime and salt.
            It's the only one we pour.
          </p>
          <ol class="steps mix-steps" role="list">
            <li><button type="button" class="step mix-step" data-mix="nieve">Scoop the nieve de limón</button></li>
            <li><button type="button" class="step mix-step" data-mix="rum">Pour the Bacardi</button></li>
            <li><button type="button" class="step mix-step" data-mix="coke">A splash of Coke</button></li>
            <li><button type="button" class="step mix-step" data-mix="lime">Lime and salt</button></li>
          </ol>
          <p class="price-line" id="mix-done" hidden>
            Salud. <b>La Única, $12</b>.
            <button type="button" class="again" id="mix-again">Pour another</button>
          </p>
          <p class="block-line small">21 and over. We check ID at the counter.</p>
        </div>
        <div class="cocktail" aria-hidden="true">
          <svg viewBox="0 0 220 280">
            <defs>
              <clipPath id="glass-inside"><path d="M48 46 L172 46 L158 244 Q110 258 62 244 Z" /></clipPath>
            </defs>
            <g clip-path="url(#glass-inside)">
              <rect class="mix" data-part="rum" x="40" y="96" width="140" height="170" fill="#efe6c8" opacity="0.7" />
              <path class="mix" data-part="coke" d="M40 96 H180 V128 Q150 140 110 126 T40 132 Z" fill="#4a1e0e" opacity="0.85" />
              <g class="mix" data-part="nieve">
                <circle cx="110" cy="190" r="44" fill="#d6f2a8" stroke="#121a3a" stroke-width="4" />
                <g fill="#b6e07a"><circle cx="92" cy="176" r="5" /><circle cx="122" cy="168" r="4" /><circle cx="128" cy="200" r="5" /><circle cx="98" cy="206" r="4" /></g>
              </g>
              <g class="mix bubbles" data-part="coke" fill="#ffffff" opacity="0.7">
                <circle cx="80" cy="150" r="3" /><circle cx="140" cy="170" r="2.5" /><circle cx="120" cy="140" r="2" /><circle cx="70" cy="200" r="2.5" /><circle cx="150" cy="215" r="2" />
              </g>
            </g>
            <path d="M48 46 L172 46 L158 244 Q110 258 62 244 Z" fill="none" stroke="#121a3a" stroke-width="5" stroke-linejoin="round" />
            <path d="M58 60 L70 230" stroke="#ffffff" stroke-width="5" stroke-linecap="round" opacity="0.6" />
            <!-- The salted rim and the lime. -->
            <g class="mix" data-part="lime">
              <rect x="44" y="38" width="132" height="12" rx="6" fill="#fbfaf6" stroke="#121a3a" stroke-width="3" />
              <g fill="#c9c2b2">
                {Array.from({ length: 22 }, (_, i) => <rect x={48 + i * 5.8} y={40 + (i % 3) * 2.5} width="2.5" height="2.5" />)}
              </g>
              <g transform="translate(176 44)">
                <circle r="30" fill="#7fc24a" stroke="#121a3a" stroke-width="4" />
                <circle r="23" fill="#d9f0a8" />
                <path d="M0 0 L0 -23 M0 0 L20 -11 M0 0 L20 11 M0 0 L0 23 M0 0 L-20 11 M0 0 L-20 -11" stroke="#7fc24a" stroke-width="2.5" />
              </g>
            </g>
          </svg>
        </div>
      </section>

      <section class="block desserts-block" aria-labelledby="desserts-title">
        <div class="block-words">
          <h2 class="block-title" id="desserts-title">Two desserts</h2>
          <p class="block-line">Tap a slice to take a bite.</p>
        </div>
        <div class="slices">
          {
            menu.desserts.map((d) => (
              <div class="slice-spot">
                <button type="button" class="slice" data-dessert={d.key} aria-label={`Take a bite of the ${d.name}`}>
                  <svg viewBox="0 0 240 170" aria-hidden="true">
                    <defs>
                      <mask id={`bites-${d.key}`}>
                        <rect x="0" y="0" width="240" height="170" fill="#fff" />
                        <g class="bites" fill="#000" />
                      </mask>
                    </defs>
                    <ellipse cx="120" cy="150" rx="112" ry="16" fill="#fbfaf6" stroke="#121a3a" stroke-width="4" />
                    <g mask={`url(#bites-${d.key})`}>
                      {d.key === 'chocoflan' ? (
                        <g stroke="#121a3a" stroke-width="4" stroke-linejoin="round">
                          <path d="M30 140 L210 140 L210 96 L30 96 Z" fill="#4a2414" />
                          <path d="M30 96 L210 96 L210 58 L30 58 Z" fill="#f2c14e" />
                          <path d="M30 58 L210 58 L210 46 L30 46 Z" fill="#8a4a12" />
                          <path d="M60 58 q6 16 0 24 M130 58 q5 12 0 18 M180 58 q6 18 0 26" fill="none" stroke="#8a4a12" stroke-width="6" stroke-linecap="round" />
                        </g>
                      ) : (
                        <g stroke="#121a3a" stroke-width="4" stroke-linejoin="round">
                          <path d="M30 140 L210 140 L210 70 L30 70 Z" fill="#f6e2b0" />
                          <path d="M30 70 L210 70 L210 44 L30 44 Z" fill="#fffaf0" />
                          <g fill="#c98f5f" stroke="none">
                            <circle cx="70" cy="56" r="2.5" /><circle cx="110" cy="52" r="2" /><circle cx="150" cy="58" r="2.5" /><circle cx="185" cy="52" r="2" />
                          </g>
                          <path d="M30 120 H210" stroke="#e8c98a" stroke-width="3" />
                          <circle cx="160" cy="36" r="10" fill="#c8102e" />
                        </g>
                      )}
                    </g>
                  </svg>
                </button>
                <h3 class="item-name">{d.name}</h3>
                <p class="item-about">{d.about}</p>
                <p class="item-price">{d.price}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="block visit-block" id="visit" aria-labelledby="visit-title">
        <div class="block-words">
          <h2 class="block-title" id="visit-title">Come early</h2>
          <p class="block-line">
            Walk-in only. No reservations, no delivery, no apps: you have to come in. There's always a line, so come early.
          </p>
          <div class="line-up" aria-hidden="true">
