---
// A concept site for an imaginary taquería, made to show what Maui could build for a restaurant.
// Rebuilt from Nick's review: it follows docs/el-unico/BRAND.md (three colors, one typeface, one
// flat line-art style) and puts what a hungry visitor came for first: the menu, ordering, and
// whether it's open. The menu is the pickup order; the plate shows the tacos you're building.
import '@fontsource-variable/archivo/wdth.css';
import { site } from '../../site';

type Item = { id: string; name: string; about: string; price: number; sprite: string; note?: string; orderable: boolean };
const groups: { id: string; title: string; items: Item[] }[] = [
  {
    id: 'tacos',
    title: 'Tacos',
    items: [
      {
        id: 'taco',
        name: 'Taco al pastor',
        about: 'Pork marinated two days in chiles and achiote, shaved off the trompo onto a corn tortilla. Most people get three.',
        price: 3.5,
        sprite: 'taco',
        orderable: true,
      },
    ],
  },
  {
    id: 'drinks',
    title: 'Drinks',
    items: [
      { id: 'horchata', name: 'Horchata', about: 'Rice, cinnamon, a little vanilla.', price: 3, sprite: 'agua', orderable: true },
      { id: 'jamaica', name: 'Jamaica', about: 'Hibiscus flowers, steeped cold.', price: 3, sprite: 'agua', orderable: true },
      { id: 'tamarindo', name: 'Tamarindo', about: 'Tamarind, sweet and sour.', price: 3, sprite: 'agua', orderable: true },
      {
        id: 'unica',
        name: 'La Única',
        about: 'Bacardi over a scoop of lime nieve de garrafa, a splash of Coke, fresh lime and salt. Our only cocktail.',
        price: 12,
        sprite: 'unica',
        note: 'At the counter only, 21 and over',
        orderable: false,
      },
    ],
  },
  {
    id: 'desserts',
    title: 'Desserts',
    items: [
      { id: 'chocoflan', name: 'Chocoflan', about: 'Chocolate cake under a layer of flan, baked together.', price: 5, sprite: 'chocoflan', orderable: true },
      { id: 'tresleches', name: 'Tres leches', about: 'Sponge cake soaked in three milks.', price: 5, sprite: 'tresleches', orderable: true },
    ],
  },
];
const items = groups.flatMap((g) => g.items);
const toppings = [
  { id: 'pineapple', name: 'Pineapple' },
  { id: 'onion', name: 'Onion' },
  { id: 'cilantro', name: 'Cilantro' },
  { id: 'salsa', name: 'Salsa verde' },
];
const money = (n: number) => `$${n.toFixed(2).replace('.00', '')}`;

// Open Tuesday to Sunday, 10 AM to 10 PM. Monday is for the trompo to rest.
const hours = { open: 10, close: 22, closedDay: 'Mon' };
const week = ['Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun', 'Mon'];
const dayName: Record<string, string> = { Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday', Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday' };
// Days that differ from the usual hours. A closing hour of 0 means closed all day.
const specialDays = [
  { date: '2026-11-26', close: 0, note: 'Closed for Thanksgiving' },
  { date: '2026-12-24', close: 16, note: 'Christmas Eve: open until 4 PM' },
  { date: '2026-12-25', close: 0, note: 'Closed for Christmas' },
  { date: '2026-12-31', close: 18, note: "New Year's Eve: open until 6 PM" },
  { date: '2027-01-01', close: 0, note: "Closed for New Year's Day" },
];
// Imaginary, so the details are too: 555-01xx numbers are reserved for fiction, and .example
// addresses never deliver anywhere.
const visit = {
  place: 'Inside Scottsdale Fashion Square',
  spot: 'Level 1, by the Camelback entrance',
  street: '7014 E Camelback Rd',
  city: 'Scottsdale, AZ 85251',
  phone: '(480) 555-0199',
  tel: '+14805550199',
  email: 'hola@elunico.example',
  directions: 'https://www.google.com/maps/search/?api=1&query=Scottsdale+Fashion+Square+7014+E+Camelback+Rd+Scottsdale+AZ',
};
const contact = (subject: string) => `mailto:${visit.email}?subject=${encodeURIComponent(subject)}`;
const mail = `mailto:${site.email}?subject=${encodeURIComponent('A website for my restaurant')}`;

// Where tacos sit on the plate, for up to six. Each one is turned a little differently.
const spots = [
  [-34, -30], [34, -30], [0, 30], [-58, 30], [58, 30], [0, -70],
].map(([x, y], i) => ({ x, y, turn: i * 53 }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>El Único Taquería, a concept restaurant site by {site.name}</title>
    <meta name="description" content={`A concept website for an imaginary taquería with one taco, designed and built by ${site.name}.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="unico"
    data-open={hours.open}
    data-close={hours.close}
    data-closed-day={hours.closedDay}
    data-special={JSON.stringify(specialDays)}
    data-items={JSON.stringify(items.map(({ id, name, price, orderable }) => ({ id, name, price, orderable })))}
  >
    <!-- The sprite sheet: every drawing on the page, one style. -->
    <svg class="sprites" aria-hidden="true">
      <defs>
        <symbol id="s-taco" viewBox="0 0 64 64">
          <path d="M7 32 q2 -12 9 -9 q3 -12 11 -6 q5 -11 12 -4 q6 -9 12 0 q6 -2 7 19 Z" />
          <path d="M14 22 l3 -4 M27 15 l3 3 M41 16 l-2 4 M51 21 l3 -3" fill="none" />
          <path d="M3 32 A29 20 0 0 0 61 32 Z" />
          <path d="M12 32 A20 12 0 0 0 52 32" fill="none" />
        </symbol>
        <symbol id="s-agua" viewBox="0 0 64 64">
          <path d="M18 16 H46 L42 56 H22 Z" />
          <path d="M20 30 H44" fill="none" />
          <path d="M36 16 L44 4" fill="none" />
          <circle cx="27" cy="40" r="2" /><circle cx="35" cy="46" r="2" /><circle cx="31" cy="35" r="1.5" />
        </symbol>
        <symbol id="s-unica" viewBox="0 0 64 64">
          <path d="M14 14 H50 L45 56 H19 Z" />
          <path d="M14 14 H50" stroke-dasharray="1.5 3" stroke-width="5" fill="none" />
          <circle cx="32" cy="38" r="9" />
          <circle cx="50" cy="14" r="9" />
          <path d="M50 5 V23 M41 14 H59" fill="none" />
        </symbol>
        <symbol id="s-chocoflan" viewBox="0 0 64 64">
          <path d="M8 46 L56 46 L56 34 L8 22 Z" />
          <path d="M8 34 L56 40" fill="none" />
          <path d="M8 22 Q20 18 30 26" fill="none" />
        </symbol>
        <symbol id="s-tresleches" viewBox="0 0 64 64">
          <rect x="10" y="22" width="44" height="26" rx="3" />
          <path d="M10 30 Q18 26 26 30 T42 30 T54 30" fill="none" />
          <circle cx="32" cy="17" r="5" />
          <path d="M32 12 Q34 6 38 5" fill="none" />
        </symbol>
        <symbol id="s-trompo" viewBox="0 0 120 220">
          <path d="M60 6 V214" fill="none" />
          <path d="M44 22 H76 L70 30 H50 Z" />
          <path d="M28 40 Q60 28 92 40 L84 170 Q60 182 36 170 Z" />
          <path d="M32 70 Q60 62 88 70 M34 100 Q60 92 86 100 M35 130 Q60 122 85 130 M36 158 Q60 150 84 158" fill="none" />
          <path d="M40 182 H80 L74 196 H46 Z" />
          <path d="M22 214 H98" fill="none" />
        </symbol>
      </defs>
    </svg>

    <p class="concept-bar">An imaginary taquería, built by <a href="/">{site.name}</a> to show what a restaurant site can be.</p>

    <header class="nav">
      <a class="wordmark" href="#top">El Único</a>
      <nav aria-label="Main">
        <ul role="list">
          <li><a href="#menu">Menu</a></li>
          <li><a href="#hours">Hours &amp; location</a></li>
          <li><a href="#story">Our story</a></li>
        </ul>
      </nav>
      <p class="nav-status"><span class="dot" aria-hidden="true"></span><span class="status-short">Checking our hours</span></p>
      <a class="button button-primary nav-order" href="#menu">Order pickup</a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">El Único Taquería</h1>
        <p class="hero-line">Tacos al pastor off the trompo, inside Scottsdale Fashion Square. Order ahead for pickup, or walk up to the counter.</p>
        <dl class="facts">
          <div>
            <dt>Today</dt>
            <dd class="status-long">Open Tuesday to Sunday, 10 AM to 10 PM</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Scottsdale Fashion Square, level 1, by the Camelback entrance</dd>
          </div>
          <div>
            <dt>How to eat</dt>
            <dd>Walk up or order pickup. No reservations, no delivery.</dd>
          </div>
        </dl>
        <div class="hero-actions">
          <a class="button button-primary" href="#menu">Order pickup</a>
          <a class="button button-quiet" href="#menu">See the menu</a>
          <a class="button button-quiet" href={visit.directions} target="_blank" rel="noopener">Directions</a>
        </div>
      </section>

      <section class="menu" id="menu" aria-labelledby="menu-title">
        <div class="menu-list">
          <h2 class="section-title" id="menu-title">Menu</h2>
          <p class="section-line">Add what you want for pickup, or order the same at the counter.</p>
          {groups.map((g) => (
            <section class="group" id={g.id} aria-labelledby={`${g.id}-title`}>
              <h3 class="group-title" id={`${g.id}-title`}>{g.title}</h3>
              <ul class="items" role="list">
                {g.items.map((item) => (
                  <li class="item" data-id={item.id}>
                    <svg class="item-art" aria-hidden="true"><use href={`#s-${item.sprite}`} /></svg>
                    <div class="item-words">
                      <p class="item-name">{item.name} <span class="item-price">{money(item.price)}</span></p>
                      <p class="item-about">{item.about}</p>
                      {item.note && <p class="item-note">{item.note}</p>}
                      {item.id === 'taco' && (
                        <fieldset class="toppings">
                          <legend>Toppings, all on the way we make them</legend>
                          {toppings.map((t) => (
                            <label class="topping">
                              <input type="checkbox" name="topping" value={t.id} checked />
                              <span>{t.name}</span>
                            </label>
                          ))}
                        </fieldset>
                      )}
                    </div>
                    {item.orderable && (
                      <div class="stepper" role="group" aria-label={`${item.name} quantity`}>
                        <button type="button" class="step-less" data-id={item.id} aria-label={`One less ${item.name}`} disabled>−</button>
                        <output class="qty" id={`qty-${item.id}`} aria-live="polite">0</output>
                        <button type="button" class="step-more" data-id={item.id} aria-label={`One more ${item.name}`}>+</button>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <aside class="order" id="your-order" aria-labelledby="order-title">
          <h2 class="order-title" id="order-title">Your pickup order</h2>
          <svg class="plate" viewBox="-100 -100 200 200" role="img" aria-labelledby="plate-label">
            <title id="plate-label">Your plate, empty</title>
            <circle r="94" class="plate-rim" />
            <circle r="80" class="plate-well" />
            {spots.map((s, i) => (
              <g class="plate-taco" data-n={i + 1} transform={`translate(${s.x} ${s.y}) rotate(${s.turn})`}>
                <circle r="27" class="tortilla" />
                <g class="pastor">
                  <rect x="-12" y="-10" width="7" height="6" rx="1.5" /><rect x="2" y="-14" width="7" height="6" rx="1.5" />
                  <rect x="6" y="2" width="7" height="6" rx="1.5" /><rect x="-10" y="4" width="7" height="6" rx="1.5" />
                  <rect x="-3" y="-3" width="7" height="6" rx="1.5" />
                </g>
                <g class="t t-pineapple"><path d="M-16 -2 l6 -5 l2 7 z" /><path d="M12 -10 l6 -2 l-1 7 z" /></g>
                <g class="t t-onion"><circle cx="-4" cy="-16" r="2.5" /><circle cx="14" cy="12" r="2.5" /><circle cx="-16" cy="12" r="2.5" /></g>
                <g class="t t-cilantro"><path d="M-6 14 q3 -4 6 0 q-3 4 -6 0" /><path d="M16 -2 q3 -4 6 0 q-3 4 -6 0" /></g>
                <path class="t t-salsa" d="M-18 -18 q6 6 12 0 t12 0 t10 4" />
              </g>
            ))}
            <text class="plate-more" y="88" text-anchor="middle"></text>
          </svg>
          <ul class="lines" id="lines" role="list"></ul>
          <p class="empty" id="empty">Nothing yet. Add tacos and they show up on the plate.</p>
          <p class="total" id="total-row" hidden><span>Total</span><span id="total">$0</span></p>
          <button type="button" class="button button-primary checkout" id="checkout" disabled>Check out</button>
          <p class="order-note">Pay when you pick up, at the side window. Ready in about 15 minutes.</p>
        </aside>
      </section>

      <section class="hours" id="hours" aria-labelledby="hours-title">
        <h2 class="section-title" id="hours-title">Hours &amp; location</h2>
        <div class="hours-grid">
          <div>
            <h3 class="small-title">Hours</h3>
            <table class="week">
              <tbody>
                {week.map((d) => (
                  <tr data-day={d}>
                    <th scope="row">{dayName[d]}</th>
                    <td>{d === hours.closedDay ? 'Closed' : '10 AM to 10 PM'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <ul class="special" id="special-days" role="list"></ul>
          </div>
          <div>
            <h3 class="small-title">Where</h3>
            <p>{visit.place}<br />{visit.spot}<br />{visit.street}<br />{visit.city}</p>
            <p><a href={visit.directions} target="_blank" rel="noopener">Get directions</a></p>
            <h3 class="small-title">Parking</h3>
            <p>Free in the mall garage. The Camelback entrance is closest.</p>
          </div>
          <div>
            <h3 class="small-title">Call or write</h3>
            <p><a href={`tel:${visit.tel}`}>{visit.phone}</a><br /><a href={contact('Hola')}>{visit.email}</a></p>
            <h3 class="small-title">Good to know</h3>
            <p>Cards and cash. Seats for 20 at the counter. There's often a line at lunch; pickup skips it.</p>
          </div>
        </div>
      </section>

      <section class="story" id="story" aria-labelledby="story-title">
        <svg class="story-art" viewBox="0 0 120 220" aria-hidden="true"><use href="#s-trompo" /></svg>
        <div class="story-words">
          <h2 class="section-title" id="story-title">Why only one taco?</h2>
          <p class="story-lead">Because once you find the love of your life, you don't need many options.</p>
          <p>
            We spent two years on one marinade: guajillo and ancho chiles, achiote, a little pineapple, two days in the cold.
            The pork is stacked on the trompo every morning and shaved to order, so the edges stay crisp. The tortillas are pressed at
            the counter. That's the whole menu, and it's the whole point.
          </p>
        </div>
      </section>

      <section class="more" aria-label="Catering, gift cards and jobs">
        <div id="catering">
          <h2 class="small-title">Catering</h2>
          <p>A taquero and a trompo at your party, from 30 to 300 people.</p>
          <a href={contact('Catering')}>Ask about a date</a>
        </div>
        <div id="gift-cards">
          <h2 class="small-title">Gift cards</h2>
          <p>Any amount, at the counter. They never expire.</p>
          <a href={contact('Gift cards')}>Ask about gift cards</a>
        </div>
        <div id="jobs">
          <h2 class="small-title">We're hiring</h2>
          <p>Taqueros and counter crew. We'll teach you the trompo.</p>
          <a href={contact('Working at El Único')}>Apply by email</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-grid">
        <div>
          <p class="footer-mark">El Único</p>
          <p>{visit.place}<br />{visit.street}<br />{visit.city}</p>
          <p>Tuesday to Sunday, 10 AM to 10 PM</p>
        </div>
        <nav aria-label="Menu">
          <h2 class="footer-title">Menu</h2>
          <ul role="list">
            <li><a href="#tacos">Tacos</a></li>
            <li><a href="#drinks">Drinks</a></li>
            <li><a href="#desserts">Desserts</a></li>
          </ul>
        </nav>
        <nav aria-label="Order">
          <h2 class="footer-title">Order</h2>
          <ul role="list">
            <li><a href="#menu">Pickup</a></li>
            <li><a href="#catering">Catering</a></li>
            <li><a href="#gift-cards">Gift cards</a></li>
          </ul>
        </nav>
        <nav aria-label="About">
          <h2 class="footer-title">About</h2>
          <ul role="list">
            <li><a href="#story">Our story</a></li>
            <li><a href="#hours">Hours &amp; location</a></li>
            <li><a href="#jobs">Jobs</a></li>
            <li><a href={contact('Hola')}>Contact</a></li>
          </ul>
        </nav>
      </div>
      <div class="footer-concept">
        <p>El Único is imaginary: the address is a real mall, but the taquería, phone number and email are made up. Site designed and built by {site.name}.</p>
        <a class="button button-primary" href={mail}>I want a site like this for my restaurant</a>
        <a href="/">Back to {site.name}</a>
      </div>
    </footer>

    <div class="bar" id="bar">
      <a href={`tel:${visit.tel}`}>Call</a>
      <a href={visit.directions} target="_blank" rel="noopener">Directions</a>
      <a class="bar-order" href="#your-order" id="bar-order">Order pickup</a>
    </div>

    <dialog class="checkout-dialog" id="checkout-dialog" aria-labelledby="checkout-title">
      <form method="dialog" id="checkout-form" class="checkout-form">
        <h2 class="order-title" id="checkout-title">Check out</h2>
        <ul class="lines" id="checkout-lines" role="list"></ul>
        <p class="total"><span>Total, paid at pickup</span><span id="checkout-total"></span></p>
        <label class="field">Name for the order<input name="name" autocomplete="given-name" required /></label>
        <label class="field">Phone, so we can text you when it's ready<input name="phone" type="tel" autocomplete="tel" required /></label>
        <label class="field">Pickup time<select name="time" id="pickup-time" required></select></label>
        <div class="dialog-actions">
          <button type="submit" class="button button-primary" value="place">Place order</button>
          <button type="button" class="button button-quiet" id="checkout-cancel">Keep shopping</button>
        </div>
      </form>
      <div class="confirm" id="confirm" hidden>
        <h2 class="order-title" id="confirm-title">Order in</h2>
        <p id="confirm-text"></p>
        <p class="order-note">This is a concept site, so nothing was sent and nobody is cooking. But this is what it would feel like.</p>
        <button type="button" class="button button-primary" id="confirm-close">Done</button>
      </div>
    </dialog>
  </body>
</html>

<script>
  import { nowAt, formatHour } from '../../lib/sky';
  import { here } from '../../site';

  const { dataset } = document.body;
  const hours = { open: Number(dataset.open), close: Number(dataset.close), closedDay: dataset.closedDay! };
  const special: { date: string; close: number; note: string }[] = JSON.parse(dataset.special ?? '[]');
  const items: { id: string; name: string; price: number; orderable: boolean }[] = JSON.parse(dataset.items!);
  const el = (id: string) => document.getElementById(id)!;
  const money = (n: number) => `$${n.toFixed(2).replace('.00', '')}`;
  const say = (h: number) => {
    const c = formatHour(h);
    return `${c.time.replace(':00', '')} ${c.half}`;
  };

  // Dates and weekdays in Scottsdale, some days from now.
  const DAY = 86_400_000;
  const dateIn = (ahead: number) => new Intl.DateTimeFormat('en-CA', { timeZone: here.timeZone }).format(new Date(Date.now() + ahead * DAY));
  const weekdayIn = (ahead: number) =>
    new Intl.DateTimeFormat('en-US', { timeZone: here.timeZone, weekday: 'short' }).format(new Date(Date.now() + ahead * DAY));
  const longDay = (ahead: number) =>
    new Intl.DateTimeFormat('en-US', { timeZone: here.timeZone, weekday: 'long' }).format(new Date(Date.now() + ahead * DAY));
  // Opening and closing hour for a day, or null if closed.
  const hoursOn = (ahead: number) => {
    const holiday = special.find((d) => d.date === dateIn(ahead));
    const close = holiday ? holiday.close : hours.close;
    if (weekdayIn(ahead) === hours.closedDay || close === 0) return null;
    return { open: hours.open, close, note: holiday?.note };
  };

  // Today's status, short for the nav and long for the hero.
  const status = () => {
    const now = nowAt(here).hour;
    const today = hoursOn(0);
    if (today && now >= today.open && now < today.close) {
      return { open: true, short: `Open until ${say(today.close)}`, long: `Open now, until ${say(today.close)}${today.note ? `. ${today.note}` : ''}.` };
    }
    if (today && now < today.open) return { open: false, short: `Opens at ${say(today.open)}`, long: `Closed now. We open today at ${say(today.open)}.` };
    for (let ahead = 1; ahead < 8; ahead++) {
      const day = hoursOn(ahead);
      if (day) {
        const when = ahead === 1 ? 'tomorrow' : longDay(ahead);
        return { open: false, short: `Opens ${when} at ${say(day.open)}`, long: `Closed now. We open ${when} at ${say(day.open)}.` };
      }
    }
    return { open: false, short: 'Closed', long: 'Closed.' };
  };
  const showStatus = () => {
    const s = status();
    document.body.classList.toggle('is-open', s.open);
    document.querySelectorAll('.status-short').forEach((n) => (n.textContent = s.short));
    document.querySelectorAll('.status-long').forEach((n) => (n.textContent = s.long));
  };
  showStatus();
  setInterval(showStatus, 30_000);

  // Today's row in the hours table, and the next few special days.
  document.querySelector(`.week tr[data-day="${weekdayIn(0)}"]`)?.classList.add('is-today');
  special
    .filter((d) => d.date >= dateIn(0))
    .slice(0, 3)
    .forEach((d) => {
      const li = document.createElement('li');
      const when = new Date(`${d.date}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      li.textContent = `${when}: ${d.note}`;
      el('special-days').append(li);
    });

  // The order. Counts per item, and which toppings go on the tacos.
  const counts: Record<string, number> = Object.fromEntries(items.map((i) => [i.id, 0]));
  const toppingBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name="topping"]')];
  const plate = document.querySelector<SVGSVGElement>('.plate')!;
  const chosen = () => toppingBoxes.filter((b) => b.checked).map((b) => b.nextElementSibling!.textContent!.toLowerCase());
  const lineFor = (i: (typeof items)[number]) => {
    const n = counts[i.id];
    let detail = '';
    if (i.id === 'taco') {
      const t = chosen();
      detail = t.length === toppingBoxes.length ? 'with everything' : t.length ? `with ${t.join(', ')}` : 'just the meat';
    }
    return { n, name: i.name, detail, cost: n * i.price };
  };
  const renderLines = (list: HTMLElement) => {
    list.replaceChildren(
      ...items
        .filter((i) => counts[i.id] > 0)
        .map((i) => {
          const l = lineFor(i);
          const li = document.createElement('li');
          li.className = 'line';
          li.innerHTML = `<span class="line-n">${l.n}</span><span class="line-name">${l.name}${l.detail ? `<small>${l.detail}</small>` : ''}</span><span class="line-cost">${money(l.cost)}</span>`;
          return li;
        }),
    );
  };
  const total = () => items.reduce((sum, i) => sum + counts[i.id] * i.price, 0);
  const itemCount = () => Object.values(counts).reduce((a, b) => a + b, 0);
  const render = () => {
    items.forEach((i) => {
      if (!i.orderable) return;
      el(`qty-${i.id}`).textContent = String(counts[i.id]);
      document.querySelector<HTMLButtonElement>(`.step-less[data-id="${i.id}"]`)!.disabled = counts[i.id] === 0;
    });
    // The plate shows your tacos, up to six, with the toppings you picked.
    const tacos = counts.taco;
    plate.querySelectorAll<SVGGElement>('.plate-taco').forEach((g) => g.classList.toggle('is-on', Number(g.dataset.n) <= tacos));
    plate.querySelector('.plate-more')!.textContent = tacos > 6 ? `and ${tacos - 6} more` : '';
    toppingBoxes.forEach((b) => plate.classList.toggle(`no-${b.value}`, !b.checked));
    el('plate-label').textContent = tacos ? `Your plate: ${tacos} taco${tacos > 1 ? 's' : ''} al pastor` : 'Your plate, empty';
    renderLines(el('lines'));
    const n = itemCount();
    el('empty').hidden = n > 0;
    el('total-row').hidden = n === 0;
    el('total').textContent = money(total());
    (el('checkout') as HTMLButtonElement).disabled = n === 0;
    el('bar-order').textContent = n ? `Review order, ${money(total())}` : 'Order pickup';
  };
  document.querySelectorAll<HTMLButtonElement>('.step-more, .step-less').forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.id!;
      counts[id] = Math.max(0, counts[id] + (b.classList.contains('step-more') ? 1 : -1));
      render();
    }),
  );
  toppingBoxes.forEach((b) => b.addEventListener('change', render));
  render();

  // Pickup times: every 15 minutes, starting 15 minutes from now, within open hours.
  const pickupTimes = () => {
    const out: { value: string; label: string }[] = [];
    const now = nowAt(here).hour;
    for (let ahead = 0; ahead < 8 && out.length < 16; ahead++) {
      const day = hoursOn(ahead);
      if (!day) continue;
      let t = ahead === 0 ? Math.max(day.open + 0.25, Math.ceil((now + 0.25) * 4) / 4) : day.open + 0.25;
      const label = ahead === 0 ? 'Today' : ahead === 1 ? 'Tomorrow' : longDay(ahead);
      for (; t <= day.close - 0.25 && out.length < 16; t += 0.25) {
        const h = Math.floor(t);
        const m = Math.round((t - h) * 60);
        const time = `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`;
        out.push({ value: `${dateIn(ahead)} ${time}`, label: `${label}, ${time}` });
      }
    }
    return out;
  };
  const dialog = el('checkout-dialog') as HTMLDialogElement;
  const form = el('checkout-form') as HTMLFormElement;
  el('checkout').addEventListener('click', () => {
    renderLines(el('checkout-lines'));
    el('checkout-total').textContent = money(total());
    el('pickup-time').replaceChildren(...pickupTimes().map((p) => new Option(p.label, p.label)));
    form.hidden = false;
    el('confirm').hidden = true;
    dialog.showModal();
  });
  el('checkout-cancel').addEventListener('click', () => dialog.close());
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const number = 1000 + Math.floor(Math.random() * 9000);
    el('confirm-text').textContent = `Thanks, ${data.get('name')}. Order ${number} will be ready ${String(data.get('time')).replace(/^Today, /, 'today at ').replace(/^Tomorrow, /, 'tomorrow at ').replace(/^(\w+day), /, 'on $1 at ')}, at the side window. Pay when you pick it up: ${money(total())}.`;
    form.hidden = true;
    el('confirm').hidden = false;
    el('confirm-close').focus();
  });
  el('confirm-close').addEventListener('click', () => {
    dialog.close();
    Object.keys(counts).forEach((k) => (counts[k] = 0));
    form.reset();
    render();
  });
</script>

