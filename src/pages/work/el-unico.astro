              <text x="470" y="58" text-anchor="middle" font-family="Literata Variable, Georgia, serif" font-style="italic" font-size="13" fill="#7cf7d4">tacos</text>
              {[0, 1, 2, 3, 4, 5, 6].map((i) => (
                <g class="person" style={`--i:${i}`} transform={`translate(${390 - i * 54} 0)`}>
                  <circle cx="0" cy="40" r="11" fill={['#c98f5f', '#8a5523', '#e0b48a', '#6b3f22'][i % 4]} stroke="#121a3a" stroke-width="3" />
                  <path d="M-15 110 V70 Q-15 56 0 56 Q15 56 15 70 V110 Z" fill={['#1f3fcf', '#2f8f4e', '#f2cb3a', '#f07a1e', '#7b2d8e', '#1e9fea', '#b5402b'][i]} stroke="#121a3a" stroke-width="3" />
