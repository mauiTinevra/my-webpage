---
// Work: each project as a short case study. What it was, what I did and why, and where to see it.
import Base from '../../layouts/Base.astro';
import { work } from '../../data/work';
---

<Base bare title="Work" description="Websites designed and built by Maui Tinevra, with what each one needed and what I did about it.">
  <header class="w-head">
    <h1 class="w-title">Work</h1>
    <p class="w-lede">Each project, what it needed, and what I did about it.</p>
  </header>
  {
    work.map((w) => (
      <article class="w-case" id={w.id} aria-labelledby={`${w.id}-title`}>
        <a class="w-shot" href={w.links[0].href}>
          <img src={w.image} alt={w.alt} width="1200" height="750" loading="lazy" />
        </a>
        <div class="w-words">
          <p class="w-kind">{w.kind}</p>
          <h2 class="w-name" id={`${w.id}-title`}>{w.name}</h2>
          <h3>The problem</h3>
          <p>{w.problem}</p>
          <h3>What I did</h3>
          <ul>
            {w.did.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
          <p class="w-result">{w.result}</p>
          <p class="w-links">
            {w.links.map((l, i) => (
              <a class={i === 0 ? 'btn btn-primary' : 'btn'} href={l.href}>
                {l.label}
              </a>
            ))}
          </p>
        </div>
      </article>
    ))
  }
  <section class="w-next" aria-labelledby="next-title">
    <h2 class="w-name" id="next-title">Yours could be next</h2>
    <p>Websites start at $3,500 and take two to three weeks.</p>
    <p class="w-links"><a class="btn btn-primary" href="/#contact">Start a project</a><a class="btn" href="/web-design">Services &amp; pricing</a></p>
  </section>
</Base>

<style>
  .w-head { padding: clamp(2.5rem, 6vw, 4rem) var(--edge) 1.5rem; }
  .w-title { margin: 0; font-family: var(--display); font-weight: 800; font-stretch: 125%; font-size: clamp(2.8rem, 7vw, 5rem); line-height: 0.95; letter-spacing: -0.02em; }
  .w-lede { margin: 0.75rem 0 0; font-size: 1.2rem; }
  .w-case { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); padding: clamp(2.5rem, 5vw, 4rem) var(--edge); border-top: 2px solid var(--ink); scroll-margin-top: 4.5rem; }
  .w-shot img { display: block; width: 100%; height: auto; border: 2px solid var(--ink); }
  .w-shot:hover img { outline: 3px solid var(--yellow); }
  .w-kind { margin: 0; font-family: var(--display); font-weight: 700; }
  .w-name { margin: 0.25rem 0 0; font-family: var(--display); font-weight: 800; font-stretch: 112%; font-size: clamp(1.8rem, 3.5vw, 2.5rem); line-height: 1.05; }
  .w-words h3 { margin: 1.5rem 0 0.4rem; font-family: var(--display); font-weight: 800; font-size: 1.05rem; }
  .w-words p, .w-words li { max-width: 36rem; line-height: 1.55; }
  .w-words p { margin: 0; }
  .w-words ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; }
  .w-result { margin-top: 1.25rem !important; font-weight: 700; }
  .w-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem !important; }
  .w-next { padding: clamp(2.5rem, 5vw, 4rem) var(--edge); border-top: 2px solid var(--ink); background: var(--yellow); }
  .w-next p { margin: 0.75rem 0 0; font-size: 1.15rem; }
  .btn { display: inline-flex; align-items: center; min-height: 2.9rem; padding: 0.6rem 1.3rem; border: 2px solid var(--ink); background: transparent; color: var(--ink); font: 800 1rem var(--display); text-decoration: none; }
  .btn:hover { background: var(--ink); color: var(--paper); }
  .btn-primary { background: var(--yellow); }
  .btn-primary:hover { color: var(--yellow); }
  .w-next .btn-primary { background: var(--paper); }
  .w-next .btn-primary:hover { background: var(--ink); color: var(--yellow); }
  @media (max-width: 820px) {
    .w-case { grid-template-columns: 1fr; }
  }
</style>
