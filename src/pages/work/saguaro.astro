---
// A concept site for an imaginary yoga studio in Scottsdale, made to show what Maui could build
// for a studio. Built to the Saguaro Yoga Club guidelines: warm paper, one deep green, a rare
// bloom of pink, one serif (Newsreader) and a lot of space. Schedule and booking come first.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import { site } from '../../site';

// Each style has an intensity (1 to 5) and a plain line about what happens in it.
const styles = [
  { key: 'vinyasa', name: 'Vinyasa Flow', heat: 3, about: 'Breath-led movement that links one pose to the next. The class most people start with and stay for.' },
  { key: 'power', name: 'Power', heat: 5, about: 'Strength, long holds and many chaturangas (low push-ups). Bring water.' },
  { key: 'hot', name: 'Hot Vinyasa', heat: 4, about: 'Vinyasa in a 95°F room. You will sweat.' },
  { key: 'slow', name: 'Slow Flow', heat: 2, about: 'The same flow at half the speed, with time to feel each pose.' },
  { key: 'yin', name: 'Yin', heat: 1, about: 'Floor poses held for minutes. Quiet, deep and harder than it looks.' },
  { key: 'basics', name: 'Beginners', heat: 2, about: 'Never done yoga? Start here. We teach the names, the shapes and how to breathe.' },
];
// The week. Times are clock hours in Scottsdale (17.5 is 5:30 PM).
const week: Record<string, { at: number; style: string; mins: number; teacher: string }[]> = {
  Mon: [
    { at: 6, style: 'power', mins: 60, teacher: 'Dev' },
    { at: 9, style: 'slow', mins: 60, teacher: 'June' },
    { at: 12, style: 'vinyasa', mins: 45, teacher: 'Rosa' },
    { at: 17.5, style: 'hot', mins: 60, teacher: 'Kai' },
    { at: 19, style: 'yin', mins: 75, teacher: 'Marisol' },
  ],
  Tue: [
    { at: 6, style: 'vinyasa', mins: 60, teacher: 'Rosa' },
    { at: 9, style: 'basics', mins: 60, teacher: 'Theo' },
    { at: 12, style: 'power', mins: 45, teacher: 'Dev' },
    { at: 17.5, style: 'vinyasa', mins: 60, teacher: 'June' },
    { at: 19, style: 'slow', mins: 60, teacher: 'Marisol' },
  ],
  Wed: [
    { at: 6, style: 'hot', mins: 60, teacher: 'Kai' },
    { at: 9, style: 'yin', mins: 75, teacher: 'Marisol' },
    { at: 12, style: 'vinyasa', mins: 45, teacher: 'Rosa' },
    { at: 17.5, style: 'power', mins: 60, teacher: 'Dev' },
    { at: 19, style: 'basics', mins: 60, teacher: 'Theo' },
  ],
  Thu: [
    { at: 6, style: 'vinyasa', mins: 60, teacher: 'June' },
    { at: 9, style: 'slow', mins: 60, teacher: 'Theo' },
    { at: 12, style: 'hot', mins: 45, teacher: 'Kai' },
    { at: 17.5, style: 'vinyasa', mins: 60, teacher: 'Rosa' },
    { at: 19, style: 'yin', mins: 75, teacher: 'Marisol' },
  ],
  Fri: [
    { at: 6, style: 'power', mins: 60, teacher: 'Dev' },
    { at: 9, style: 'vinyasa', mins: 60, teacher: 'June' },
    { at: 12, style: 'slow', mins: 45, teacher: 'Theo' },
    { at: 17.5, style: 'hot', mins: 60, teacher: 'Kai' },
  ],
  Sat: [
    { at: 8, style: 'vinyasa', mins: 75, teacher: 'Rosa' },
    { at: 10, style: 'basics', mins: 60, teacher: 'Theo' },
    { at: 12, style: 'power', mins: 60, teacher: 'Dev' },
    { at: 16, style: 'yin', mins: 75, teacher: 'Marisol' },
  ],
  Sun: [
    { at: 8, style: 'slow', mins: 75, teacher: 'June' },
    { at: 10, style: 'hot', mins: 60, teacher: 'Kai' },
    { at: 17, style: 'yin', mins: 90, teacher: 'Marisol' },
  ],
};
const days = Object.keys(week);
const dayNames: Record<string, string> = { Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday', Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday' };
const clock = (at: number) => {
  const h = Math.floor(at);
  const m = Math.round((at % 1) * 60);
  return `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`;
};
const styleOf = (key: string) => styles.find((s) => s.key === key)!;

// How you feel today, and the class that answers it.
const moods = [
  { key: 'stiff', label: 'Stiff', style: 'yin', why: 'Long, quiet holds that let tight hips and backs let go.' },
  { key: 'stressed', label: 'Stressed', style: 'slow', why: 'Slow breathing and slower moving.' },
  { key: 'restless', label: 'Restless', style: 'power', why: 'Somewhere for the extra energy to go. Then you lie down.' },
  { key: 'sweaty', label: 'Ready to sweat', style: 'hot', why: 'A warm room and a steady flow. Bring a towel.' },
  { key: 'new', label: 'Brand new', style: 'basics', why: 'Every pose explained, at your own pace.' },
];

// The teachers, and what each one teaches this week (read from the schedule).
const bios: Record<string, string> = {
  Rosa: 'Opened the studio in 2019. Teaches flow the way she learned it: breath first.',
  Dev: 'A former climber. His Power classes are hard and his cues are clear.',
  Kai: 'Runs the hot room. Will remind you to drink water more than once.',
  June: 'Slow and steady. Good with stiff shoulders and first-timers.',
  Marisol: 'Teaches Yin and most evenings. Her classes end in near silence.',
  Theo: 'Teaches Beginners. Explains every pose and never rushes anyone.',
};
const teaches = (name: string) =>
  [...new Set(Object.values(week).flat().filter((c) => c.teacher === name).map((c) => styleOf(c.style).name))].join(', ');

const prices = [
  { name: 'First week', detail: 'Seven days of every class, for new students. Mat and towel included.', price: '$29' },
  { name: 'Drop in', detail: 'One class, any style.', price: '$24' },
  { name: 'Ten classes', detail: 'Good for a year, and you can share it with a friend.', price: '$210' },
  { name: 'Unlimited', detail: 'Every class, every day. Pause anytime.', price: '$149 a month' },
];

// Imaginary, so the details are too: 555-01xx numbers are reserved for fiction, and .example
// addresses never deliver anywhere.
const visit = {
  place: 'Old Town Scottsdale',
  city: 'Scottsdale, AZ',
  phone: '(480) 555-0142',
  tel: '+14805550142',
  email: 'hello@saguaroyoga.example',
};
const contact = (subject: string) => `mailto:${visit.email}?subject=${encodeURIComponent(subject)}`;
const mail = `mailto:${site.email}?subject=${encodeURIComponent('A website for my yoga studio')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Saguaro Yoga Club, a concept yoga studio site by {site.name}</title>
    <meta name="description" content={`A concept website for an imaginary yoga studio in Scottsdale, designed and built by ${site.name}.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="sag" data-week={JSON.stringify(week)} data-styles={JSON.stringify(styles.map(({ key, name }) => ({ key, name })))}>
    <p class="concept-bar">
      An imaginary yoga studio, built by <a href="/">{site.name}</a> to show what a studio site could be.
    </p>

    <header class="top">
      <a class="brand" href="#top" aria-label="Saguaro Yoga Club, back to top">
        <svg class="mark" viewBox="0 0 64 80" aria-hidden="true">
          <path d="M27 76 V22 a5 5 0 0 1 10 0 V76" />
          <path d="M27 50 H20 a4 4 0 0 1 -4 -4 V34 a3 3 0 0 1 6 0 V44 H27" />
          <path d="M37 42 H43 a4 4 0 0 0 4 -4 V26 a3 3 0 0 0 -6 0 V36 H37" />
          <path d="M12 76 H52" />
          <circle class="dot" cx="32" cy="13" r="3" />
        </svg>
        <span>Saguaro Yoga Club</span>
      </a>
      <nav aria-label="Main">
        <a href="#schedule">Schedule</a>
        <a href="#pricing">Pricing</a>
        <a href="#first-visit">First visit</a>
        <a href="#about">About</a>
        <a class="button" href={contact('Book a class')}>Book a class</a>
      </nav>
    </header>

    <main id="top">
      <section class="opening" aria-labelledby="headline">
        <div class="opening-words">
          <h1 id="headline">Stand tall.<br />Bend a little.</h1>
          <p class="lead">
            A yoga studio in {visit.place} with six kinds of class, from a hard hour of Power to an evening of lying very still.
          </p>
          <p class="next" id="next" aria-live="polite">See this week’s classes below.</p>
          <div class="actions">
            <a class="button" href={contact('Book a class')}>Book a class</a>
            <a class="button button-line" href="#pricing">First week, $29</a>
          </div>
        </div>
        <svg class="drawing" viewBox="0 0 320 360" aria-hidden="true">
          <circle cx="272" cy="64" r="30" />
          <path d="M8 316 H312" />
          <path d="M40 330 H150 M190 330 H280" class="faint" />
          <g transform="translate(64 26) scale(3.6)">
            <path d="M27 80 V22 a5 5 0 0 1 10 0 V80" />
            <path d="M27 50 H20 a4 4 0 0 1 -4 -4 V34 a3 3 0 0 1 6 0 V44 H27" />
            <path d="M37 42 H43 a4 4 0 0 0 4 -4 V26 a3 3 0 0 0 -6 0 V36 H37" />
            <circle class="dot" cx="32" cy="13" r="2.4" />
          </g>
          <g transform="translate(250 230) scale(1.1)" class="faint">
            <path d="M27 78 V30 a4 4 0 0 1 8 0 V78" />
            <path d="M27 56 H22 a3 3 0 0 1 -3 -3 V44 a2.5 2.5 0 0 1 5 0 V51 H27" />
          </g>
        </svg>
      </section>

      <section class="band" id="schedule" aria-labelledby="schedule-title">
        <div class="band-head">
          <h2 id="schedule-title">This week</h2>
          <p class="muted">Walk in or book ahead. Classes cap at 24 mats.</p>
        </div>

        <div class="day-tabs" role="tablist" aria-label="Day of the week">
          {days.map((d) => (
            <button type="button" role="tab" class="day-tab" data-day={d} aria-selected="false" aria-controls={`day-${d}`} id={`tab-${d}`} tabindex="-1">
              <span class="day-label">{d}</span>
            </button>
          ))}
        </div>

        <div class="filters" role="group" aria-label="Show one kind of class">
          <button type="button" class="filter" data-filter="all" aria-pressed="true">All classes</button>
          {styles.map((s) => (
            <button type="button" class="filter" data-filter={s.key} aria-pressed="false">{s.name}</button>
          ))}
        </div>

        {days.map((d) => (
          <ol class="day" id={`day-${d}`} role="tabpanel" aria-labelledby={`tab-${d}`} aria-label={dayNames[d]} hidden>
            {week[d].map((c) => (
              <li class="slot" data-style={c.style} data-at={c.at}>
                <span class="slot-time">{clock(c.at)}</span>
                <span class="slot-name">{styleOf(c.style).name} <span class="slot-teacher">with {c.teacher}</span></span>
                <span class="slot-mins">{c.mins} min</span>
              </li>
            ))}
            <li class="slot-empty" hidden>No class of that kind on this day. Try another day, or show all classes.</li>
          </ol>
        ))}

        <div class="helper">
          <p class="helper-q" id="mood-title">Not sure which class? Pick how you feel.</p>
          <div class="moods" role="group" aria-labelledby="mood-title">
            {moods.map((m) => (
              <button type="button" class="mood" data-style={m.style} data-why={m.why} aria-pressed="false">{m.label}</button>
            ))}
          </div>
          <p class="pick" id="pick" aria-live="polite" hidden></p>
        </div>

        <dl class="classes">
          {styles.map((s) => (
            <div class="class">
              <dt>{s.name}</dt>
              <dd class="heat">
                <span class="dots" aria-hidden="true">{Array.from({ length: 5 }, (_, i) => <i class={i < s.heat ? 'on' : ''} />)}</span>
                <span class="sr">Intensity {s.heat} of 5</span>
              </dd>
              <dd>{s.about}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="band" id="pricing" aria-labelledby="pricing-title">
        <div class="band-head">
          <h2 id="pricing-title">Pricing</h2>
          <p class="muted">New here? Start with the first week.</p>
        </div>
        <ul class="prices" role="list">
          {prices.map((p, i) => (
            <li class={i === 0 ? 'price is-first' : 'price'}>
              <div>
                <p class="price-name">{p.name}</p>
                <p class="price-detail">{p.detail}</p>
              </div>
              <p class="price-amount">{p.price}</p>
            </li>
          ))}
        </ul>
        <a class="button" href={contact('My first week')}>Start my first week</a>
      </section>

      <section class="band" id="first-visit" aria-labelledby="first-title">
        <div class="band-head">
          <h2 id="first-title">Your first class</h2>
          <p class="aside">Come as you are.</p>
        </div>
        <div class="faq">
          <details>
            <summary>What do I bring?</summary>
            <p>Clothes you can move in and some water. We have mats ($3 to rent, free your first week), blocks, straps and towels.</p>
          </details>
          <details>
            <summary>When should I get there?</summary>
            <p>Ten minutes early the first time, so we can show you around and ask about any injuries.</p>
          </details>
          <details>
            <summary>I can’t touch my toes.</summary>
            <p>Most people can’t. You don’t need to be flexible to start. Try Beginners or Slow Flow.</p>
          </details>
          <details>
            <summary>How hot is Hot Vinyasa?</summary>
            <p>About 95°F with some humidity. Every other class is at normal room temperature.</p>
          </details>
          <details>
            <summary>Are there showers and parking?</summary>
            <p>Two showers and lockers. Free parking in the garage behind the studio.</p>
          </details>
        </div>
      </section>

      <section class="band band-green" id="about" aria-labelledby="about-title">
        <div class="band-head">
          <h2 id="about-title">The studio</h2>
          <p class="lead">
            One room, 24 mats and six teachers, two streets from the Old Town square. Rosa opened it in 2019 for people who wanted
            a good class without the fuss.
          </p>
        </div>
        <ul class="teachers" role="list">
          {Object.keys(bios).map((t) => (
            <li>
              <h3>{t}</h3>
              <p class="teaches">{teaches(t)}</p>
              <p>{bios[t]}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="band" id="visit" aria-labelledby="visit-title">
        <div class="band-head">
          <h2 id="visit-title">Visit</h2>
        </div>
        <div class="visit">
          <div><h3>Where</h3><p>{visit.place}<br />{visit.city}</p></div>
          <div><h3>Desk hours</h3><p>Every day, from 30 minutes before the first class until the last one ends.</p></div>
          <div><h3>Call or write</h3><p><a href={`tel:${visit.tel}`}>{visit.phone}</a><br /><a href={contact('Hello')}>{visit.email}</a></p></div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <nav class="sitemap" aria-label="Site map">
        <div>
          <p class="foot-head">Classes</p>
          <a href="#schedule">Schedule</a>
          <a href="#pricing">Pricing</a>
          <a href="#first-visit">First visit</a>
        </div>
        <div>
          <p class="foot-head">Studio</p>
          <a href="#about">Teachers</a>
          <a href="#visit">Visit</a>
          <a href={contact('Book a class')}>Book a class</a>
        </div>
        <div>
          <p class="foot-head">Contact</p>
          <a href={`tel:${visit.tel}`}>{visit.phone}</a>
          <a href={contact('Hello')}>{visit.email}</a>
        </div>
      </nav>
      <div class="concept-foot">
        <p>Saguaro Yoga Club is imaginary. This site is a concept by {site.name}, drawn and coded by hand.</p>
        <a class="button button-line-paper" href={mail}>I want a site like this for my studio</a>
        <a href="/">Back to {site.name}</a>
      </div>
    </footer>
  </body>
</html>

<script>
  import { nowAt } from '../../lib/sky';
  import { here } from '../../site';

  type Slot = { at: number; style: string; mins: number; teacher: string };
  const week: Record<string, Slot[]> = JSON.parse(document.body.dataset.week!);
  const styles: { key: string; name: string }[] = JSON.parse(document.body.dataset.styles!);
  const days = Object.keys(week);
  const el = (id: string) => document.getElementById(id)!;
  const clock = (at: number) => {
    const h = Math.floor(at);
    const m = Math.round((at % 1) * 60);
    return `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`;
  };
  const nameOf = (key: string) => styles.find((s) => s.key === key)!.name;

  // Where the week stands in Scottsdale right now.
  const today = () => new Intl.DateTimeFormat('en-US', { timeZone: here.timeZone, weekday: 'short' }).format(new Date());
  // The next class (of one style, or any), looking ahead up to a week.
  const nextClass = (style?: string) => {
    const now = nowAt(here).hour;
    const start = days.indexOf(today());
    for (let ahead = 0; ahead < 8; ahead++) {
      const day = days[(start + ahead) % 7];
      const slot = week[day].find((c) => (!style || c.style === style) && (ahead > 0 || c.at > now));
      if (slot) return { day, slot, when: ahead === 0 ? 'today' : ahead === 1 ? 'tomorrow' : `on ${day}` };
    }
    return null;
  };
  const showNext = () => {
    const n = nextClass();
    if (n) el('next').textContent = `Next class: ${nameOf(n.slot.style)}, ${n.when} at ${clock(n.slot.at)} with ${n.slot.teacher}.`;
  };
  showNext();
  setInterval(showNext, 60_000);

  // The schedule: a tab per day, opening on today, and a filter by style.
  let filter = 'all';
  const setFilter = (key: string) => {
    filter = key;
    document.querySelectorAll<HTMLElement>('.filter').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.filter === key)));
    applyFilter();
  };
  const showDay = (day: string) => {
    document.querySelectorAll<HTMLButtonElement>('.day-tab').forEach((t) => {
      const on = t.dataset.day === day;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const isToday = t.dataset.day === today();
      t.classList.toggle('is-today', isToday);
      t.querySelector('.day-label')!.textContent = isToday ? 'Today' : t.dataset.day!;
    });
    days.forEach((d) => (el(`day-${d}`).hidden = d !== day));
    applyFilter();
  };
  const applyFilter = () => {
    const hour = nowAt(here).hour;
    document.querySelectorAll<HTMLElement>('.day').forEach((list) => {
      let shown = 0;
      const isToday = list.id === `day-${today()}`;
      list.querySelectorAll<HTMLElement>('.slot').forEach((s) => {
        const on = filter === 'all' || s.dataset.style === filter;
        s.hidden = !on;
        if (on) shown++;
        // Classes already over today are marked as past.
        s.classList.toggle('is-past', isToday && Number(s.dataset.at) < hour);
      });
      list.querySelector<HTMLElement>('.slot-empty')!.hidden = shown > 0;
    });
  };
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.day-tab')];
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => showDay(t.dataset.day!));
    // Arrow keys move between days, as tabs should.
    t.addEventListener('keydown', (e) => {
      const move = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!move) return;
      const next = tabs[(i + move + tabs.length) % tabs.length];
      next.focus();
      showDay(next.dataset.day!);
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.filter').forEach((f) => f.addEventListener('click', () => setFilter(f.dataset.filter!)));

  // How you feel: pick a mood, and the schedule shows that class, with the next time it runs.
  document.querySelectorAll<HTMLButtonElement>('.mood').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.mood').forEach((m) => m.setAttribute('aria-pressed', String(m === b)));
      const style = b.dataset.style!;
      const n = nextClass(style);
      setFilter(style);
      if (n) showDay(n.day);
      el('pick').hidden = false;
      el('pick').textContent = `Try ${nameOf(style)}. ${b.dataset.why!}${n ? ` The next one is ${n.when} at ${clock(n.slot.at)} with ${n.slot.teacher}.` : ''}`;
    }),
  );
  showDay(today());
</script>

<style is:global>
  .sag {
    --paper: #f6f1e7;
    --saguaro: #1d3a2e;
    --bloom: #d0607a;
    --muted: #4d5f55;
    --rule: rgb(29 58 46 / 0.22);
    --rule-on-green: rgb(246 241 231 / 0.28);
    --font: 'Newsreader Variable', Georgia, serif;
    --text-display: clamp(2.6438rem, 2.2603rem + 1.7046vw, 3.624rem);
    --text-h2: clamp(1.836rem, 1.6469rem + 0.8406vw, 2.3193rem);
    --text-h3: clamp(1.275rem, 1.1931rem + 0.3641vw, 1.4844rem);
    --text-lead: clamp(1.275rem, 1.1931rem + 0.3641vw, 1.4844rem);
    --text-body: clamp(1.0625rem, 1.0136rem + 0.2174vw, 1.1875rem);
    --text-small: 0.9375rem;
    --edge: clamp(1.25rem, 6vw, 6rem);
    --section: clamp(3.5rem, 8vw, 5rem);
    margin: 0;
    color: var(--saguaro);
    background: var(--paper);
    font-family: var(--font);
    font-size: var(--text-body);
    line-height: 1.65;
    font-optical-sizing: auto;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }
  .sag *, .sag *::before, .sag *::after { box-sizing: border-box; }
  .sag a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.22em; }
  .sag :focus-visible { outline: 1px solid var(--saguaro); outline-offset: 4px; }
  :where(.sag) button { font: inherit; color: inherit; cursor: pointer; background: none; border: 0; padding: 0; }
  :where(.sag) :is(h1, h2, h3) { font-weight: 380; letter-spacing: -0.015em; margin: 0; }
  :where(.sag) p { margin: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .muted { color: var(--muted); }

  .concept-bar {
    padding: 0.5rem var(--edge);
    background: var(--saguaro);
    color: var(--paper);
    font-size: var(--text-small);
    text-align: center;
  }
  .sag .concept-bar :focus-visible { outline-color: var(--paper); }

  /* Top bar: the mark and the nav, with one primary action. */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 1.25rem var(--edge);
    border-bottom: 1px solid var(--rule);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; font-size: 1.2rem; font-weight: 450; }
