---
// The home page, for someone deciding whether to hire Maui: who he is and what he makes, the
// work, what it costs, about, and how to start. Look: a blue field with the name set huge, then
// a paper page where every project gets its own flat color. Archivo wide and Inter Tight.
// The one moving thing is the figure practising Ashtanga in the opening.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { work } from '../data/work';
import yellowWall from '../assets/photos/yellow-wall.jpg';
import crow from '../assets/photos/crow.jpg';

const services = [
  {
    name: 'Website',
    price: 'From $3,500',
    time: 'Two to three weeks',
    what: ['A design made for you, sketched before any code', 'Built by hand, fast on phones and desktops', 'Launched on your domain and handed over'],
  },
  {
    name: 'Interactive extras',
    price: 'Quoted per idea',
    time: 'Added to a build',
    what: ['Ordering, booking or a live schedule', 'A signature moment, like the turning trompo', 'Illustrations drawn for your site'],
  },
  {
    name: 'Care plan',
    price: 'From $150 a month',
    time: 'Cancel anytime',
    what: ['Text and photo updates', 'Hosting, domain and security kept current', 'A small change each month'],
  },
];

// Selected work: everything in src/data/work.ts, hand-built first, then the six gallery concepts,
// each in its own color. The gallery sites were built by AI agents from Maui's briefs; the cards say so.
const colors = ['var(--orange)', 'var(--yellow)', 'var(--pink)', 'var(--green)', 'var(--lilac)', 'var(--blue)'];
const cards = work.map((w, i) => ({
  href: w.ai ? w.links[0].href : w.href,
  name: w.name,
  kind: w.kind,
  line: w.line,
  image: w.image,
  alt: w.alt,
  ai: !!w.ai,
  field: colors[i % colors.length],
}));
---

<Base bare>
  <section class="b-hero" aria-labelledby="hero-title">
    <h1 class="b-name" id="hero-title">Maui<br />Tinevra</h1>
    <div class="b-row">
      <div class="b-words">
        <p class="b-offer">{site.offer}</p>
        <p class="b-now" id="now">Scottsdale, Arizona</p>
        <div class="b-actions">
          <a class="btn btn-orange" href="#contact">Start a project</a>
          <a class="btn btn-line" href="#work">See my work</a>
        </div>
      </div>
      <figure class="b-stage">
        <svg class="b-scene" viewBox="0 0 420 300" role="img" aria-labelledby="pose-label">
          <title id="pose-label">A figure practising Ashtanga yoga</title>
          <path id="trail" class="b-trail" d="" />
          <g id="yogi" transform="translate(210 286) scale(-1.5 1.5)"></g>
          <path class="b-mat" d="M70 290H350" />
        </svg>
        <figcaption class="b-caption">
          <p class="b-pose"><span id="series">Primary series</span><strong id="pose-name">Samasthiti</strong></p>
          <div class="b-controls" role="group" aria-label="The practice">
            <button type="button" class="b-key" id="play" aria-pressed="true">Pause</button>
            <button type="button" class="b-key" id="next">Next pose</button>
            <button type="button" class="b-key" id="swap">Second series</button>
          </div>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="b-section" id="work" aria-labelledby="work-title">
    <div class="b-head">
      <h2 class="b-title" id="work-title">Selected work</h2>
      <a href="/work">All work and what changed</a>
    </div>
    <ul class="b-work" role="list">
      {
        cards.map((c) => (
          <li>
            <a class="b-card" href={c.href} style={`--field: ${c.field}`} data-light={c.field === 'var(--blue)' ? '' : undefined}>
              <span class="b-card-top">
                <span class="b-card-name">{c.name}</span>
                <span class="b-kind">{c.kind}</span>
              </span>
              <span class="b-card-line">{c.line}</span>
              {c.ai && <span class="b-badge">Built with AI agents from my brief</span>}
              <img src={c.image} alt={c.alt} width="1200" height="750" loading="lazy" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="b-note" id="gallery">
      The last six are <a href="/gallery/">the gallery</a>: imaginary businesses around Phoenix whose sites I directed and AI agents
      built in parallel, in an afternoon. <a href="/gallery/guide/">Here is exactly how</a>.
    </p>
  </section>

  <section class="b-section b-yellow" id="services" aria-labelledby="services-title">
    <div class="b-head">
      <h2 class="b-title" id="services-title">Services &amp; pricing</h2>
      <a href="/web-design">How a project works</a>
    </div>
    <ul class="b-services" role="list">
      {
        services.map((s) => (
          <li class="b-service">
            <h3>{s.name}</h3>
            <p class="b-price">{s.price}</p>
            <p class="b-time">{s.time}</p>
            <ul role="list">
              {s.what.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="b-section b-about" id="about" aria-labelledby="about-title">
    <div class="b-about-words">
      <h2 class="b-title" id="about-title">About</h2>
      <p class="b-lead">
        I'm Maui Tinevra, a former software engineer at Uber with a passion for visual art. I'm Mexican, Italian and Korean, and I
        practice Ashtanga yoga. You work with me directly, from the first call to launch day.
      </p>
      <p><a href="/art">See my art</a>, read the <a href="/journal">journal</a>, or try the <a href="/street">interactive site</a>.</p>
    </div>
    <div class="b-photos">
      <figure class="b-photo"><Image src={yellowWall} alt="Maui crouching in front of a yellow wall" widths={[320, 520]} sizes="(max-width: 760px) 45vw, 260px" /></figure>
      <figure class="b-photo b-photo-low"><Image src={crow} alt="Maui in crow pose on a yoga mat in front of a graffiti wall" widths={[320, 520]} sizes="(max-width: 760px) 45vw, 260px" /></figure>
    </div>
  </section>

  <section class="b-section b-contact" id="contact" aria-labelledby="contact-title">
    <h2 class="b-title" id="contact-title">Start a project</h2>
    <p class="b-lead">Tell me who you are, what you make, and when you'd like to launch. I answer within a day.</p>
    <div class="b-mail">
      <a class="b-address" href={`mailto:${site.email}?subject=${encodeURIComponent('A website for me')}`}>{site.email}</a>
      <button type="button" class="btn btn-dark" id="copy-email" data-email={site.email}>Copy email</button>
    </div>
    <p class="b-copied" id="copied" aria-live="polite"></p>
    <p>Prefer messages? <a href={site.links.find((l) => l.label === 'Instagram')?.href}>Send me a DM on Instagram</a>.</p>
  </section>
</Base>

<script>
  import { poses, practice, blendLag, breathe, drawFlat } from '../lib/yogi';
  import { nowAt, nextSun, formatHour } from '../lib/sky';
  import { here } from '../site';

  const el = (id: string) => document.getElementById(id)!;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Copy the address, for anyone whose computer has no mail app set up.
  const button = el('copy-email') as HTMLButtonElement;
  button.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.email!);
      el('copied').textContent = 'Copied. Paste it into any email.';
    } catch {
      el('copied').textContent = `Couldn't copy. The address is ${button.dataset.email}.`;
    }
  });

  // The real hour where Maui is.
  const tell = () => {
    const now = nowAt(here);
    const clock = formatHour(now.hour);
    const sun = nextSun(now.hour, now.day, here, now.offset);
    const hours = Math.floor(sun.in);
    const mins = Math.round((sun.in - hours) * 60);
    el('now').textContent = `${clock.time} ${clock.half} in Scottsdale. ${sun.event} in ${hours ? `${hours} h ${mins} min` : `${mins} min`}.`;
  };
  tell();
  setInterval(tell, 60_000);

  // The practice. Each pose is a set of joint angles; a move runs every joint on its own slightly
  // late clock so the body travels in a wave, and a held pose breathes. The near hand leaves a
  // short trail while it moves.
  const colors = { skin: '#e3a374', skinFar: '#b97d55', top: '#fbfaf7', topFar: '#c9cdf7', shorts: '#ff5a1f', shortsFar: '#d2440f', hair: '#111111' };
  const yogi = el('yogi');
  const trail = el('trail');
  const MOVE = 1500; // ms for one move
  const BREATH = 4200; // ms for one full breath
  let series = 0;
  let index = 0;
  let playing = !calm;
  let phase: 'move' | 'hold' = 'hold';
  let since = performance.now();
  let from = poses.samasthiti;
  let current = poses.samasthiti;
  const steps = () => practice[series].steps;
  const marks: { x: number; y: number; at: number }[] = [];

  const label = () => {
    el('series').textContent = practice[series].series;
    el('pose-name').textContent = steps()[index].name;
    el('pose-label').textContent = `A figure practising Ashtanga yoga, in ${steps()[index].name}`;
  };
  const go = (to: number) => {
    from = current;
    index = (to + steps().length) % steps().length;
    phase = 'move';
    since = performance.now();
    label();
  };
  const paint = (time: number) => {
    const target = poses[steps()[index].pose];
    if (phase === 'move') {
      const k = Math.min(1, (time - since) / MOVE);
      current = blendLag(from, target, k);
      if (k >= 1) {
        phase = 'hold';
        since = time;
      }
    } else {
      current = breathe(target, Math.sin(((time % BREATH) / BREATH) * Math.PI * 2));
      if (playing && time - since > steps()[index].hold * 1000 + 600) go(index + 1);
    }
    const drawn = drawFlat(current, colors);
    yogi.innerHTML = drawn.svg;
    // The trail, in the scene's own coordinates (the figure is mirrored and scaled).
    if (phase === 'move') marks.push({ x: 210 - drawn.hand[0] * 1.5, y: 286 + drawn.hand[1] * 1.5, at: time });
    while (marks.length && time - marks[0].at > 900) marks.shift();
    trail.setAttribute('d', marks.length > 1 ? 'M' + marks.map((m) => `${m.x.toFixed(1)} ${m.y.toFixed(1)}`).join('L') : '');
  };
  const tick = (time: number) => {
    paint(time);
    requestAnimationFrame(tick);
  };
  const still = () => {
    current = poses[steps()[index].pose];
    yogi.innerHTML = drawFlat(current, colors).svg;
  };
  label();
  if (calm) {
    // Reduced motion: no loop. Each press of "Next pose" shows the next pose, still.
    still();
    el('play').hidden = true;
  } else requestAnimationFrame(tick);

  el('play').addEventListener('click', () => {
    playing = !playing;
    el('play').setAttribute('aria-pressed', String(playing));
    el('play').textContent = playing ? 'Pause' : 'Play';
    since = performance.now();
  });
  el('next').addEventListener('click', () => {
    go(index + 1);
    if (calm) still();
  });
  el('swap').addEventListener('click', () => {
    series = 1 - series;
    el('swap').textContent = series ? 'Primary series' : 'Second series';
    go(0);
    if (calm) still();
  });
</script>

<style>
  .b-hero { display: flex; flex-direction: column; min-height: calc(100svh - 4.6rem); padding: clamp(1rem, 3vw, 2.5rem) var(--edge) clamp(1.5rem, 3vw, 2.5rem); background: var(--blue); color: var(--paper); }
  .b-name { margin: 0; font-weight: 800; font-stretch: 120%; font-size: clamp(4.2rem, 16.2vw, 15rem); line-height: 0.84; letter-spacing: -0.045em; }
  .b-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 2rem 3rem; margin-top: auto; padding-top: 2rem; }
  .b-words { max-width: 30rem; }
  .b-offer { margin: 0; font-size: clamp(1.25rem, 1.9vw, 1.55rem); line-height: 1.3; font-weight: 500; }
  .b-now { margin: 0.6rem 0 0; opacity: 0.75; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .b-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }

  .btn { display: inline-flex; align-items: center; min-height: 3rem; padding: 0.6rem 1.4rem; border: 1.5px solid var(--ink); border-radius: 999px; background: transparent; color: var(--ink); font: 600 1rem var(--reading); text-decoration: none; cursor: pointer; transition: background-color 0.2s, color 0.2s, border-color 0.2s; }
  .btn:hover { background: var(--ink); color: var(--paper); }
  .btn-orange { background: var(--orange); border-color: var(--orange); }
  .btn-orange:hover { background: var(--paper); border-color: var(--paper); color: var(--ink); }
  .btn-line { border-color: var(--paper); color: var(--paper); }
  .btn-line:hover { background: var(--paper); color: var(--ink); }
  .btn-dark { background: var(--ink); color: var(--paper); }
  .btn-dark:hover { background: var(--paper); color: var(--ink); }
  .b-hero :focus-visible { outline-color: var(--paper); }

  .b-stage { display: flex; align-items: flex-end; gap: 1.5rem; margin: 0; }
  .b-scene { display: block; width: clamp(15rem, 26vw, 24rem); height: auto; overflow: visible; }
  .b-trail { fill: none; stroke: var(--yellow); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .b-mat { stroke: var(--yellow); stroke-width: 5; stroke-linecap: round; }
  .b-caption { display: grid; gap: 0.75rem; padding-bottom: 0.4rem; }
  .b-pose { margin: 0; display: grid; }
  .b-pose span { opacity: 0.75; font-size: 0.9rem; }
  .b-pose strong { font-weight: 600; font-size: 1.15rem; line-height: 1.2; max-width: 12rem; }
  .b-controls { display: grid; gap: 0.35rem; justify-items: start; }
  .b-key { min-height: 2.75rem; padding: 0.3rem 0.9rem; border: 1.5px solid rgb(251 250 247 / 0.5); border-radius: 999px; background: transparent; color: var(--paper); font: 500 0.9rem var(--reading); cursor: pointer; }
  .b-key:hover { border-color: var(--paper); }

  .b-section { padding: clamp(3.5rem, 8vw, 7rem) var(--edge); }
  .b-section a:not(.btn):not(.b-card):not(.b-mini) { color: inherit; text-underline-offset: 0.2em; }
  .b-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; }
  .b-head a { font-weight: 600; }
  .b-title { margin: 0; font-size: clamp(2.6rem, 6.4vw, 5.5rem); line-height: 0.92; letter-spacing: -0.04em; }
  .b-lead { max-width: 40rem; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.35; font-weight: 500; }

  .b-work { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.9rem, 1.6vw, 1.4rem); margin: clamp(2rem, 4vw, 3.5rem) 0 0; padding: 0; list-style: none; }
  .b-work li { display: grid; }
  .b-card { display: flex; flex-direction: column; gap: 0.6rem; padding: clamp(1.25rem, 2vw, 1.75rem) clamp(1.25rem, 2vw, 1.75rem) 0; border-radius: 1.4rem; background: var(--field); color: var(--ink); text-decoration: none; overflow: hidden; }
  .b-card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .b-card-name { font-family: var(--display); font-weight: 800; font-stretch: 118%; font-size: clamp(1.5rem, 2.3vw, 2.1rem); line-height: 1; letter-spacing: -0.03em; }
  .b-kind { font-size: 0.9rem; font-weight: 500; white-space: nowrap; }
  .b-card-line { max-width: 28rem; line-height: 1.45; }
  .b-card img { display: block; width: 100%; height: auto; margin-top: auto; padding-top: 0; border-radius: 0.7rem 0.7rem 0 0; translate: 0 0.6rem; transition: translate 0.25s; }
  .b-card:hover img { translate: 0 0; }
  .b-card[data-light] { color: var(--paper); }
  .b-badge { align-self: flex-start; padding: 0.25rem 0.6rem; border: 1.5px solid currentColor; border-radius: 999px; font-size: 0.8rem; font-weight: 600; }
  .b-note { max-width: 46rem; margin: clamp(1.5rem, 3vw, 2.5rem) 0 0; color: var(--muted); line-height: 1.55; }

  .b-card:focus-visible { outline-offset: 4px; }

  .b-yellow { background: var(--yellow); }
  .b-services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 3rem; margin: clamp(2rem, 4vw, 3.5rem) 0 0; padding: 0; list-style: none; }
  .b-service { padding-top: 1.25rem; border-top: 2px solid var(--ink); }
  .b-service h3 { margin: 0; font-family: var(--reading); font-stretch: normal; font-weight: 600; font-size: 1.05rem; letter-spacing: 0; }
  .b-price { margin: 0.6rem 0 0; font-family: var(--display); font-weight: 800; font-stretch: 118%; font-size: clamp(1.9rem, 3.2vw, 2.9rem); line-height: 1; letter-spacing: -0.035em; }
  .b-time { margin: 0.5rem 0 0; font-weight: 500; }
  .b-service ul { margin: 1.1rem 0 0; padding: 0 0 0 1.1rem; display: grid; gap: 0.4rem; line-height: 1.45; }

  .b-about { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .b-about-words p { margin: 0 0 1rem; max-width: 40rem; line-height: 1.6; }
  .b-about-words .b-lead { margin-top: 1.75rem; }
  .b-about-words p:not(.b-lead) { color: var(--muted); }
  .b-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; }
  .b-photo { margin: 0; border-radius: 1.2rem; overflow: hidden; }
  .b-photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; }
  .b-photo-low { margin-top: 3rem; }

  .b-contact { background: var(--orange); }
  .b-contact p { max-width: 40rem; }
  .b-contact .b-lead { margin: 1.5rem 0 0; }
  .b-mail { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin: 2rem 0 0; }
  .b-address { font-family: var(--display); font-weight: 800; font-stretch: 112%; font-size: clamp(1.5rem, 5vw, 4rem); line-height: 1; letter-spacing: -0.035em; overflow-wrap: anywhere; text-decoration-thickness: 3px !important; }
  .b-copied { min-height: 1.5rem; margin: 0.5rem 0 0; font-weight: 600; }

  @media (max-width: 900px) {
    .b-hero { min-height: 0; }
    .b-stage { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .b-controls { display: flex; flex-wrap: wrap; }
    .b-work, .b-services { grid-template-columns: 1fr; }
    .b-about { grid-template-columns: 1fr; }
    .b-photos { max-width: 26rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .b-card img { transition: none; translate: 0 0; }
  }
</style>
