---
// The home page, for a small-business owner deciding whether to hire Maui: what he does and where,
// the work, what it costs, about, and how to start. Color follows 60/30/10: paper, ink, and one
// accent (blue) for the opening field, the actions and the contact band. Archivo wide for
// display, Inter Tight for reading. The one moving thing is the small Ashtanga figure in About.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { work } from '../data/work';
import yellowWall from '../assets/photos/yellow-wall.jpg';
import crow from '../assets/photos/crow.jpg';

const services = [
  {
    name: 'Website',
    price: 'From $3,500',
    time: 'Two to three weeks',
    what: ['A design made for you, sketched before any code', 'Built by hand, fast on phones and desktops', 'Launched on your domain and handed over'],
  },
  {
    name: 'Interactive extras',
    price: 'Quoted per idea',
    time: 'Added to a build',
    what: ['Ordering, booking or a live schedule', 'A signature moment, like the turning trompo', 'Illustrations drawn for your site'],
  },
  {
    name: 'Care plan',
    price: 'From $150 a month',
    time: 'Cancel anytime',
    what: ['Text and photo updates', 'Hosting, domain and security kept current', 'A small change each month'],
  },
];

// Selected work: Maui's own projects. (The AI-built gallery concepts are left out of the portfolio.)
const cards = work
  .filter((w) => !w.ai)
  .map((w) => ({ href: w.href, name: w.name, kind: w.kind, line: w.line, image: w.image, alt: w.alt }));
---

<Base bare>
  <section class="b-hero" aria-labelledby="hero-title">
    <div class="b-words">
      <h1 class="b-name" id="hero-title">Web design for small businesses in Scottsdale, Arizona</h1>
      <p class="b-offer">
        Custom websites for restaurants, studios and shops, designed and built by me, Maui Tinevra. From $3,500, live in two to
        three weeks.
      </p>
      <div class="b-actions">
        <a class="btn btn-accent" href="#contact">Start a project</a>
        <a class="btn" href="#work">See my work</a>
      </div>
    </div>
    <a class="b-show" href="/work#el-unico" aria-label="El Único Taquería, a restaurant site by Maui Tinevra: see the case study">
      <span class="b-browser">
        <span class="b-bar" aria-hidden="true"><i></i><i></i><i></i></span>
        <img src="/work/el-unico-desktop.webp" alt="" width="1200" height="750" fetchpriority="high" />
      </span>
      <span class="b-phone"><img src="/work/el-unico-phone.webp" alt="" width="480" height="1039" /></span>
      <span class="b-show-label">El Único Taquería, ordering and hours first</span>
    </a>
  </section>

  <section class="b-section" id="work" aria-labelledby="work-title">
    <div class="b-head">
      <h2 class="b-title" id="work-title">Selected work</h2>
      <a href="/work">See the case studies</a>
    </div>
    <ul class="b-work" role="list">
      {
        cards.map((c) => (
          <li>
            <a class="b-card" href={c.href}>
              <span class="b-card-top">
                <span class="b-card-name">{c.name}</span>
                <span class="b-kind">{c.kind}</span>
              </span>
              <span class="b-card-line">{c.line}</span>
              <img src={c.image} alt={c.alt} width="1200" height="750" loading="lazy" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="b-section b-services-band" id="services" aria-labelledby="services-title">
    <div class="b-head">
      <h2 class="b-title" id="services-title">Services &amp; pricing</h2>
      <a href="/web-design">How a project works</a>
    </div>
    <ul class="b-services" role="list">
      {
        services.map((s) => (
          <li class="b-service">
            <h3>{s.name}</h3>
            <p class="b-price">{s.price}</p>
            <p class="b-time">{s.time}</p>
            <ul role="list">
              {s.what.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="b-section b-about" id="about" aria-labelledby="about-title">
    <div class="b-about-words">
      <h2 class="b-title" id="about-title">About</h2>
      <p class="b-lead">
        I'm Maui Tinevra, a former software engineer at Uber with a passion for visual art. I'm Mexican, Italian and Korean, and I
        practice Ashtanga yoga. You work with me directly, from the first call to launch day.
      </p>
      <p><a href="/art">See my art</a>, read the <a href="/journal">journal</a>, or try the <a href="/street">interactive site</a>.</p>
    </div>
    <div class="b-about-side">
      <div class="b-photos">
      <figure class="b-photo"><Image src={yellowWall} alt="Maui crouching in front of a yellow wall" widths={[320, 520]} sizes="(max-width: 760px) 45vw, 260px" /></figure>
      <figure class="b-photo b-photo-low"><Image src={crow} alt="Maui in crow pose on a yoga mat in front of a graffiti wall" widths={[320, 520]} sizes="(max-width: 760px) 45vw, 260px" /></figure>
      </div>
      <figure class="b-yoga">
        <svg viewBox="70 40 280 262" role="img" aria-labelledby="yoga-label">
          <title id="yoga-label">A small drawing of Maui practising the Ashtanga primary series</title>
          <g id="yogi" transform="translate(210 286) scale(-1.5 1.5)"></g>
          <path class="b-mat" d="M96 290H324" />
        </svg>
        <figcaption>Most mornings: the Ashtanga primary series, drawn in code.</figcaption>
      </figure>
    </div>
    </div>
  </section>

  <section class="b-section b-contact" id="contact" aria-labelledby="contact-title">
    <h2 class="b-title" id="contact-title">Start a project</h2>
    <p class="b-lead">Tell me who you are, what you make, and when you'd like to launch. I answer within a day.</p>
    <div class="b-mail">
      <a class="b-address" href={`mailto:${site.email}?subject=${encodeURIComponent('A website for me')}`}>{site.email}</a>
      <button type="button" class="btn btn-dark" id="copy-email" data-email={site.email}>Copy email</button>
    </div>
    <p class="b-copied" id="copied" aria-live="polite"></p>
    <p>Prefer messages? <a href={site.links.find((l) => l.label === 'Instagram')?.href}>Send me a DM on Instagram</a>.</p>
  </section>
</Base>

<script>
  import { poses, practice, blendLag, breathe, drawFlat } from '../lib/yogi';

  const el = (id: string) => document.getElementById(id)!;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Copy the address, for anyone whose computer has no mail app set up.
  const button = el('copy-email') as HTMLButtonElement;
  button.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.email!);
      el('copied').textContent = 'Copied. Paste it into any email.';
    } catch {
      el('copied').textContent = `Couldn't copy. The address is ${button.dataset.email}.`;
    }
  });

  // The small figure in About practises the primary series on its own: each pose is a set of
  // joint angles, a move runs every joint on its own slightly late clock, and a held pose breathes.
  // It only animates while it is on screen, and stands still for reduced motion.
  const colors = { skin: '#d8996c', skinFar: '#b07a53', top: '#111111', topFar: '#3a3a3a', shorts: '#2a35ff', shortsFar: '#1d27c4', hair: '#111111' };
  const yogi = el('yogi');
  const steps = practice[0].steps;
  const MOVE = 1500;
  const BREATH = 4200;
  let index = 0;
  let phase: 'move' | 'hold' = 'hold';
  let since = performance.now();
  let from = poses.samasthiti;
  let current = poses.samasthiti;
  let visible = false;
  let frame = 0;

  const paint = (time: number) => {
    const target = poses[steps[index].pose];
    if (phase === 'move') {
      const k = Math.min(1, (time - since) / MOVE);
      current = blendLag(from, target, k);
      if (k >= 1) {
        phase = 'hold';
        since = time;
      }
    } else {
      current = breathe(target, Math.sin(((time % BREATH) / BREATH) * Math.PI * 2));
      if (time - since > steps[index].hold * 1000 + 600) {
        from = current;
        index = (index + 1) % steps.length;
        phase = 'move';
        since = time;
      }
    }
    yogi.innerHTML = drawFlat(current, colors).svg;
  };
  const tick = (time: number) => {
    paint(time);
    frame = visible ? requestAnimationFrame(tick) : 0;
  };
  yogi.innerHTML = drawFlat(current, colors).svg;
  if (!calm) {
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame) {
        since = performance.now();
        frame = requestAnimationFrame(tick);
      }
    }).observe(yogi.closest('figure')!);
  }
</script>

<style>
  /* 60/30/10: paper, ink, and one accent, blue, for the opening field, the actions and the contact
     band. The screenshots bring the rest of the color. */
  .b-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); min-height: calc(100svh - 4.6rem); }
  .b-words { display: flex; flex-direction: column; justify-content: center; padding: clamp(2.5rem, 6vw, 5rem) var(--edge); }
  .b-name { margin: 0; max-width: 13ch; font-weight: 800; font-stretch: 112%; font-size: clamp(2.6rem, 5.2vw, 5.1rem); line-height: 0.95; letter-spacing: -0.035em; text-wrap: balance; }
  .b-offer { margin: 1.75rem 0 0; max-width: 31rem; color: var(--muted); font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.45; font-weight: 500; text-wrap: pretty; }
  .b-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }

  .b-show { position: relative; display: grid; place-items: center; padding: clamp(2rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem) clamp(4rem, 7vw, 6rem); background: var(--blue); color: var(--paper); text-decoration: none; overflow: hidden; }
  .b-browser { display: block; width: 100%; max-width: 40rem; border-radius: 0.75rem; overflow: hidden; background: var(--paper); box-shadow: 0 24px 60px -20px rgb(0 0 30 / 0.55); transition: translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .b-bar { display: flex; gap: 0.35rem; padding: 0.6rem 0.75rem; background: var(--paper); }
  .b-bar i { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: rgb(17 17 17 / 0.18); }
  .b-browser img { display: block; width: 100%; height: auto; }
  .b-phone { position: absolute; right: clamp(1rem, 3vw, 3rem); bottom: clamp(2.25rem, 4vw, 3.5rem); width: clamp(6.5rem, 11vw, 9.5rem); padding: 0.35rem; border-radius: 1.4rem; background: var(--ink); box-shadow: 0 24px 50px -16px rgb(0 0 30 / 0.6); transition: translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) 0.04s; }
  .b-phone img { display: block; width: 100%; height: auto; border-radius: 1.1rem; }
  .b-show-label { position: absolute; left: clamp(1.5rem, 4vw, 4rem); bottom: clamp(1.25rem, 2.5vw, 2rem); font-weight: 600; font-size: 0.95rem; }
  .b-show-label::after { content: ''; display: inline-block; width: 0.5em; height: 0.5em; margin-left: 0.5em; border-top: 2px solid; border-right: 2px solid; rotate: 45deg; vertical-align: 0.1em; }
  .b-show:hover .b-browser, .b-show:hover .b-phone { translate: 0 -0.4rem; }
  .b-show:focus-visible { outline: 3px solid var(--ink); outline-offset: -3px; }

  .btn { display: inline-flex; align-items: center; min-height: 3rem; padding: 0.6rem 1.4rem; border: 1.5px solid var(--ink); border-radius: 999px; background: transparent; color: var(--ink); font: 600 1rem var(--reading); text-decoration: none; cursor: pointer; transition: background-color 0.2s, color 0.2s, border-color 0.2s; }
  .btn:hover { background: var(--ink); color: var(--paper); }
  .btn-accent { background: var(--blue); border-color: var(--blue); color: var(--paper); }
  .btn-accent:hover { background: var(--ink); border-color: var(--ink); }
  .btn-dark { background: var(--ink); color: var(--paper); }
  .btn-dark:hover { background: var(--blue); border-color: var(--blue); }
  .b-contact .btn-dark { background: var(--paper); border-color: var(--paper); color: var(--ink); }
  .b-contact .btn-dark:hover { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  .b-section { padding: clamp(3.5rem, 8vw, 7rem) var(--edge); }
  .b-section a:not(.btn):not(.b-card) { color: inherit; text-underline-offset: 0.2em; }
  .b-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; }
  .b-head a { font-weight: 600; }
  .b-title { margin: 0; font-size: clamp(2.6rem, 6vw, 5rem); line-height: 0.92; letter-spacing: -0.04em; }
  .b-lead { max-width: 40rem; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.35; font-weight: 500; }

  .b-work { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.9rem, 1.6vw, 1.4rem); margin: clamp(2rem, 4vw, 3.5rem) 0 0; padding: 0; list-style: none; }
  .b-work li { display: grid; }
  .b-card { display: flex; flex-direction: column; gap: 0.6rem; padding: clamp(1.25rem, 2vw, 1.75rem) clamp(1.25rem, 2vw, 1.75rem) 0; border-radius: 1.4rem; background: #efede7; color: var(--ink); text-decoration: none; overflow: hidden; transition: background-color 0.2s; }
  .b-card:hover { background: #e7e5de; }
  .b-card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .b-card-name { font-family: var(--display); font-weight: 800; font-stretch: 118%; font-size: clamp(1.5rem, 2.3vw, 2.1rem); line-height: 1; letter-spacing: -0.03em; }
  .b-kind { color: var(--muted); font-size: 0.9rem; font-weight: 500; white-space: nowrap; }
  .b-card-line { max-width: 28rem; line-height: 1.45; }
  .b-card img { display: block; width: 100%; height: auto; margin-top: auto; border-radius: 0.7rem 0.7rem 0 0; translate: 0 0.6rem; box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.35); transition: translate 0.25s; }
  .b-card:hover img { translate: 0 0; }
  .b-card:hover .b-card-name { text-decoration: underline; text-decoration-color: var(--blue); text-decoration-thickness: 3px; text-underline-offset: 0.12em; }
  .b-card:focus-visible { outline-offset: 4px; }

  .b-services-band { border-top: 1px solid var(--rule); }
  .b-services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 3rem; margin: clamp(2rem, 4vw, 3.5rem) 0 0; padding: 0; list-style: none; }
  .b-service { padding-top: 1.25rem; border-top: 2px solid var(--ink); }
  .b-service:first-child { border-top-color: var(--blue); }
  .b-service h3 { margin: 0; font-family: var(--reading); font-stretch: normal; font-weight: 600; font-size: 1.05rem; letter-spacing: 0; }
  .b-price { margin: 0.6rem 0 0; font-family: var(--display); font-weight: 800; font-stretch: 118%; font-size: clamp(1.9rem, 3.2vw, 2.9rem); line-height: 1; letter-spacing: -0.035em; }
  .b-time { margin: 0.5rem 0 0; color: var(--muted); font-weight: 500; }
  .b-service ul { margin: 1.1rem 0 0; padding: 0 0 0 1.1rem; display: grid; gap: 0.4rem; line-height: 1.45; }

  .b-about { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; border-top: 1px solid var(--rule); }
  .b-about-words p { margin: 0 0 1rem; max-width: 40rem; line-height: 1.6; }
  .b-about-words .b-lead { margin-top: 1.75rem; }
  .b-about-side { display: grid; gap: 1.5rem; }
  .b-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; }
  .b-photo { margin: 0; border-radius: 1.2rem; overflow: hidden; }
  .b-photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; }
  .b-photo-low { margin-top: 3rem; }
  .b-yoga { display: grid; grid-template-columns: 11rem 1fr; align-items: end; gap: 1rem; margin: 0; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .b-yoga svg { display: block; width: 100%; height: auto; overflow: visible; }
  .b-yoga figcaption { padding-bottom: 0.3rem; color: var(--muted); font-size: 0.95rem; line-height: 1.4; }
  .b-mat { stroke: var(--blue); stroke-width: 6; stroke-linecap: round; }

  .b-contact { background: var(--blue); color: var(--paper); }
  .b-contact p { max-width: 40rem; }
  .b-contact .b-lead { margin: 1.5rem 0 0; }
  .b-contact :focus-visible { outline-color: var(--paper); }
  .b-mail { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin: 2rem 0 0; }
  .b-address { font-family: var(--display); font-weight: 800; font-stretch: 112%; font-size: clamp(1.5rem, 5vw, 4rem); line-height: 1; letter-spacing: -0.035em; overflow-wrap: anywhere; text-decoration-thickness: 3px !important; }
  .b-copied { min-height: 1.5rem; margin: 0.5rem 0 0; font-weight: 600; }

  @media (max-width: 900px) {
    .b-hero { grid-template-columns: 1fr; min-height: 0; }
    .b-show { padding-bottom: 4.5rem; }
    .b-work, .b-services { grid-template-columns: 1fr; }
    .b-about { grid-template-columns: 1fr; }
    .b-about-side { max-width: 26rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .b-card, .b-card img, .b-browser, .b-phone { transition: none; translate: 0 0; }
  }
</style>
